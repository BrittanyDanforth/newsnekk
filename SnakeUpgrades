-- SnakeUpgrades module: Implements real upgrades for player and AI snakes

local SnakeUpgrades = {}

-- Duration of speed boost in seconds
local SPEED_BOOST_DURATION = 6
local SPEED_BOOST_AMOUNT = 1.1 -- Very subtle 10% speed increase

function SnakeUpgrades.GiveUpgrade(snake)
    if not snake then return end

    -- Check if this is an AI snake (has Speed/BoostSpeed fields)
    if snake.Speed and snake.BoostSpeed then
        -- AI snake upgrade: temporary speed boost
        if snake._isSpeedBoosted then return end -- Prevent stacking
        snake._isSpeedBoosted = true

        local origSpeed = snake.NormalSpeed or snake.Speed
        local origBoost = snake.BoostSpeed

        snake.NormalSpeed = origSpeed * SPEED_BOOST_AMOUNT
        snake.BoostSpeed = origBoost * SPEED_BOOST_AMOUNT

        -- Store original color and apply temporary orange color
        if snake.HeadParts and snake.HeadParts.head then
            -- Store the original color
            snake._originalHeadColor = snake.HeadParts.head.Color
            
            -- Apply temporary orange color
            snake.HeadParts.head.Color = Color3.fromRGB(255, 100, 0)
            
            local headGlow = snake.HeadParts.head:FindFirstChild("Glow") or snake.HeadParts.head:FindFirstChild("PointLight")
            if headGlow then
                headGlow.Brightness = headGlow.Brightness * 1.3
            end
        end

        task.delay(SPEED_BOOST_DURATION, function()
            if snake then
                snake.NormalSpeed = origSpeed
                snake.BoostSpeed = origBoost
                snake._isSpeedBoosted = false
                -- Restore original color
                if snake.HeadParts and snake.HeadParts.head and snake._originalHeadColor then
                    snake.HeadParts.head.Color = snake._originalHeadColor
                    snake._originalHeadColor = nil
                    
                    local headGlow = snake.HeadParts.head:FindFirstChild("Glow") or snake.HeadParts.head:FindFirstChild("PointLight")
                    if headGlow then
                        headGlow.Brightness = headGlow.Brightness / 1.3
                    end
                end
            end
        end)
    elseif snake.head then
        -- Player snake upgrade (OptimizedSnakeSystem): temporary speed boost
        if snake._isSpeedBoosted then return end
        snake._isSpeedBoosted = true

        -- Find the player
        local player = snake.player
        if not player or not player.Character then return end
        
        -- Apply speed boost via attribute
        local currentSpeedMult = player:GetAttribute("SpeedMultiplier") or 1
        player:SetAttribute("TempSpeedMultiplier", SPEED_BOOST_AMOUNT)
        
        -- NO COLOR CHANGE - just subtle glow increase
        if snake.head then
            local headGlow = snake.head:FindFirstChild("PointLight")
            if headGlow then
                headGlow.Brightness = headGlow.Brightness * 1.3
            end
            
            task.delay(SPEED_BOOST_DURATION, function()
                if snake and snake.head then
                    snake._isSpeedBoosted = false
                    
                    if headGlow then
                        headGlow.Brightness = headGlow.Brightness / 1.3
                    end
                end
                
                if player then
                    player:SetAttribute("TempSpeedMultiplier", 1)
                end
            end)
        end
    end
end

return SnakeUpgrades

