			ShopUI.uiElements.purchaseBtn.Position = UDim2.new(0, 0, 0, 0)
			ShopUI.uiElements.applyBtn.Position = UDim2.new(0, 0, 0.24, 0)
			ShopUI.uiElements.favoriteBtn.Position = UDim2.new(0, 0, 0.48, 0)
		end
	end

