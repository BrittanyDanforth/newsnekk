					Position = startPos - UDim2.new(0, math_random(-30, 30), 0, floatHeight),
					Rotation = math_random(-45, 45),
					ImageTransparency = 0.85
				}):Play()
				wait(floatTime)

				-- Float down
				TweenService:Create(shape, TweenInfo.new(floatTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
					Position = startPos,
					Rotation = math_random(-45, 45),
					ImageTransparency = 0.92
				}):Play()
				wait(floatTime)
			end
		end)

		table.insert(uiState.particles, {particle = shape})
