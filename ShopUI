		end
		
		-- FIXED: Ensure window is visible and not using GroupTransparency
		contentWindow.Visible = true
		contentWindow.Position = UDim2.new(0.5, 0, 1.5, 0)
		contentWindow.Size = UDim2.new(0.8, 0, 0.8, 0)
		-- Remove GroupTransparency and use regular transparency
		contentWindow.BackgroundTransparency = 0.3

		-- Animate entrance
		TweenService:Create(contentWindow, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0.9, 0, 0.85, 0),
			BackgroundTransparency = 0
		}):Play()

		-- Animate blur if it exists
		if ShopUI.uiElements.blur then
			TweenService:Create(ShopUI.uiElements.blur, TweenInfo.new(0.3), {
				Size = 24
			}):Play()
		end

		-- Animate color correction if it exists
		if ShopUI.uiElements.colorCorrection then
			TweenService:Create(ShopUI.uiElements.colorCorrection, TweenInfo.new(0.3), {
				Brightness = -0.05,
				Contrast = 0.2,
				Saturation = 0.2
			}):Play()
		end

		playSound("WHOOSH", 0.3)
	end
end

-- Close shop with modern animations
function ShopUI.close()
	if uiState.isShopOpen then
		playSound("WHOOSH", 0.2)

		local contentWindow = ShopUI.uiElements.contentWindow

		-- Animate exit
		TweenService:Create(contentWindow, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(0.5, 0, 1.5, 0),
			Size = UDim2.new(0.8, 0, 0.8, 0),
			BackgroundTransparency = 0.3
		}):Play()

		-- Animate blur removal if it exists
		if ShopUI.uiElements.blur then
			TweenService:Create(ShopUI.uiElements.blur, TweenInfo.new(0.3), {
				Size = 0
			}):Play()
		end

		-- Animate color correction removal if it exists
		if ShopUI.uiElements.colorCorrection then
			TweenService:Create(ShopUI.uiElements.colorCorrection, TweenInfo.new(0.3), {
				Brightness = 0,
				Contrast = 0,
				Saturation = 0
			}):Play()
		end

		task.wait(0.3)

		-- Cleanup
		for _, particle in ipairs(uiState.particles) do
			if particle.tween then
				particle.tween:Cancel()
			end
		end

		if ShopUI.uiElements.blur then
			ShopUI.uiElements.blur:Destroy()
		end

		if ShopUI.uiElements.colorCorrection then
			ShopUI.uiElements.colorCorrection:Destroy()
		end

		CharacterPreview.destroy(uiState.previewViewport)
		ShopUI.uiElements.screenGui:Destroy()

		-- FIXED: Reset state properly
		ShopUI.isInitialized = false
		uiState.isShopOpen = false
		ShopUI.uiElements = {}
		uiState.animations = {}
		uiState.particles = {}

		-- Re-enable the SlitherIOMenu if it exists
		local menuGui = Players.LocalPlayer.PlayerGui:FindFirstChild("SlitherIOMenu")
		if menuGui then
			menuGui.Enabled = true
		end
	end
end

-- Toggle shop
function ShopUI.toggle()
	if uiState.isShopOpen then
		ShopUI.close()
	else
		ShopUI.open()
	end
end

-- Show function for your loader
function ShopUI.Show()
	ShopUI.open()
end

-- Create function for your loader
function ShopUI.Create()
	ShopUI.open()
end

