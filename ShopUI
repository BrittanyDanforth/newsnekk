		)

		-- Animate rotation
		spawn(function()
			while layer.Parent do
				TweenService:Create(grad, TweenInfo.new(20 + i * 5, Enum.EasingStyle.Linear), {
					Rotation = grad.Rotation + 360
				}):Play()
				wait(20 + i * 5)
			end
		end)
	end

	-- Create floating geometric shapes
	local shapes = {"rbxassetid://5553946593", "rbxassetid://5553946967", "rbxassetid://5553947033"}

