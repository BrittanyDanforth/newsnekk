		playSound("SELECT", 0.3)

		uiState.currentCategory = index
		ShopUI.updateSkinGrid()

		-- Hide/show preview based on category
		local isGamepass = SKIN_CATEGORIES[index].name == "Gamepasses"
		if isGamepass then
			print("🎮 Switching to Gamepasses - hiding preview")
			-- Clear the preview and hide the container
			if CharacterPreview and CharacterPreview.cleanup then
				CharacterPreview.cleanup()
			end

			-- Hide preview container for gamepasses
			if ShopUI.uiElements.previewContainer then
				ShopUI.uiElements.previewContainer.Visible = false
			end

			-- Hide skin-specific UI elements
			if ShopUI.uiElements.skinName then
				ShopUI.uiElements.skinName.Visible = false
			end
			if ShopUI.uiElements.skinTag then
				ShopUI.uiElements.skinTag.Visible = false
			end
			if ShopUI.uiElements.priceLabel then
				ShopUI.uiElements.priceLabel.Visible = false
			end
			if ShopUI.uiElements.applyBtn then
				ShopUI.uiElements.applyBtn.Visible = false
			end
			if ShopUI.uiElements.purchaseBtn then
				ShopUI.uiElements.purchaseBtn.Visible = false
			end
			if ShopUI.uiElements.robuxBtn then
				ShopUI.uiElements.robuxBtn.Visible = false
			end
			if ShopUI.uiElements.favoriteBtn then
				ShopUI.uiElements.favoriteBtn.Visible = false
			end
		else
			-- Show everything for skins
			if ShopUI.uiElements.previewContainer then
				ShopUI.uiElements.previewContainer.Visible = true
			end
			if ShopUI.uiElements.skinName then
				ShopUI.uiElements.skinName.Visible = true
			end
			if ShopUI.uiElements.skinTag then
				ShopUI.uiElements.skinTag.Visible = true
			end
			if ShopUI.uiElements.priceLabel then
				ShopUI.uiElements.priceLabel.Visible = true
			end

			-- Force show all UI elements for skins
			if ShopUI.uiElements.purchaseBtn then
				ShopUI.uiElements.purchaseBtn.Visible = true
			end
			if ShopUI.uiElements.robuxBtn then
				ShopUI.uiElements.robuxBtn.Visible = true
			end
			if ShopUI.uiElements.applyBtn then
				ShopUI.uiElements.applyBtn.Visible = true
			end
			if ShopUI.uiElements.favoriteBtn then
				ShopUI.uiElements.favoriteBtn.Visible = true
			end

			-- Update preview if needed
			if uiState.selectedSkin then
				ShopUI.updatePreview()
				ShopUI.updateInfo()
			else
				-- No skin selected, select first one
				local category = SKIN_CATEGORIES[uiState.currentCategory]
				if category and category.skins and #category.skins > 0 then
					uiState.selectedSkin = category.skins[1]
					ShopUI.updatePreview()
					ShopUI.updateInfo()
				end
			end
		end

		-- Update indicators
		for _, child in pairs(ShopUI.uiElements.sidebar:GetChildren()) do
			if child:IsA("TextButton") then
				local ind = child:FindFirstChild("SelectionIndicator")
				if ind then
					ind.Visible = false
					local indGlow = ind:FindFirstChild("Frame")
					if indGlow then
						indGlow.Visible = false
					end
				end
				TweenService:Create(child, TweenInfo.new(0.2), {
					BackgroundTransparency = 0.7,
					Size = UDim2.new(0.9, 0, 0, 70)
				}):Play()
			end
		end

		indicator.Visible = true
		indicatorGlow.Visible = true
		TweenService:Create(btn, TweenInfo.new(0.2), {
			BackgroundTransparency = 0.5,
			Size = UDim2.new(0.92, 0, 0, 72)
		}):Play()
	end)

	return btn
end

