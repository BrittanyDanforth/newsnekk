-- Create modern skin card
local function createSkinCard(skinName, index)
	-- Validate skin name
	if not skinName or type(skinName) ~= "string" or skinName == "" then
		warn("Invalid skin name:", tostring(skinName))
		return
	end

	local skinData = ShopUI.SKIN_DATA[skinName]
	if not skinData then
		warn("No skin data found for:", skinName)
		return
	end
	local isOwned = table.find(ShopUI.playerData.ownedSkins, skinName) ~= nil
	local isCurrent = ShopUI.playerData.currentSkin == skinName

	local card = Instance.new("TextButton")
	card.Name = "SkinCard_"..skinName
	card.Size = UDim2.new(0, SHOP_CONFIG.CARD_WIDTH, 0, SHOP_CONFIG.CARD_HEIGHT)
	card.BackgroundColor3 = SHOP_CONFIG.COLORS.SECONDARY
	card.BackgroundTransparency = 0.5
	card.Text = ""
	card.Parent = ShopUI.uiElements.gridScroll

	-- Grid position
	local columns = 4
	local row = math.floor((index - 1) / columns)
	local col = (index - 1) % columns
	card.Position = UDim2.new(0, col * (SHOP_CONFIG.CARD_WIDTH + SHOP_CONFIG.GRID_SPACING) + 10, 
		0, row * (SHOP_CONFIG.CARD_HEIGHT + SHOP_CONFIG.GRID_SPACING) + 10)

	createCorner(card, 18)
	createGlassPanel(card, 0.85)

	-- Card stroke for equipped/owned state
	local cardStroke = Instance.new("UIStroke")
	cardStroke.Name = "CardStroke"
	cardStroke.Thickness = 2
	cardStroke.Transparency = 0.8
	cardStroke.Color = SHOP_CONFIG.COLORS.TERTIARY
	cardStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cardStroke.Parent = card

	-- Modern glow effect
	local glowContainer = Instance.new("Frame")
	glowContainer.Name = "GlowContainer"
	glowContainer.Size = UDim2.new(1.1, 0, 1.1, 0)
	glowContainer.Position = UDim2.new(-0.05, 0, -0.05, 0)
	glowContainer.BackgroundColor3 = SHOP_CONFIG.COLORS.ACCENT
	glowContainer.BackgroundTransparency = 1
	glowContainer.ZIndex = card.ZIndex - 1
	glowContainer.Parent = card
	createCorner(glowContainer, 20)

	-- Preview frame with modern design
	local previewFrame = Instance.new("Frame")
	previewFrame.Name = "PreviewFrame"
	previewFrame.Size = UDim2.new(0.9, 0, 0.62, 0)
	previewFrame.Position = UDim2.new(0.05, 0, 0.03, 0)
	previewFrame.BackgroundColor3 = SHOP_CONFIG.COLORS.BACKGROUND
	previewFrame.BackgroundTransparency = 0.3
	previewFrame.Parent = card

	createCorner(previewFrame, 12)

	-- Mini preview with gradient
	local miniPreview = Instance.new("Frame")
	miniPreview.Name = "MiniPreview"
	miniPreview.Size = UDim2.new(1, 0, 1, 0)
	miniPreview.BackgroundTransparency = 0.5
	miniPreview.BackgroundColor3 = SHOP_CONFIG.COLORS.PRIMARY
	miniPreview.Parent = previewFrame

	createCorner(miniPreview, 12)

	-- Get skin preview data
	local previewSkinData = SnakeSkinsData[skinName]
	if previewSkinData then
		-- Create gradient based on skin colors
		local skinGradient = Instance.new("UIGradient")
		skinGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, previewSkinData.HeadColor),
			ColorSequenceKeypoint.new(0.5, previewSkinData.BodyColors[1] or previewSkinData.HeadColor),
			ColorSequenceKeypoint.new(1, previewSkinData.BodyColors[#previewSkinData.BodyColors] or previewSkinData.HeadColor)
		})
		skinGradient.Rotation = 45
		skinGradient.Parent = miniPreview
	end

	-- Animated color orbs
	local orbContainer = Instance.new("Frame")
	orbContainer.Size = UDim2.new(1, 0, 1, 0)
	orbContainer.BackgroundTransparency = 1
	orbContainer.Parent = miniPreview

	if previewSkinData and previewSkinData.BodyColors then
		for i = 1, math.min(3, #previewSkinData.BodyColors) do
			local orb = Instance.new("Frame")
			orb.Size = UDim2.new(0.25, 0, 0.25, 0)
			orb.Position = UDim2.new(0.2 + (i-1) * 0.25, 0, 0.375, 0)
			orb.BackgroundColor3 = previewSkinData.BodyColors[i]
			orb.Parent = orbContainer
			createCorner(orb, 50)

			-- Orb glow
			local orbGlow = Instance.new("Frame")
			orbGlow.Size = UDim2.new(1.5, 0, 1.5, 0)
			orbGlow.Position = UDim2.new(-0.25, 0, -0.25, 0)
			orbGlow.BackgroundColor3 = previewSkinData.BodyColors[i]
			orbGlow.BackgroundTransparency = 0.8
			orbGlow.ZIndex = orb.ZIndex - 1
			orbGlow.Parent = orb
			createCorner(orbGlow, 50)
		end
	end

	-- Skin name with modern styling
	local nameContainer = Instance.new("Frame")
	nameContainer.Size = UDim2.new(0.9, 0, 0.13, 0)
	nameContainer.Position = UDim2.new(0.05, 0, 0.68, 0)
	nameContainer.BackgroundTransparency = 1
	nameContainer.Parent = card

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "SkinName"
	nameLabel.Size = UDim2.new(1, 0, 1, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = skinName
	nameLabel.TextColor3 = SHOP_CONFIG.COLORS.TEXT_PRIMARY
	nameLabel.TextScaled = true
	nameLabel.Font = SHOP_CONFIG.FONTS.HEADING
	nameLabel.Parent = nameContainer

	-- Status frame with modern design
	local statusFrame = Instance.new("Frame")
	statusFrame.Name = "StatusFrame"
	statusFrame.Size = UDim2.new(0.9, 0, 0.12, 0)
	statusFrame.Position = UDim2.new(0.05, 0, 0.84, 0)
	statusFrame.BackgroundColor3 = SHOP_CONFIG.COLORS.PRIMARY
	statusFrame.BackgroundTransparency = 0.7
	statusFrame.Parent = card
	createCorner(statusFrame, 8)

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Name = "Status"
	statusLabel.Size = UDim2.new(1, 0, 1, 0)
	statusLabel.BackgroundTransparency = 1
	statusLabel.TextScaled = true
	statusLabel.Font = SHOP_CONFIG.FONTS.PRICE
	statusLabel.Parent = statusFrame

	-- Set status and styling based on ownership
	if isCurrent then
		statusLabel.Text = "✅ EQUIPPED"
		statusLabel.TextColor3 = SHOP_CONFIG.COLORS.SUCCESS
		cardStroke.Color = SHOP_CONFIG.COLORS.SUCCESS
		cardStroke.Transparency = 0.3
		cardStroke.Thickness = 3

		-- Add equipped glow
		glowContainer.BackgroundTransparency = 0.9
	elseif isOwned then
		statusLabel.Text = "✓ OWNED"
		statusLabel.TextColor3 = SHOP_CONFIG.COLORS.ACCENT
		cardStroke.Transparency = 0.6
	else
		-- Show price(s)
		if skinData.robux then
			-- Create price container for both prices
			local priceContainer = Instance.new("Frame")
			priceContainer.Size = UDim2.new(1, 0, 1, 0)
			priceContainer.BackgroundTransparency = 1
			priceContainer.Parent = statusFrame

			-- Coin price
			local coinPrice = Instance.new("TextLabel")
			coinPrice.Size = UDim2.new(0.45, 0, 1, 0)
			coinPrice.Position = UDim2.new(0.025, 0, 0, 0)
			coinPrice.BackgroundTransparency = 1
			if skinData.price and skinData.price > 0 then
				coinPrice.Text = "💎 "..tostring(skinData.price)
				coinPrice.TextColor3 = SHOP_CONFIG.COLORS.WARNING
			else
				coinPrice.Text = "VIP"
				coinPrice.TextColor3 = SHOP_CONFIG.COLORS.VIP_GOLD
			end
			coinPrice.TextScaled = true
			coinPrice.Font = SHOP_CONFIG.FONTS.PRICE
			coinPrice.Parent = priceContainer

			-- Separator
			local orText = Instance.new("TextLabel")
			orText.Size = UDim2.new(0.05, 0, 1, 0)
			orText.Position = UDim2.new(0.475, 0, 0, 0)
			orText.BackgroundTransparency = 1
			orText.Text = "or"
			orText.TextColor3 = SHOP_CONFIG.COLORS.TEXT_MUTED
			orText.TextScaled = true
			orText.Font = SHOP_CONFIG.FONTS.BODY
			orText.Parent = priceContainer

			-- Robux price
			local robuxPrice = Instance.new("TextLabel")
			robuxPrice.Size = UDim2.new(0.45, 0, 1, 0)
			robuxPrice.Position = UDim2.new(0.525, 0, 0, 0)
			robuxPrice.BackgroundTransparency = 1
			robuxPrice.Text = "R$ "..tostring(skinData.robux)
			robuxPrice.TextColor3 = Color3.fromRGB(0, 255, 127)
			robuxPrice.TextScaled = true
			robuxPrice.Font = SHOP_CONFIG.FONTS.PRICE
			robuxPrice.Parent = priceContainer

			statusLabel.Visible = false
		else
			-- Coin price only
			if skinData.price and skinData.price > 0 then
				statusLabel.Text = "💎 "..tostring(skinData.price)
				statusLabel.TextColor3 = SHOP_CONFIG.COLORS.WARNING
			else
				statusLabel.Text = "SPECIAL"
				statusLabel.TextColor3 = SHOP_CONFIG.COLORS.ACCENT
			end
		end
	end

	-- Modern badges
	if skinData.tag then
		local badge = Instance.new("Frame")
		badge.Name = "Badge"
		badge.Size = UDim2.new(0.32, 0, 0.08, 0)
		badge.Position = UDim2.new(0.64, 0, 0.05, 0)
		badge.Parent = card
		createCorner(badge, 6)

		-- Badge color based on tag
		local badgeColor = SHOP_CONFIG.COLORS.ACCENT
		if skinData.tag == "VIP" then
			badgeColor = SHOP_CONFIG.COLORS.VIP_GOLD
		elseif skinData.tag == "New" then
			badgeColor = SHOP_CONFIG.COLORS.SUCCESS
		elseif skinData.tag == "Hot" or skinData.tag == "Trending" then
			badgeColor = SHOP_CONFIG.COLORS.ERROR
		elseif skinData.tag == "Special" then
			badgeColor = SHOP_CONFIG.COLORS.SECONDARY_ACCENT
		end

		badge.BackgroundColor3 = badgeColor

		local badgeGradient = Instance.new("UIGradient")
		badgeGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, badgeColor),
			ColorSequenceKeypoint.new(1, badgeColor:Lerp(Color3.new(0, 0, 0), 0.3))
		})
		badgeGradient.Rotation = 90
		badgeGradient.Parent = badge

		local badgeText = Instance.new("TextLabel")
		badgeText.Size = UDim2.new(1, 0, 1, 0)
		badgeText.BackgroundTransparency = 1
		badgeText.Text = skinData.tag:upper()
		badgeText.TextColor3 = SHOP_CONFIG.COLORS.TEXT_PRIMARY
		badgeText.TextScaled = true
		badgeText.Font = SHOP_CONFIG.FONTS.BUTTON
		badgeText.Parent = badge

		-- Badge glow
		local badgeGlow = Instance.new("Frame")
		badgeGlow.Size = UDim2.new(1.2, 0, 1.4, 0)
		badgeGlow.Position = UDim2.new(-0.1, 0, -0.2, 0)
		badgeGlow.BackgroundColor3 = badgeColor
		badgeGlow.BackgroundTransparency = 0.9
		badgeGlow.ZIndex = badge.ZIndex - 1
		badgeGlow.Parent = badge
		createCorner(badgeGlow, 8)
	end

	-- Hover effects
	card.MouseEnter:Connect(function()
		TweenService:Create(card, TweenInfo.new(0.2), {
			Size = UDim2.new(0, SHOP_CONFIG.CARD_WIDTH * SHOP_CONFIG.HOVER_SCALE, 
				0, SHOP_CONFIG.CARD_HEIGHT * SHOP_CONFIG.HOVER_SCALE)
		}):Play()

		TweenService:Create(glowContainer, TweenInfo.new(0.3), {
			BackgroundTransparency = 0.85
		}):Play()

		TweenService:Create(cardStroke, TweenInfo.new(0.2), {
			Transparency = cardStroke.Transparency - 0.2
		}):Play()
	end)

	card.MouseLeave:Connect(function()
