--[[
NETWORK OPTIMIZATION MODULE FOR MASSIVE SNAKES
Handles efficient replication of snake data to minimize ping/lag issues
]]--

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkOptimization = {}

-- Configuration
local UPDATE_RATES = {
    NEAR = 0.033,      -- 30 FPS for nearby snakes
    MEDIUM = 0.1,      -- 10 FPS for medium distance
    FAR = 0.25,        -- 4 FPS for far snakes
    VERY_FAR = 0.5     -- 2 FPS for very far snakes
}

local DISTANCE_THRESHOLDS = {
    NEAR = 100,
    MEDIUM = 300,
    FAR = 600
}

-- Segment update batching
local BATCH_SIZES = {
    SMALL = 20,        -- For snakes < 500 segments
    MEDIUM = 50,       -- For snakes < 1500 segments  
    LARGE = 100,       -- For snakes < 3000 segments
    MASSIVE = 200      -- For snakes >= 3000 segments
}

-- Track player update timers
local playerUpdateTimers = {}
local lastBatchIndices = {}

-- Initialize remote events
local remoteEvents = ReplicatedStorage:FindFirstChild("SnakeEvents")
if not remoteEvents then
    remoteEvents = Instance.new("Folder")
    remoteEvents.Name = "SnakeEvents"
    remoteEvents.Parent = ReplicatedStorage
end

local updateSnakeRemote = remoteEvents:FindFirstChild("UpdateSnake")
if not updateSnakeRemote then
    updateSnakeRemote = Instance.new("RemoteEvent")
    updateSnakeRemote.Name = "UpdateSnake"
    updateSnakeRemote.Parent = remoteEvents
end

local batchUpdateRemote = remoteEvents:FindFirstChild("BatchUpdateSnake")
if not batchUpdateRemote then
    batchUpdateRemote = Instance.new("RemoteEvent")
    batchUpdateRemote.Name = "BatchUpdateSnake" 
    batchUpdateRemote.Parent = remoteEvents
end

-- Helper functions
local function getDistance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

local function getUpdateRate(distance)
    if distance <= DISTANCE_THRESHOLDS.NEAR then
        return UPDATE_RATES.NEAR
    elseif distance <= DISTANCE_THRESHOLDS.MEDIUM then
        return UPDATE_RATES.MEDIUM
    elseif distance <= DISTANCE_THRESHOLDS.FAR then
        return UPDATE_RATES.FAR
    else
        return UPDATE_RATES.VERY_FAR
    end
end

local function getBatchSize(segmentCount)
    if segmentCount < 500 then
        return BATCH_SIZES.SMALL
    elseif segmentCount < 1500 then
        return BATCH_SIZES.MEDIUM
    elseif segmentCount < 3000 then
        return BATCH_SIZES.LARGE
    else
        return BATCH_SIZES.MASSIVE
    end
end

-- Compress snake data for network transmission
local function compressSnakeData(segments, headPos, headLookVector)
    local compressed = {
        h = {  -- Head data
            math.floor(headPos.X * 10) / 10,
            math.floor(headPos.Y * 10) / 10,
            math.floor(headPos.Z * 10) / 10,
            math.floor(headLookVector.X * 100) / 100,
            math.floor(headLookVector.Y * 100) / 100,
            math.floor(headLookVector.Z * 100) / 100
        },
        s = {}  -- Segment positions (relative to previous)
    }
    
    local lastPos = headPos
    for i = 1, math.min(#segments, 100) do  -- Limit to first 100 segments for network
        local segment = segments[i]
        if segment and segment.Parent then
            local pos = segment.Position
            local relativePos = pos - lastPos
            table.insert(compressed.s, {
                math.floor(relativePos.X * 10) / 10,
                math.floor(relativePos.Y * 10) / 10,
                math.floor(relativePos.Z * 10) / 10
            })
            lastPos = pos
        end
    end
    
    return compressed
end

-- Send optimized updates
function NetworkOptimization.UpdateSnake(player, snakeInstance)
    if not snakeInstance or not snakeInstance.isActive() then return end
    
    local character = player.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local currentTime = tick()
    local playerId = player.UserId
    
    -- Initialize timer if needed
    if not playerUpdateTimers[playerId] then
        playerUpdateTimers[playerId] = {}
        lastBatchIndices[playerId] = 1
    end
    
    -- Update for each other player based on distance
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character then
            local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
            if otherRoot then
                local distance = getDistance(rootPart.Position, otherRoot.Position)
                local updateRate = getUpdateRate(distance)
                
                local lastUpdate = playerUpdateTimers[playerId][otherPlayer.UserId] or 0
                
                if currentTime - lastUpdate >= updateRate then
                    playerUpdateTimers[playerId][otherPlayer.UserId] = currentTime
                    
                    -- For distant players, only send head position
                    if distance > DISTANCE_THRESHOLDS.FAR then
                        updateSnakeRemote:FireClient(otherPlayer, player, {
                            type = "head_only",
                            pos = rootPart.Position,
                            look = rootPart.CFrame.LookVector
                        })
                    else
                        -- Send compressed snake data
                        local headParts = snakeInstance.headParts
                        if headParts and headParts.head then
                            local compressed = compressSnakeData(
                                snakeInstance.segments,
                                headParts.head.Position,
                                headParts.head.CFrame.LookVector
                            )
                            compressed.type = "full"
                            compressed.length = snakeInstance.length()
                            
                            updateSnakeRemote:FireClient(otherPlayer, player, compressed)
                        end
                    end
                end
            end
        end
    end
end

-- Batch update system for massive snakes
function NetworkOptimization.BatchUpdateSnake(player, snakeInstance)
    if not snakeInstance or not snakeInstance.isActive() then return end
    
    local segmentCount = snakeInstance.length()
    if segmentCount < 1000 then
        -- Use regular updates for smaller snakes
        return NetworkOptimization.UpdateSnake(player, snakeInstance)
    end
    
    local playerId = player.UserId
    local batchSize = getBatchSize(segmentCount)
    local batchIndex = lastBatchIndices[playerId] or 1
    
    -- Calculate batch range
    local startIdx = ((batchIndex - 1) * batchSize) + 1
    local endIdx = math.min(startIdx + batchSize - 1, segmentCount)
    
    -- Collect batch data
    local batchData = {
        type = "batch",
        start = startIdx,
        segments = {}
    }
    
    for i = startIdx, endIdx do
        local segment = snakeInstance.segments[i]
        if segment and segment.Parent then
            table.insert(batchData.segments, {
                segment.Position.X,
                segment.Position.Y,
                segment.Position.Z
            })
        end
    end
    
    -- Send to nearby players only
    local character = player.Character
    if character then
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            for _, otherPlayer in pairs(Players:GetPlayers()) do
                if otherPlayer ~= player and otherPlayer.Character then
                    local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if otherRoot then
                        local distance = getDistance(rootPart.Position, otherRoot.Position)
                        if distance <= DISTANCE_THRESHOLDS.MEDIUM then
                            batchUpdateRemote:FireClient(otherPlayer, player, batchData)
                        end
                    end
                end
            end
        end
    end
    
    -- Update batch index
    batchIndex = batchIndex + 1
    if startIdx + batchSize > segmentCount then
        batchIndex = 1
    end
    lastBatchIndices[playerId] = batchIndex
end

-- Priority system for network updates
local updateQueue = {}
local isProcessingQueue = false

function NetworkOptimization.QueueUpdate(player, snakeInstance, priority)
    table.insert(updateQueue, {
        player = player,
        snake = snakeInstance,
        priority = priority or 1,
        timestamp = tick()
    })
    
    -- Sort by priority (higher first)
    table.sort(updateQueue, function(a, b)
        return a.priority > b.priority
    end)
end

-- Process update queue
local function processUpdateQueue()
    if isProcessingQueue or #updateQueue == 0 then return end
    isProcessingQueue = true
    
    local processed = 0
    local maxPerFrame = 5  -- Limit updates per frame
    
    while #updateQueue > 0 and processed < maxPerFrame do
        local update = table.remove(updateQueue, 1)
        if update.player.Parent and update.snake and update.snake.isActive() then
            NetworkOptimization.UpdateSnake(update.player, update.snake)
            processed = processed + 1
        end
    end
    
    isProcessingQueue = false
end

-- Initialize update loop
RunService.Heartbeat:Connect(function()
    processUpdateQueue()
end)

-- Cleanup on player leaving
Players.PlayerRemoving:Connect(function(player)
    local playerId = player.UserId
    playerUpdateTimers[playerId] = nil
    lastBatchIndices[playerId] = nil
    
    -- Remove from queue
    for i = #updateQueue, 1, -1 do
        if updateQueue[i].player == player then
            table.remove(updateQueue, i)
        end
    end
end)

-- Public API
NetworkOptimization.SetUpdateRate = function(rateType, value)
    if UPDATE_RATES[rateType] then
        UPDATE_RATES[rateType] = value
    end
end

NetworkOptimization.SetDistanceThreshold = function(thresholdType, value)
    if DISTANCE_THRESHOLDS[thresholdType] then
        DISTANCE_THRESHOLDS[thresholdType] = value
    end
end

return NetworkOptimization