-- Enhanced death handling with better menu timing
local function onCharacterAdded(character)
	-- Cancel any active death handler from previous character
	if activeDeathHandler then
		pcall(function()
			task.cancel(activeDeathHandler)
		end)
		activeDeathHandler = nil
		isProcessingDeath = false
		print("🛑 Cancelled previous death handler")
	end
	
	-- Reset death processing flag (in case it wasn't reset above)
	isProcessingDeath = false
	
	-- Hide menu when spawning
	if currentMenu then
		currentMenu:Destroy()
		currentMenu = nil
	end

	-- Clear JustRevived flag since we're now spawned
	if LocalPlayer:GetAttribute("JustRevived") then
		print("✅ Clearing JustRevived flag")
		LocalPlayer:SetAttribute("JustRevived", false)
	end
	
	-- Clean up any other lingering attributes
	cleanupReviveAttributes()

	-- Listen for death to show menu again
	local humanoid = character:WaitForChild("Humanoid", 5)
	if humanoid then
		print("🎮 Setting up death handler for character")
		local deathConnection
		deathConnection = humanoid.Died:Connect(function()
			print("💀 humanoid.Died event fired")
			-- Don't process death if we're actively reviving
			if LocalPlayer:GetAttribute("RevivingNow") then
				print("⚠️ Death during revive - ignoring")
				return
			end
			
			-- Prevent multiple death handlers
			if isProcessingDeath then
				print("⚠️ Already processing death, ignoring duplicate")
				return
			end
			isProcessingDeath = true
			
			-- Cancel any previous death handler
			if activeDeathHandler then
				task.cancel(activeDeathHandler)
				activeDeathHandler = nil
			end
			
			-- Start new death handler
			activeDeathHandler = task.spawn(function()
				-- Ensure flag is reset when this handler ends
				local function cleanup()
					isProcessingDeath = false
					activeDeathHandler = nil
				end
				-- Get death info at time of death
				local hasRevive = LocalPlayer:GetAttribute("HasRevive")
				local revivesAvailable = LocalPlayer:GetAttribute("RevivesAvailable") or 0
				local deathTime = tick()
				
				print("💀 Player died - HasRevive:", hasRevive, "RevivesAvailable:", revivesAvailable)
				print("🔍 Death handler started at", os.date("%X"))
				
				-- Create flags for tracking
				local isReviving = false
				local showMenuNow = false
				local connections = {}
				
				-- Helper to disconnect all connections
				local function cleanupConnections()
					for _, conn in pairs(connections) do
						if conn then
							conn:Disconnect()
						end
					end
					connections = {}
				end
				
				-- Listen for revive attribute changes
				connections.reviveCheck = LocalPlayer:GetAttributeChangedSignal("JustRevived"):Connect(function()
					if LocalPlayer:GetAttribute("JustRevived") then
						isReviving = true
						showMenuNow = false
						print("✅ Player is reviving! Menu will not show.")
					end
				end)
				
				connections.revivingNow = LocalPlayer:GetAttributeChangedSignal("RevivingNow"):Connect(function()
					if LocalPlayer:GetAttribute("RevivingNow") then
						isReviving = true
						showMenuNow = false
						print("✅ Player is reviving now! Menu will not show.")
					end
				end)
				
				-- Check for declined revive or timer expiry
				connections.declined = LocalPlayer:GetAttributeChangedSignal("ReviveDeclined"):Connect(function()
					if LocalPlayer:GetAttribute("ReviveDeclined") then
						showMenuNow = true
						print("❌ Player declined revive - show menu immediately")
						LocalPlayer:SetAttribute("ReviveDeclined", false)
					end
				end)
				
				connections.timerExpired = LocalPlayer:GetAttributeChangedSignal("ReviveTimerExpired"):Connect(function()
					if LocalPlayer:GetAttribute("ReviveTimerExpired") then
						showMenuNow = true
						print("⏰ Revive timer expired - show menu immediately")
						LocalPlayer:SetAttribute("ReviveTimerExpired", false)
					end
				end)

				-- Wait based on whether they have revive
				if hasRevive and revivesAvailable > 0 then
					-- Player has revive - wait up to 5.5 seconds for decision
					print("⏳ Waiting for revive decision...")
					local waitTime = 0
					while waitTime < 5.5 and not isReviving and not showMenuNow do
						task.wait(0.05)
						waitTime = waitTime + 0.05
						
						-- Safety check: if too much time has passed, something went wrong
						if tick() - deathTime > 10 then
							print("⚠️ Death handler timeout - breaking wait loop")
							cleanupConnections()
							cleanup()
							return
						end
					end
					
					-- If timer ran out and not reviving, show menu
					if waitTime >= 5.5 and not isReviving and not showMenuNow then
						print("⏰ Wait time exceeded - showing menu")
						showMenuNow = true
					end
				else
					-- Normal death - show menu after short delay
					task.wait(1)
					showMenuNow = true
				end
				
				-- Clean up connections
				cleanupConnections()
				
				-- Final checks before showing menu
				if not isReviving and showMenuNow then
					-- Verify we're still in the same character and actually dead
					local currentChar = LocalPlayer.Character
					if currentChar and currentChar == character then
						local currentHumanoid = currentChar:FindFirstChild("Humanoid")
						if currentHumanoid and currentHumanoid == humanoid and currentHumanoid.Health <= 0 then
							-- One more check - make sure we haven't started reviving
							if not LocalPlayer:GetAttribute("RevivingNow") and not LocalPlayer:GetAttribute("JustRevived") then
								print("📋 Showing respawn menu")
								createMenu(function()
									requestRespawn()
								end)
							else
								print("⚠️ Last second revive detected - not showing menu")
							end
						else
							print("⚠️ Character is alive (health:", currentHumanoid and currentHumanoid.Health or "nil", "), not showing menu")
						end
					else
						print("⚠️ Character changed, not showing menu for old death")
					end
				elseif isReviving then
					print("🎮 Player revived - not showing menu")
				else
					print("⚠️ Menu not shown - showMenuNow:", showMenuNow, "isReviving:", isReviving)
				end
				
				-- Clear processing flag and handler reference
				cleanup()
			end)
		end)
		
		-- Store connection for cleanup
		character.AncestryChanged:Connect(function()
			if not character.Parent then
				if deathConnection then
					deathConnection:Disconnect()
				end
				-- Cancel any active death handler when character is removed
				if activeDeathHandler then
					pcall(function()
						task.cancel(activeDeathHandler)
					end)
					activeDeathHandler = nil
				end
				isProcessingDeath = false
			end
		end)
	end
end

