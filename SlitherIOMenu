-- Helper to clean up any lingering attributes
local function cleanupReviveAttributes()
	LocalPlayer:SetAttribute("ReviveDeclined", false)
	LocalPlayer:SetAttribute("ReviveTimerExpired", false)
	LocalPlayer:SetAttribute("JustRevived", false)
	LocalPlayer:SetAttribute("RevivingNow", false)
end
-- Helper to set graphics mode (attribute + remote event)
local function setGraphicsMode(mode)
	LocalPlayer:SetAttribute("GraphicsMode", mode)
	local event = ReplicatedStorage:FindFirstChild("SetGraphicsMode")
	if event then
		event:FireServer(mode)
	end
end
-- Enhanced respawn system with UI persistence
local function requestRespawn()
	-- Ensure RemoteEvent exists
	local respawnEvent = ReplicatedStorage:FindFirstChild("RespawnSnake")
	if not respawnEvent then
		-- Create it if it doesn't exist (for studio testing)
		respawnEvent = Instance.new("RemoteEvent")
		respawnEvent.Name = "RespawnSnake"
		respawnEvent.Parent = ReplicatedStorage
		print("Created RespawnSnake RemoteEvent")
	end
	
	respawnEvent:FireServer()
end
