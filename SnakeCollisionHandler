-- === ULTRA-OPTIMIZED PERFORMANCE CONSTANTS ===
local SEGMENT_CHUNK_SIZE = 32 -- Smaller chunks for better accuracy
local COLLISION_GRID_SIZE = 50 -- Spatial hashing grid size
local CACHE_DURATION = 0.1 -- Very short cache for accuracy
local MAX_COLLISION_CHECKS_PER_FRAME = 500 -- Limit checks per frame

-- === PRECISE COLLISION SETTINGS ===
local COLLISION_FRAME_SKIP = 1 -- Check every frame for accuracy
local BODY_COLLISION_RADIUS = 2.5 -- Precise body collision
local HEAD_COLLISION_RADIUS = 3.0 -- Head collision slightly larger
local COLLISION_HEIGHT_TOLERANCE = 3.0 -- Y-axis tolerance
local SPAWN_PROTECTION_TIME = 3
local MIN_AI_SPAWN_DISTANCE = 50

-- === ORB SPAWNING ===
local ORB_SPAWN_HEIGHT = 3 -- Standard orb height (matching OrbSpawner)
local GUARANTEED_ORB_COUNT = 3 -- Minimum orbs to spawn

-- === DEATH PROCESSING ===
local deathQueue = {}
local isProcessingDeaths = false
local deadAISnakes = {}
local deadPlayers = {}
local invinciblePlayers = {}
local spawnProtectedAI = {}

-- === WALL COLLISION SETTINGS ===
local WALL_ORB_DROP_AMOUNT = 3
local WALL_ORB_DROP_COOLDOWN = 8.0
local WALL_DAMAGE_MULTIPLIER = 0.95
local WALL_PUSH_TIME = 6.0
local WALL_PUSH_FORCE = 80
local WALL_WARNING_TIME = 4.0
local WALL_PUSH_IMMUNITY_TIME = 30.0
local WALL_CHECK_INTERVAL = 1.0

local wallCollisionCooldowns = {}
local wallContactTime = {}
local wallPushImmunity = {}
local wallLastCheck = {}

-- === ULTRA-OPTIMIZED SPATIAL HASH GRID ===
local SpatialHashGrid = {}
SpatialHashGrid.__index = SpatialHashGrid

function SpatialHashGrid.new(cellSize)
	return setmetatable({
		cells = {},
		cellSize = cellSize or COLLISION_GRID_SIZE,
		generation = 0
	}, SpatialHashGrid)
end

function SpatialHashGrid:clear()
	self.cells = {}
	self.generation = self.generation + 1
end

function SpatialHashGrid:getCellKey(x, z)
	return math.floor(x / self.cellSize) .. "," .. math.floor(z / self.cellSize)
end

function SpatialHashGrid:insert(object, position, data)
	local key = self:getCellKey(position.X, position.Z)
	if not self.cells[key] then
		self.cells[key] = {}
	end
	self.cells[key][object] = data
end

function SpatialHashGrid:remove(object, position)
	local key = self:getCellKey(position.X, position.Z)
	if self.cells[key] then
		self.cells[key][object] = nil
		if next(self.cells[key]) == nil then
			self.cells[key] = nil
		end
	end
end

function SpatialHashGrid:queryRadius(position, radius)
	local results = {}
	local cellRadius = math.ceil(radius / self.cellSize)
	local centerX = math.floor(position.X / self.cellSize)
	local centerZ = math.floor(position.Z / self.cellSize)
	
	for dx = -cellRadius, cellRadius do
		for dz = -cellRadius, cellRadius do
			local key = (centerX + dx) .. "," .. (centerZ + dz)
			local cell = self.cells[key]
			if cell then
				for obj, data in pairs(cell) do
					table.insert(results, {object = obj, data = data})
				end
			end
		end
	end
	
	return results
end

-- Global collision grid
local collisionGrid = SpatialHashGrid.new()

-- === COLLISION CACHE WITH SHORT TTL ===
local CollisionCache = {
	playerSegments = {},
	aiSegments = {},
	frameCount = 0,
	lastGridRebuild = 0
}

-- === HELPER FUNCTIONS ===
local function setPlayerInvincible(player)
	invinciblePlayers[player] = tick() + SPAWN_PROTECTION_TIME
end

local function isPlayerInvincible(player)
	local expire = invinciblePlayers[player]
	return expire and tick() < expire
end

local function setAISpawnProtection(aiHead)
	spawnProtectedAI[aiHead] = tick() + SPAWN_PROTECTION_TIME
end

local function isAIProtected(aiHead)
	if not aiHead then return false end
	local protectionEnd = spawnProtectedAI[aiHead]
	if protectionEnd then
		if tick() < protectionEnd then
			return true
		else
			spawnProtectedAI[aiHead] = nil
		end
	end
	return false
end

-- === OPTIMIZED SEGMENT COLLECTION ===
local function collectPlayerSegments(player)
	local cache = CollisionCache.playerSegments[player]
	local now = tick()
	
	-- Use very short cache duration for accuracy
	if cache and (now - cache.time) < CACHE_DURATION then
		return cache.segments
	end
	
	local segments = {}
	
	-- Check new snake system first
	local snakeModel = workspace:FindFirstChild("Snake_" .. player.Name)
	if snakeModel then
		-- Get actual length from leaderstats
		local actualLength = 10
		if player:FindFirstChild("leaderstats") then
			local lengthValue = player.leaderstats:FindFirstChild("Length")
			if lengthValue then
				actualLength = lengthValue.Value or 10
			end
		end
		
		-- Adaptive segment collection based on length
		local checkInterval = 1
		if actualLength > 500 then
			checkInterval = 2
		end
		if actualLength > 2000 then
			checkInterval = 3
		end
		if actualLength > 5000 then
			checkInterval = 5
		end
		
		-- Collect segments with adaptive interval
		local segmentCount = 0
		for i = 1, 500, checkInterval do
			local seg = snakeModel:FindFirstChild("Segment" .. i)
			if seg and seg:IsA("BasePart") and seg.Parent then
				table.insert(segments, {
					part = seg,
					index = i,
					position = seg.Position
				})
				segmentCount = segmentCount + 1
				
				-- Add to spatial grid
				collisionGrid:insert(seg, seg.Position, {
					type = "player_segment",
					owner = player,
					index = i
				})
			else
				-- If we're checking every 5th segment and one is missing,
				-- check the ones in between to ensure we don't miss the tail
				if checkInterval > 1 and i > segmentCount * checkInterval then
					for j = i - checkInterval + 1, i - 1 do
						local innerSeg = snakeModel:FindFirstChild("Segment" .. j)
						if innerSeg and innerSeg:IsA("BasePart") and innerSeg.Parent then
							table.insert(segments, {
								part = innerSeg,
								index = j,
								position = innerSeg.Position
							})
							segmentCount = segmentCount + 1
							
							collisionGrid:insert(innerSeg, innerSeg.Position, {
								type = "player_segment",
								owner = player,
								index = j
							})
						end
					end
				end
				break
			end
		end
		
		-- Cache the result
		CollisionCache.playerSegments[player] = {
			segments = segments,
			time = now,
			length = actualLength
		}
		
		return segments
	end
	
	-- Fallback to old system
	local snakeInstance = _G.PlayerSnakes and _G.PlayerSnakes[player]
	if snakeInstance and snakeInstance.segments then
		for i, seg in ipairs(snakeInstance.segments) do
			if seg and seg.Parent then
				table.insert(segments, {
					part = seg,
					index = i,
					position = seg.Position
				})
				
				-- Only add every few segments to grid for performance
				if i == 1 or i % 5 == 0 then
					collisionGrid:insert(seg, seg.Position, {
						type = "player_segment",
						owner = player,
						index = i
					})
				end
			end
		end
		
		CollisionCache.playerSegments[player] = {
			segments = segments,
			time = now,
			length = #segments
		}
		
		return segments
	end
	
	return nil
end

local function collectAISegments(aiSnake)
	if not aiSnake or not aiSnake.Segments then
		return nil
	end
	
	local cache = CollisionCache.aiSegments[aiSnake]
	local now = tick()
	
	if cache and (now - cache.time) < CACHE_DURATION then
		return cache.segments
	end
	
	local segments = {}
	for i, seg in ipairs(aiSnake.Segments) do
		if seg and seg.Parent then
			table.insert(segments, {
				part = seg,
				index = i,
				position = seg.Position
			})
			
			-- Add to spatial grid (less frequently for AI)
			if i == 1 or i % 3 == 0 then
				collisionGrid:insert(seg, seg.Position, {
					type = "ai_segment",
					owner = aiSnake,
					index = i
				})
			end
		end
	end
	
	CollisionCache.aiSegments[aiSnake] = {
		segments = segments,
		time = now,
		length = #segments
	}
	
	return segments
end

-- === ULTRA-FAST COLLISION CHECK ===
local function checkCollision(headPos, segments, collisionRadius)
	if not segments or #segments == 0 then
		return false, nil
	end
	
	local radiusSq = collisionRadius * collisionRadius
	local heightTolerance = COLLISION_HEIGHT_TOLERANCE
	
	-- Use spatial grid for initial filtering
	local nearbyObjects = collisionGrid:queryRadius(headPos, collisionRadius * 2)
	local nearbySegmentIndices = {}
	
	for _, result in ipairs(nearbyObjects) do
		if result.data.type == "player_segment" or result.data.type == "ai_segment" then
			nearbySegmentIndices[result.data.index] = true
		end
	end
	
	-- Check segments with spatial filtering
	for _, segData in ipairs(segments) do
		-- Skip if not in nearby grid cells
		if not nearbySegmentIndices[segData.index] and segData.index % 5 ~= 0 then
			continue
		end
		
		local segPos = segData.position
		if not segPos then continue end
		
		-- Quick Y-axis check first
		local yDiff = math.abs(headPos.Y - segPos.Y)
		if yDiff > heightTolerance then
			continue
		end
		
		-- Distance check (squared for performance)
		local dx = headPos.X - segPos.X
		local dz = headPos.Z - segPos.Z
		local distSq = dx * dx + dz * dz
		
		if distSq < radiusSq then
			return true, segData
		end
	end
	
	return false, nil
end

-- === QUEUE DEATH FUNCTIONS ===
local function queuePlayerDeath(player)
	if not player or deadPlayers[player] then return end
	deadPlayers[player] = true
	table.insert(deathQueue, {type = "player", entity = player})
end

local function queueAIDeath(aiHead)
	if not aiHead or deadAISnakes[aiHead] then return end
	deadAISnakes[aiHead] = true
	table.insert(deathQueue, {type = "ai", entity = aiHead})
end

-- === PROCESS DEATHS ===
local function processDeathQueue()
	if isProcessingDeaths or #deathQueue == 0 then return end
	isProcessingDeaths = true
	
	local toProcess = {}
	for i = 1, #deathQueue do
		toProcess[i] = deathQueue[i]
		deathQueue[i] = nil
	end
	
	for _, death in ipairs(toProcess) do
		if death.type == "player" then
			local player = death.entity
			if player and player.Parent and player.Character then
				local humanoid = player.Character:FindFirstChild("Humanoid")
				if humanoid and humanoid.Health > 0 then
					humanoid.Health = 0
				end
			end
		elseif death.type == "ai" then
			local aiHead = death.entity
			if aiHead and aiHead.Parent then
				for _, snake in ipairs(AISnakeModule._activeSnakes) do
					if snake.HeadParts and snake.HeadParts.head == aiHead then
						snake:Destroy()
						break
					end
				end
			end
		end
	end
	
	isProcessingDeaths = false
end

-- === WALL COLLISION ===
local function checkWallCollision(position, isHead)
	if not isHead then return false end
	
	local mapHalf = 400
	local wallThreshold = mapHalf - 10
	
	if math.abs(position.X) > wallThreshold or math.abs(position.Z) > wallThreshold then
		local distToWallX = mapHalf - math.abs(position.X)
		local distToWallZ = mapHalf - math.abs(position.Z)
		if distToWallX < 10 or distToWallZ < 10 then
			return true
		end
	end
	return false
end

local function handleWallCollision(entity, isPlayer)
	local key = isPlayer and entity or (entity.Name or tostring(entity))
	local currentTime = tick()
	
	if wallCollisionCooldowns[key] and currentTime - wallCollisionCooldowns[key] < WALL_ORB_DROP_COOLDOWN then
		return
	end
	
	wallCollisionCooldowns[key] = currentTime
	
	-- Spawn wall collision orbs
	local snakeData = isPlayer and (_G.PlayerSnakes and _G.PlayerSnakes[entity]) or entity
	if not snakeData or not snakeData.segments then return end
	
	local currentLength = #snakeData.segments
	if currentLength <= 10 then return end
	
	local headPos = snakeData.segments[1] and snakeData.segments[1].Position
	if headPos then
		local mapBoundary = 395
		local orbValue = math.min(15, math.floor(currentLength / 100) + 1)
		
		for i = 1, WALL_ORB_DROP_AMOUNT do
			local randomOffset = Vector3.new(
				math.random(-10, 10),
				0,
				math.random(-10, 10)
			)
			local orbPos = headPos + randomOffset
			orbPos = Vector3.new(
				math.clamp(orbPos.X, -mapBoundary, mapBoundary),
				ORB_SPAWN_HEIGHT,
				math.clamp(orbPos.Z, -mapBoundary, mapBoundary)
			)
			
			local orb = OrbUtils.spawnOrbAt(orbPos, orbValue)
			if orb and isPlayer then
				orb:SetAttribute("SpawnedByUserId", entity.UserId)
				orb:SetAttribute("SpawnTime", tick())
			end
		end
		
		-- Shrink player snake
		if isPlayer and snakeData.shrink then
			local segmentsToRemove = math.min(math.floor(currentLength * 0.1), currentLength - 10)
			if segmentsToRemove > 0 then
				snakeData.shrink(segmentsToRemove)
			end
		end
	end
end

-- === MAIN COLLISION LOOP ===
local framesSinceGridRebuild = 0
local collisionCheckCount = 0

RunService.Heartbeat:Connect(function()
	CollisionCache.frameCount = CollisionCache.frameCount + 1
	
	-- Skip frames for performance
	if CollisionCache.frameCount % COLLISION_FRAME_SKIP ~= 0 then
		return
	end
	
	-- Rebuild spatial grid periodically
	framesSinceGridRebuild = framesSinceGridRebuild + 1
	if framesSinceGridRebuild >= 30 then -- Every 0.5 seconds at 60 FPS
		collisionGrid:clear()
		framesSinceGridRebuild = 0
	end
	
	-- Reset collision check counter
	collisionCheckCount = 0
	
	-- Get all heads
	local playerHeads = {}
	local aiHeads = {}
	
	-- Collect player heads
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			local head = player.Character:FindFirstChild("HumanoidRootPart")
			if head and head.Parent and not deadPlayers[player] then
				table.insert(playerHeads, {
					player = player,
					part = head,
					position = head.Position
				})
				
				-- Add to spatial grid
				collisionGrid:insert(head, head.Position, {
					type = "player_head",
					owner = player
				})
			end
		end
	end
	
	-- Collect AI heads
	if AISnakeModule._activeSnakes then
		for _, snake in ipairs(AISnakeModule._activeSnakes) do
			if snake and snake._active and snake.HeadParts and snake.HeadParts.head then
				local head = snake.HeadParts.head
				if head.Parent and not deadAISnakes[head] then
					table.insert(aiHeads, {
						snake = snake,
						part = head,
						position = head.Position
					})
					
					-- Add to spatial grid
					collisionGrid:insert(head, head.Position, {
						type = "ai_head",
						owner = snake
					})
				end
			end
		end
	end
	
	-- === PLAYER HEAD vs AI BODY (Player kills AI) ===
	for _, playerHead in ipairs(playerHeads) do
		if collisionCheckCount > MAX_COLLISION_CHECKS_PER_FRAME then break end
		
		local player = playerHead.player
		local headPos = playerHead.position
		
		-- Wall collision check
		if checkWallCollision(headPos, true) then
			handleWallCollision(player, true)
		end
		
		-- Check against AI bodies
		for _, aiHead in ipairs(aiHeads) do
			if collisionCheckCount > MAX_COLLISION_CHECKS_PER_FRAME then break end
			
			local aiSnake = aiHead.snake
			if isAIProtected(aiHead.part) then continue end
			
			-- Skip if too close to AI head (head-to-head collision)
			local distToAIHead = (headPos - aiHead.position).Magnitude
			if distToAIHead < HEAD_COLLISION_RADIUS * 1.5 then
				continue
			end
			
			-- Get AI segments
			local aiSegments = collectAISegments(aiSnake)
			if aiSegments then
				collisionCheckCount = collisionCheckCount + 1
				local hit, hitSegment = checkCollision(headPos, aiSegments, BODY_COLLISION_RADIUS)
				
				if hit then
					-- Verify it's not the head
					if hitSegment.index > 3 then -- Skip first few segments near head
						queueAIDeath(aiHead.part)
						if aiSnake.setConfidenceBuff then
							aiSnake:setConfidenceBuff()
						end
						break
					end
				end
			end
		end
	end
	
	-- === AI HEAD vs PLAYER BODY (AI kills Player) ===
	for _, aiHead in ipairs(aiHeads) do
		if collisionCheckCount > MAX_COLLISION_CHECKS_PER_FRAME then break end
		
		local aiSnake = aiHead.snake
		local aiHeadPos = aiHead.position
		
		-- Wall collision check for AI
		if checkWallCollision(aiHeadPos, true) then
			handleWallCollision(aiSnake, false)
		end
		
		-- Check against player bodies
		for _, playerHead in ipairs(playerHeads) do
			if collisionCheckCount > MAX_COLLISION_CHECKS_PER_FRAME then break end
			
			local player = playerHead.player
			if isPlayerInvincible(player) then continue end
			
			-- Get player segments
			local playerSegments = collectPlayerSegments(player)
			if playerSegments then
				collisionCheckCount = collisionCheckCount + 1
				local hit, hitSegment = checkCollision(aiHeadPos, playerSegments, BODY_COLLISION_RADIUS)
				
				if hit then
					queuePlayerDeath(player)
					break
				end
			end
		end
		
		-- Check against other AI bodies
		for _, otherAIHead in ipairs(aiHeads) do
			if collisionCheckCount > MAX_COLLISION_CHECKS_PER_FRAME then break end
			if otherAIHead == aiHead then continue end
			
			local otherSnake = otherAIHead.snake
			if isAIProtected(otherAIHead.part) then continue end
			
			local otherSegments = collectAISegments(otherSnake)
			if otherSegments then
				collisionCheckCount = collisionCheckCount + 1
				local hit = checkCollision(aiHeadPos, otherSegments, BODY_COLLISION_RADIUS)
				
				if hit then
					queueAIDeath(aiHead.part)
					if otherSnake.setConfidenceBuff then
						otherSnake:setConfidenceBuff()
					end
					break
				end
			end
		end
	end
	
	-- === HEAD-TO-HEAD COLLISIONS ===
	-- Player vs Player
	for i = 1, #playerHeads - 1 do
		if collisionCheckCount > MAX_COLLISION_CHECKS_PER_FRAME then break end
		
		for j = i + 1, #playerHeads do
			if collisionCheckCount > MAX_COLLISION_CHECKS_PER_FRAME then break end
			
			local playerA = playerHeads[i].player
			local playerB = playerHeads[j].player
			
			if isPlayerInvincible(playerA) or isPlayerInvincible(playerB) then
				continue
			end
			
			local dist = (playerHeads[i].position - playerHeads[j].position).Magnitude
			if dist < HEAD_COLLISION_RADIUS then
				collisionCheckCount = collisionCheckCount + 1
				
				-- Both die in head-to-head
				queuePlayerDeath(playerA)
				queuePlayerDeath(playerB)
			end
		end
	end
	
	-- Player vs AI head-to-head
	for _, playerHead in ipairs(playerHeads) do
		if collisionCheckCount > MAX_COLLISION_CHECKS_PER_FRAME then break end
		
		local player = playerHead.player
		if isPlayerInvincible(player) then continue end
		
		for _, aiHead in ipairs(aiHeads) do
			if collisionCheckCount > MAX_COLLISION_CHECKS_PER_FRAME then break end
			
			local dist = (playerHead.position - aiHead.position).Magnitude
			if dist < HEAD_COLLISION_RADIUS then
				collisionCheckCount = collisionCheckCount + 1
				
				-- Determine winner based on length
				local playerLength = 10
				if player:FindFirstChild("leaderstats") then
					local lengthValue = player.leaderstats:FindFirstChild("Length")
					if lengthValue then
						playerLength = lengthValue.Value or 10
					end
				end
				
				local aiLength = aiHead.snake.CurrentLength or 10
				
				if playerLength > aiLength then
					queueAIDeath(aiHead.part)
				elseif aiLength > playerLength then
					queuePlayerDeath(player)
				else
					-- Both die if equal
					queuePlayerDeath(player)
					queueAIDeath(aiHead.part)
				end
			end
		end
	end
	
	-- AI vs AI head-to-head
	for i = 1, #aiHeads - 1 do
		if collisionCheckCount > MAX_COLLISION_CHECKS_PER_FRAME then break end
		
		for j = i + 1, #aiHeads do
			if collisionCheckCount > MAX_COLLISION_CHECKS_PER_FRAME then break end
			
			local dist = (aiHeads[i].position - aiHeads[j].position).Magnitude
			if dist < HEAD_COLLISION_RADIUS then
				collisionCheckCount = collisionCheckCount + 1
				
				local lengthA = aiHeads[i].snake.CurrentLength or 10
				local lengthB = aiHeads[j].snake.CurrentLength or 10
				
				if lengthA > lengthB then
					queueAIDeath(aiHeads[j].part)
					if aiHeads[i].snake.setConfidenceBuff then
						aiHeads[i].snake:setConfidenceBuff()
					end
				elseif lengthB > lengthA then
					queueAIDeath(aiHeads[i].part)
					if aiHeads[j].snake.setConfidenceBuff then
						aiHeads[j].snake:setConfidenceBuff()
					end
				else
					-- Both die if equal
					queueAIDeath(aiHeads[i].part)
					queueAIDeath(aiHeads[j].part)
				end
			end
		end
	end
	
	-- Process all queued deaths
	processDeathQueue()
end)

-- === SPAWN PROTECTION ===
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		setPlayerInvincible(player)
	end)
end)

-- === CLEANUP ===
Players.PlayerRemoving:Connect(function(player)
	-- Clean all references
	deadPlayers[player] = nil
	invinciblePlayers[player] = nil
	wallCollisionCooldowns[player] = nil
	wallContactTime[player] = nil
	wallPushImmunity[player] = nil
	wallLastCheck[player] = nil
	CollisionCache.playerSegments[player] = nil
end)

-- Initialize existing players
for _, player in ipairs(Players:GetPlayers()) do
	if player.Character then
		setPlayerInvincible(player)
	end
end

-- === ORB SPAWNING FUNCTIONS ===
local function spawnOrbDirect(position, value)
	local success, err = pcall(function()
		if not position or position ~= position then
			position = Vector3.new(0, ORB_SPAWN_HEIGHT, 0)
		end
		value = math.clamp(value or 1, 1, 50)
		OrbUtils.spawnOrbAt(position, value)
	end)
	return success
end

local function spawnDeathOrbs(position, count)
	count = math.min(count, 30)
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local distance = math.random(5, 15)
		local offset = Vector3.new(
			math.cos(angle) * distance,
			0,
			math.sin(angle) * distance
		)
		spawnOrbDirect(position + offset, 3)
	end
end

