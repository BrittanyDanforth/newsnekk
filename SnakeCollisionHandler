											spawnOrbBatched(rootPart.Position + offset + Vector3.new(0, ORB_SPAWN_HEIGHT, 0), 1) -- Death orb
										end
									end
								end

								-- ONLY mark as dead if NOT reviving
								deadPlayers[player] = true

								-- Clear collision caches when dying
