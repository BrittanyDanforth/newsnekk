-- === ULTRA-OPTIMIZED SPATIAL HASH GRID WITH DYNAMIC CELLS ===
local SpatialHashGrid = {}
SpatialHashGrid.__index = SpatialHashGrid

function SpatialHashGrid.new(baseCellSize)
	return setmetatable({
		cells = {},
		baseCellSize = baseCellSize or COLLISION_GRID_SIZE,
		generation = 0,
		objectCount = 0,
		dynamicCellSizes = {} -- Store different cell sizes for different object types
	}, SpatialHashGrid)
end

function SpatialHashGrid:clear()
	self.cells = {}
	self.generation = self.generation + 1
	self.objectCount = 0
	self.dynamicCellSizes = {}
end

function SpatialHashGrid:getCellKey(x, z, cellSize)
	cellSize = cellSize or self.baseCellSize
	return math.floor(x / cellSize) .. "," .. math.floor(z / cellSize)
end

function SpatialHashGrid:insert(object, position, data)
	-- Dynamic cell size based on object type
	local cellSize = self.baseCellSize
	if data.length then
		-- Larger cells for longer snakes
		if data.length > 5000 then
			cellSize = COLLISION_PROFILES.EXTREME.gridCellSize
		elseif data.length > 2000 then
			cellSize = COLLISION_PROFILES.LONG.gridCellSize
		elseif data.length > 500 then
			cellSize = COLLISION_PROFILES.MEDIUM.gridCellSize
		end
	end
	
	local key = self:getCellKey(position.X, position.Z, cellSize)
	if not self.cells[key] then
		self.cells[key] = {}
	end
	self.cells[key][object] = data
	self.objectCount = self.objectCount + 1
	
	-- Store the cell size used for this object
	self.dynamicCellSizes[object] = cellSize
end

function SpatialHashGrid:remove(object, position)
	local cellSize = self.dynamicCellSizes[object] or self.baseCellSize
	local key = self:getCellKey(position.X, position.Z, cellSize)
	if self.cells[key] then
		self.cells[key][object] = nil
		self.objectCount = self.objectCount - 1
		if next(self.cells[key]) == nil then
			self.cells[key] = nil
		end
	end
	self.dynamicCellSizes[object] = nil
end

function SpatialHashGrid:queryRadius(position, radius, priority)
	local results = {}
	local resultCount = 0
	local maxResults = priority and (priority * 100) or 50
	
	-- Check multiple cell sizes for comprehensive coverage
	local cellSizes = {50, 75, 100, 150}
	
	for _, cellSize in ipairs(cellSizes) do
		local cellRadius = math.ceil(radius / cellSize)
		local centerX = math.floor(position.X / cellSize)
		local centerZ = math.floor(position.Z / cellSize)
		
		for dx = -cellRadius, cellRadius do
			for dz = -cellRadius, cellRadius do
				local key = (centerX + dx) .. "," .. (centerZ + dz)
				local cell = self.cells[key]
				if cell then
					for obj, data in pairs(cell) do
						-- Avoid duplicates
						local found = false
						for _, existing in ipairs(results) do
							if existing.object == obj then
								found = true
								break
							end
						end
						
						if not found then
							table.insert(results, {object = obj, data = data})
							resultCount = resultCount + 1
							
							if resultCount >= maxResults then
								return results
							end
						end
					end
				end
			end
		end
	end
	
	return results
end

