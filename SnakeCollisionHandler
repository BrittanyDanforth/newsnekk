-- === GEOMETRY HELPERS (size-aware collision) ===
-- The snake body parts scale up massively as the snake grows (a length-3500 snake
-- has ~10 stud thick segments). Collision distances must scale with the actual
-- part sizes, otherwise the head only "dies" when its centre is almost exactly on
-- a segment centre and slips through the thick visible body the rest of the time.
local function getPartRadius(part)
    if not part or not part.Size then return 2 end
    return math.max(part.Size.X, part.Size.Z) * 0.5
end

-- Representative body radius for a snake, sampled from a few real segments.
local function computeSegmentRadius(parts)
    local r = 0
    local n = math.min(#parts, 12)
    for i = 1, n do
        local p = parts[i]
        if p and p.Size then
            local pr = math.max(p.Size.X, p.Size.Z) * 0.5
            if pr > r then r = pr end
        end
    end
    if r <= 0 then r = 2 end
    return r
end

