-- Leaderboard Logic
local playerEntries = {}
local isExpanded = not isMobile -- Start collapsed on mobile
local lastPlayerData = {} -- Cache player data
local isUpdating = false



-- Collapse/expand functionality with debounce
local expandDebounce = false
local function toggleExpansion()
	if expandDebounce then return end
	expandDebounce = true

	isExpanded = not isExpanded

	local targetSize = isExpanded and UDim2.new(1, 0, 1, -55) or UDim2.new(1, 0, 0, 0)
	local iconRotation = isExpanded and 0 or 180

	TweenService:Create(mainContent, 
		TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Size = targetSize}
	):Play()

	TweenService:Create(expandIcon, 
		TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Rotation = iconRotation}
	):Play()

	task.wait(0.3)
	expandDebounce = false
end

headerButton.MouseButton1Click:Connect(toggleExpansion)

-- Optimized update function
local function updateLeaderboard()
	-- Prevent overlapping updates
	if isUpdating then return end

	local currentTime = tick()
	if currentTime - lastUpdateTime < UPDATE_INTERVAL then
		return
	end

	isUpdating = true
	lastUpdateTime = currentTime

	-- Collect player data
	local playersData = {}
	for _, player in Players:GetPlayers() do
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			local length = leaderstats:FindFirstChild("Length")
			if length then
				table.insert(playersData, {player = player, score = length.Value})
			end
		end
	end

	-- Sort players by score
	table.sort(playersData, function(a, b)
		return a.score > b.score
	end)

	-- Update local player info
	local localPlayerRank = 0
	local localPlayerScore = 0

	for i, data in ipairs(playersData) do
		if data.player == localPlayer then
			localPlayerRank = i
			localPlayerScore = data.score
			break
		end
	end

	yourRankLabel.Text = localPlayerRank > 0 and ("Your Rank: #" .. localPlayerRank) or "Your Rank: Unranked"
	yourScoreLabel.Text = "Score: " .. localPlayerScore

	-- Update character preview only if skin changed
	local localPlayerSkin = localPlayer:GetAttribute("SelectedSkin") or "Default"
	if lastPlayerData.skin ~= localPlayerSkin then
		CharacterPreview.update(localPlayerSkin)
		lastPlayerData.skin = localPlayerSkin
	end

	-- Update player entries (limit to top 10)
	local topPlayers = {}
	for i = 1, math.min(MAX_VISIBLE_PLAYERS, #playersData) do
		topPlayers[i] = playersData[i]
	end

	-- Batch UI updates
	local activePlayers = {}
	for rank, data in ipairs(topPlayers) do
		local player = data.player
		activePlayers[player] = true

		local entry = playerEntries[player]
		if not entry then
			entry = template:Clone()
			entry.Name = player.Name
			entry.Parent = playerList
			entry.Visible = true
			playerEntries[player] = entry
		end

		-- Update entry content
		entry.RankBadge.RankText.Text = tostring(rank)
		entry.PlayerName.Text = player.Name
		entry.Score.Text = tostring(data.score)
		entry.LayoutOrder = rank

		-- Special styling for top 3
		local badgeColor
		if rank == 1 then
			badgeColor = Color3.fromRGB(255, 215, 0) -- Gold
		elseif rank == 2 then
			badgeColor = Color3.fromRGB(192, 192, 192) -- Silver
		elseif rank == 3 then
			badgeColor = Color3.fromRGB(205, 127, 50) -- Bronze
		else
			badgeColor = Color3.fromRGB(70, 130, 255)
		end

		entry.RankBadge.BackgroundColor3 = badgeColor

		-- Highlight local player
		entry.BackgroundColor3 = player == localPlayer and Color3.fromRGB(50, 50, 70) or Color3.fromRGB(30, 30, 40)
	end

	-- Remove inactive players
	for player, entry in pairs(playerEntries) do
		if not activePlayers[player] then
			entry:Destroy()
			playerEntries[player] = nil
		end
	end

	-- Update canvas size
	local canvasHeight = #topPlayers * (isMobile and 39 or 44)
	playerList.CanvasSize = UDim2.new(0, 0, 0, canvasHeight)

	isUpdating = false
end

