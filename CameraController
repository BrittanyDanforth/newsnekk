-- CameraController: SLITHER.IO STYLE CAMERA
-- LOCALSCRIPT INSIDE STARTERPLAYERSCRIPTS
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local camera = workspace.CurrentCamera
local player = Players.LocalPlayer

-- Strict mobile detection
local function isMobileDevice()
	-- Check if we have touch but NO mouse (most reliable)
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return true
	end

	-- Check for mobile-specific sensors
	if UserInputService.GyroscopeEnabled or UserInputService.AccelerometerEnabled then
		return true
	end

	-- Additional check for touch-only devices
	local hasMouse = UserInputService.MouseEnabled
	local hasKeyboard = UserInputService.KeyboardEnabled
	local hasTouch = UserInputService.TouchEnabled

	-- If we only have touch and nothing else, it's likely mobile
	if hasTouch and not hasMouse and not hasKeyboard then
		return true
	end

	return false
end

local isMobile = isMobileDevice()

-- Camera settings - ENHANCED FOR LONG SNAKES
local BASE_HEIGHT = isMobile and 45 or 40  -- Base height - more zoomed for mobile
local MAX_HEIGHT = isMobile and 300 or 400  -- Reduced from 800/1000 - more reasonable zoom
local MEGA_HEIGHT = 600  -- Reduced from 2000 - max height cap for mega snakes
local FOV = 70  -- Base FOV
local MAX_FOV = 85  -- Reduced from 100 - less fisheye effect
local SMOOTH_FACTOR = 0.15  -- Camera smoothing

-- Current camera values for smooth interpolation
local currentHeight = BASE_HEIGHT
local targetHeight = BASE_HEIGHT
local currentFOV = FOV
local targetFOV = FOV

-- 🔒 LOCK CAMERA COMPLETELY
camera.CameraType = Enum.CameraType.Scriptable
camera.CameraSubject = nil

-- Prevent ANY camera manipulation
UserInputService.MouseBehavior = Enum.MouseBehavior.Default
player.CameraMinZoomDistance = 128
player.CameraMaxZoomDistance = 128

-- Function to get snake length for dynamic zoom
local function getSnakeLength()
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local length = leaderstats:FindFirstChild("Length")
		if length then
			return length.Value
		end
	end
	return 0
end

-- Enhanced camera height calculation for very long snakes
local function calculateCameraHeight(snakeLength)
	if snakeLength < 500 then
		-- Normal scaling for small snakes
		return BASE_HEIGHT + (snakeLength / 15)  -- Slower scaling
	elseif snakeLength < 5000 then
		-- Medium scaling for medium snakes
		return BASE_HEIGHT + 33 + (snakeLength / 40)  -- Much slower
	elseif snakeLength < 20000 then
		-- Slower scaling for large snakes
		return BASE_HEIGHT + 150 + (snakeLength / 100)  -- Reduced
	elseif snakeLength < 50000 then
		-- Even slower scaling for huge snakes
		return BASE_HEIGHT + 350 + (snakeLength / 200)  -- Much reduced
	else
		-- For mega snakes (50k+), use logarithmic scaling
		local extraHeight = math.log(snakeLength / 50000) * 50  -- Reduced from 200
		return math.min(600 + extraHeight, MEGA_HEIGHT)
	end
end

-- Calculate FOV based on snake length
local function calculateFOV(snakeLength)
	if snakeLength < 10000 then
		return FOV
	else
		-- Gradually increase FOV for better view at extreme lengths
		local extraFOV = math.min((snakeLength - 10000) / 2000, 15)  -- Reduced scaling
		return math.min(FOV + extraFOV, MAX_FOV)
	end
end

-- Main camera update loop - ENHANCED FOR LONG SNAKES
RunService.RenderStepped:Connect(function(dt)
	local character = player.Character
	if not character then return end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	-- Get snake position
	local snakePos = rootPart.Position

	-- Dynamic zoom based on snake length (enhanced for very long snakes)
	local snakeLength = getSnakeLength()
	targetHeight = calculateCameraHeight(snakeLength)
	targetFOV = calculateFOV(snakeLength)

	-- Smooth camera height transition
	currentHeight = currentHeight + (targetHeight - currentHeight) * SMOOTH_FACTOR
	currentFOV = currentFOV + (targetFOV - currentFOV) * SMOOTH_FACTOR

	-- Camera position with smooth follow
	local cameraPos = snakePos + Vector3.new(0, currentHeight, 0)

	-- For very long snakes, add a slight backward tilt for better view
	if snakeLength > 20000 then
		local tiltFactor = math.min((snakeLength - 20000) / 30000, 1) * 0.2
		cameraPos = cameraPos + Vector3.new(0, 0, currentHeight * tiltFactor)
	end

	-- Look at snake with dynamic offset based on length
	local forwardBias = snakeLength > 10000 and (snakeLength / 10000) or 0.1
	local lookAtPos = snakePos + Vector3.new(0, 0, forwardBias)

	-- Set camera - FIXED ORIENTATION
	camera.CFrame = CFrame.lookAt(cameraPos, lookAtPos, Vector3.new(0, 0, -1))

	-- Dynamic FOV
	camera.FieldOfView = currentFOV

	-- Ensure camera stays scriptable
	camera.CameraType = Enum.CameraType.Scriptable
end)

-- Add vignette effect for slither.io feel
local function addVignetteEffect()
	local playerGui = player:WaitForChild("PlayerGui")

	-- Check if vignette already exists
	if playerGui:FindFirstChild("SlitherVignette") then return end

	local vignetteGui = Instance.new("ScreenGui")
	vignetteGui.Name = "SlitherVignette"
	vignetteGui.ResetOnSpawn = false
	vignetteGui.IgnoreGuiInset = true
	vignetteGui.Parent = playerGui

	local vignetteFrame = Instance.new("ImageLabel")
	vignetteFrame.Name = "Vignette"
	vignetteFrame.Size = UDim2.new(1, 0, 1, 0)
	vignetteFrame.Position = UDim2.new(0, 0, 0, 0)
	vignetteFrame.BackgroundTransparency = 1
	vignetteFrame.Image = "rbxasset://textures/ui/LuaApp/graphic/gr-radial-shadow-1024x1024.png"
	vignetteFrame.ImageColor3 = Color3.fromRGB(0, 0, 0)
	vignetteFrame.ImageTransparency = 0.3
	vignetteFrame.ZIndex = 100
	vignetteFrame.Parent = vignetteGui
end

-- Apply vignette after character loads
player.CharacterAdded:Connect(function()
	task.wait(0.5)
	addVignetteEffect()
end)

-- Apply immediately if character exists
if player.Character then
	addVignetteEffect()
end

print("Camera Controller: SLITHER.IO style camera initialized!")
