-- SnakeDeathHandler - Server-side death and revive handling
-- PROPERLY HANDLES PERSISTENT REVIVES - NO BULLSHIT RESETS

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")

-- DataStore for persistent revives
local reviveDataStore = DataStoreService:GetDataStore("PlayerRevives")

-- Create remotes
local remotes = ReplicatedStorage:FindFirstChild("Remotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "Remotes"
	remotes.Parent = ReplicatedStorage
end

local promptReviveRemote = remotes:FindFirstChild("PromptRevive")
if not promptReviveRemote then
	promptReviveRemote = Instance.new("RemoteEvent")
	promptReviveRemote.Name = "PromptRevive"
	promptReviveRemote.Parent = remotes
end

-- Product configuration
local REVIVE_PRODUCT_ID = 3356734577 -- Your actual product ID

-- Track player deaths and lengths
local playerDeathData = {}

-- Load player revives from DataStore
local function loadPlayerRevives(player)
	local success, result = pcall(function()
		return reviveDataStore:GetAsync("Player_" .. player.UserId) or 0
	end)
	
	if success then
		player:SetAttribute("RevivesAvailable", result)
		print("Loaded", result, "revives for", player.Name)
	else
		-- Default to 0 if load fails
		player:SetAttribute("RevivesAvailable", 0)
		warn("Failed to load revives for", player.Name)
	end
end

-- Save player revives to DataStore
local function savePlayerRevives(player)
	local revives = player:GetAttribute("RevivesAvailable") or 0
	
	local success, result = pcall(function()
		reviveDataStore:SetAsync("Player_" .. player.UserId, revives)
	end)
	
	if success then
		print("Saved", revives, "revives for", player.Name)
	else
		warn("Failed to save revives for", player.Name)
	end
end

-- Handle player death
local function onCharacterDeath(character)
	local humanoid = character:FindFirstChild("Humanoid")
	local player = Players:GetPlayerFromCharacter(character)
	
	if not humanoid or not player then return end
	
	humanoid.Died:Connect(function()
		-- Get the player's current length from leaderstats
		local currentLength = 0
		
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			local lengthValue = leaderstats:FindFirstChild("Length")
			if lengthValue then
				currentLength = lengthValue.Value or 0
			end
		end
		
		-- Store death data
		playerDeathData[player] = {
			deathLength = currentLength,
			deathTime = tick()
		}
		
		-- Set attributes for client to read
		player:SetAttribute("LastLength", currentLength)
		player:SetAttribute("DeathLength", currentLength)
		
		print("Player", player.Name, "died with length:", currentLength)
		print("Player has", player:GetAttribute("RevivesAvailable"), "revives available")
		
		-- Wait a moment for death animation, then prompt revive
		task.wait(0.5)
		
		-- Always show revive prompt (they can buy if no revives)
		promptReviveRemote:FireClient(player, currentLength)
		
		-- Set timer for auto-decline
		task.spawn(function()
			task.wait(5)
			-- If no response after 5 seconds, set timer expired
			if playerDeathData[player] and playerDeathData[player].deathTime then
				player:SetAttribute("ReviveTimerExpired", true)
			end
		end)
	end)
end

-- Handle revive response
promptReviveRemote.OnServerEvent:Connect(function(player, response)
	print("Revive response from", player.Name, ":", response)
	
	local deathData = playerDeathData[player]
	if not deathData then
		warn("No death data for player")
		return
	end
	
	if response == "revive" then
		-- Check if player has revives
		local revivesAvailable = player:GetAttribute("RevivesAvailable") or 0
		
		print("REVIVE ATTEMPT - Player", player.Name, "has", revivesAvailable, "revives")
		
		if revivesAvailable > 0 then
			-- Use a revive
			player:SetAttribute("RevivesAvailable", revivesAvailable - 1)
			player:SetAttribute("JustRevived", true)
			player:SetAttribute("RevivingNow", true)
			
			-- Save the updated revive count
			savePlayerRevives(player)
			
			-- Respawn at 80% length
			local reviveLength = math.floor(deathData.deathLength * 0.8)
			
			-- Set the revive length for the snake system to read
			player:SetAttribute("ReviveLength", reviveLength)
			
			-- Respawn the player
			player:LoadCharacter()
			
			-- Clean up
			task.wait(0.1)
			player:SetAttribute("JustRevived", false)
			player:SetAttribute("RevivingNow", false)
			
			print("Player revived at length:", reviveLength, "- Revives left:", revivesAvailable - 1)
		else
			-- NO REVIVES - Client should have triggered purchase
			warn("Player tried to revive with 0 revives - client should handle purchase")
		end
	else
		-- Player declined revive
		player:SetAttribute("ReviveDeclined", true)
	end
	
	-- Clean up death data
	playerDeathData[player] = nil
end)

-- Handle Robux purchase
MarketplaceService.ProcessReceipt = function(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	
	if receiptInfo.ProductId == REVIVE_PRODUCT_ID then
		-- Grant a revive
		local currentRevives = player:GetAttribute("RevivesAvailable") or 0
		player:SetAttribute("RevivesAvailable", currentRevives + 1)
		
		-- Save to DataStore
		savePlayerRevives(player)
		
		print("Granted revive to", player.Name, "- Total revives:", currentRevives + 1)
		
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- Handle player joining
Players.PlayerAdded:Connect(function(player)
	-- Load saved revives from DataStore
	loadPlayerRevives(player)
	
	-- Initialize other attributes (but NOT RevivesAvailable - that comes from DataStore)
	player:SetAttribute("HasRevive", false)
	player:SetAttribute("JustRevived", false)
	player:SetAttribute("RevivingNow", false)
	player:SetAttribute("ReviveDeclined", false)
	player:SetAttribute("ReviveTimerExpired", false)
	player:SetAttribute("LastLength", 0)
	player:SetAttribute("DeathLength", 0)
	
	-- Set up character death handler
	player.CharacterAdded:Connect(onCharacterDeath)
end)

-- Handle players already in game (for studio testing)
for _, player in ipairs(Players:GetPlayers()) do
	-- Check if revives already loaded
	if player:GetAttribute("RevivesAvailable") == nil then
		loadPlayerRevives(player)
	end
	
	if player.Character then
		onCharacterDeath(player.Character)
	end
	
	player.CharacterAdded:Connect(onCharacterDeath)
end

-- Save on player leaving
Players.PlayerRemoving:Connect(function(player)
	savePlayerRevives(player)
	playerDeathData[player] = nil
end)

-- Auto-save every 30 seconds
task.spawn(function()
	while true do
		task.wait(30)
		for _, player in ipairs(Players:GetPlayers()) do
			savePlayerRevives(player)
		end
		print("Auto-saved all player revives")
	end
end)

print("Snake Death Handler loaded with persistent revive storage!")