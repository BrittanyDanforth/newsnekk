--[[
SNAKE NETWORK HANDLER - SERVER SIDE (ModuleScript)
Handles network replication for optimized snake system
Place this as ModuleScript in ServerScriptService
--]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local SnakeNetworkHandler = {}

function SnakeNetworkHandler.init()
	-- Wait for networking folder with timeout
	local networkFolder = ReplicatedStorage:WaitForChild("SnakeNetworking", 5)
	if not networkFolder then
		warn("SnakeNetworking folder not found! Creating it...")
		-- Create it if it doesn't exist
		networkFolder = Instance.new("Folder")
		networkFolder.Name = "SnakeNetworking"
		networkFolder.Parent = ReplicatedStorage
		
		-- Create events
		local positionUpdate = Instance.new("RemoteEvent")
		positionUpdate.Name = "PositionUpdate"
		positionUpdate.Parent = networkFolder
		
		local lengthUpdate = Instance.new("RemoteEvent")
		lengthUpdate.Name = "LengthUpdate"
		lengthUpdate.Parent = networkFolder
		
		local skinUpdate = Instance.new("RemoteEvent")
		skinUpdate.Name = "SkinUpdate"
		skinUpdate.Parent = networkFolder
	end

	-- Get remote events
	local positionUpdate = networkFolder:WaitForChild("PositionUpdate")
	local lengthUpdate = networkFolder:WaitForChild("LengthUpdate")
	local skinUpdate = networkFolder:WaitForChild("SkinUpdate")

	-- Player snake data
	local playerSnakeData = {}

	-- ULTRA Compression settings for 5k+ length
	local POSITION_PRECISION = 0.5 -- Round positions to nearest 0.5 (less precision)
	local UPDATE_RATE = 10 -- REDUCED to 10 updates per second
	local MAX_PATH_POINTS = 20 -- Maximum path points to send
	local LENGTH_UPDATE_THRESHOLD = 10 -- Only update length if changed by 10+

	-- Handle position updates from clients (ULTRA OPTIMIZED)
	positionUpdate.OnServerEvent:Connect(function(player, data)
		if not data then return end
		
		-- Store player data with minimal overhead
		if not playerSnakeData[player] then
			playerSnakeData[player] = {
				position = Vector3.new(0,0,0),
				lookVector = Vector3.new(0,0,-1),
				length = 50,
				boosting = false,
				lastUpdate = tick(),
				lastLength = 50
			}
		end
		
		local snakeData = playerSnakeData[player]
		
		-- Ultra-compressed data format
		if data.p then -- position
			snakeData.position = data.p
		end
		if data.l then -- lookVector
			snakeData.lookVector = data.l
		end
		if data.s then -- length (only update if changed significantly)
			local newLength = math.clamp(data.s, 10, 50000)
			if math.abs(newLength - snakeData.lastLength) >= LENGTH_UPDATE_THRESHOLD then
				snakeData.length = newLength
				snakeData.lastLength = newLength
			end
		end
		if data.b ~= nil then -- boosting
			snakeData.boosting = data.b == 1
		end
		
		snakeData.lastUpdate = tick()
	end)

	-- Handle length updates
	lengthUpdate.OnServerEvent:Connect(function(player, newLength)
		if not newLength or type(newLength) ~= "number" then return end
		
		newLength = math.clamp(newLength, 10, 5000)
		
		if playerSnakeData[player] then
			playerSnakeData[player].length = newLength
		end
		
		-- Broadcast to other players
		for _, otherPlayer in pairs(Players:GetPlayers()) do
			if otherPlayer ~= player then
				lengthUpdate:FireClient(otherPlayer, player, newLength)
			end
		end
	end)

	-- Handle skin updates
	skinUpdate.OnServerEvent:Connect(function(player, skinName)
		if not skinName or type(skinName) ~= "string" then return end
		
		-- Validate skin name
		if #skinName > 50 then return end
		
		-- Broadcast to all players
		for _, otherPlayer in pairs(Players:GetPlayers()) do
			if otherPlayer ~= player then
				skinUpdate:FireClient(otherPlayer, player, skinName)
			end
		end
	end)

	-- Broadcast updates to all players (ULTRA OPTIMIZED)
	local lastBroadcast = tick()
	local frameCount = 0
	
	RunService.Heartbeat:Connect(function()
		local now = tick()
		if now - lastBroadcast < 1/UPDATE_RATE then return end
		lastBroadcast = now
		
		frameCount = frameCount + 1
		
		-- Prepare update data (compressed format)
		local updateData = {}
		local playerCount = 0
		
		for player, snakeData in pairs(playerSnakeData) do
			if player.Parent and now - snakeData.lastUpdate < 5 then -- Only include recent updates
				playerCount = playerCount + 1
				
				-- Round position for compression
				local compressedPos = Vector3.new(
					math.floor(snakeData.position.X / POSITION_PRECISION + 0.5) * POSITION_PRECISION,
					math.floor(snakeData.position.Y / POSITION_PRECISION + 0.5) * POSITION_PRECISION,
					math.floor(snakeData.position.Z / POSITION_PRECISION + 0.5) * POSITION_PRECISION
				)
				
				-- Ultra compressed data
				updateData[player.UserId] = {
					p = compressedPos,
					l = snakeData.lookVector,
					s = snakeData.length,
					b = snakeData.boosting and 1 or 0
				}
				
				-- Limit players sent per update for huge servers
				if playerCount >= 50 then
					break
				end
			end
		end
		
		-- Only send if there's data
		if next(updateData) then
			-- Send to all players with distance-based filtering
			for _, player in pairs(Players:GetPlayers()) do
				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					local playerPos = player.Character.HumanoidRootPart.Position
					local filteredData = {}
					
					-- Only send nearby players (within 500 studs)
					for userId, data in pairs(updateData) do
						local distance = (data.p - playerPos).Magnitude
						if distance < 500 then
							filteredData[userId] = data
						end
					end
					
					if next(filteredData) then
						positionUpdate:FireClient(player, filteredData)
					end
				end
			end
		end
	end)

	-- Cleanup on player leaving
	Players.PlayerRemoving:Connect(function(player)
		playerSnakeData[player] = nil
	end)

	print("✅ Snake Network Handler initialized")
end

return SnakeNetworkHandler