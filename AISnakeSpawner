-- This goes into Workspace and is a script
-- Spawns and manages multiple AI snakes in the Workspace
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")
local RunService        = game:GetService("RunService")
local AISnake = require(ReplicatedStorage:WaitForChild("AISnake"))

-- === CONFIGURATION ===
local NUM_SNAKES   = 6          -- reduced to prevent overcrowding death orbs
local SPAWN_HEIGHT = 5

-- === AI SNAKE MANAGEMENT ===
local aiSnakes = {}
local respawnQueue = {} -- Track snakes that need respawning

-- Function to clean up orphaned snake parts (run periodically)
local function cleanupOrphanedParts()
	for _, model in pairs(Workspace:GetChildren()) do
		if model.Name == "AISnake" and model:IsA("Model") then
			-- Check if this model belongs to any active snake
			local isActive = false
			for _, snake in pairs(aiSnakes) do
				if snake and snake.Model == model then
					isActive = true
					break
				end
			end
			if not isActive then
				model:Destroy()
			end
		end
	end
end

-- Function to get random spawn position with map compatibility
local function getRandomSpawnPosition()
	-- Check for actual map bounds
	local ground = Workspace:FindFirstChild("SlitherIOGround")
	local spawnRadius = 250  -- Default radius
	
	if ground and ground:IsA("BasePart") then
		-- Use 70% of the smaller map dimension
		local halfX = ground.Size.X / 2
		local halfZ = ground.Size.Z / 2
		spawnRadius = math.min(halfX, halfZ) * 0.7
	end
	
	-- Random position within radius
	local angle = math.random() * 2 * math.pi
	local distance = math.random() * spawnRadius
	local x = math.cos(angle) * distance
	local z = math.sin(angle) * distance
	
	return Vector3.new(x, SPAWN_HEIGHT, z)
end

-- Initial spawn with staggered timing to prevent all spawning at once
task.spawn(function()
	for i = 1, NUM_SNAKES do
		local pos = getRandomSpawnPosition()
		aiSnakes[i] = AISnake.new(pos)
		task.wait(0.2) -- Slightly longer delay for initial spawn
	end
end)

-- Periodic cleanup (every 10 seconds)
task.spawn(function()
	while true do
		task.wait(10)
		cleanupOrphanedParts()
	end
end)

-- Respawn queue processor
task.spawn(function()
	while true do
		task.wait(0.5) -- Check every half second
		
		local currentTime = tick()
		
		-- Process respawn queue
		for i = #respawnQueue, 1, -1 do
			local entry = respawnQueue[i]
			if currentTime >= entry.respawnTime then
				-- Time to respawn this snake
				local pos = getRandomSpawnPosition()
				print("🔄 Respawning AI Snake", entry.index, "at", pos)
				aiSnakes[entry.index] = AISnake.new(pos)
				
				-- Remove from queue
				table.remove(respawnQueue, i)
			end
		end
	end
end)

-- Respawn check counter for performance
local frameCount = 0

-- Auto-respawn any snake that dies/disappears
RunService.Stepped:Connect(function()
	frameCount = frameCount + 1
	
	-- Only check every 30 frames (~0.5 seconds) for performance
	if frameCount < 30 then return end
	frameCount = 0
	
	for i = 1, NUM_SNAKES do
		local snake = aiSnakes[i]
		if not snake or not snake.RootPart or not snake.RootPart.Parent then
			-- Check if already in respawn queue
			local inQueue = false
			for _, entry in ipairs(respawnQueue) do
				if entry.index == i then
					inQueue = true
					break
				end
			end
			
			if not inQueue then
				-- Clean up old snake if needed
				if snake and snake.Destroy then
					pcall(function() snake:Destroy() end)
				end
				
				-- Clear reference
				aiSnakes[i] = nil
				
				-- Add to respawn queue with 3 second delay
				table.insert(respawnQueue, {
					index = i,
					respawnTime = tick() + 3
				})
			end
		end
	end
end)
