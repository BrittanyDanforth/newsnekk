-- This goes into Workspace and is a script
-- Spawns and manages multiple AI snakes in the Workspace
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")
local RunService        = game:GetService("RunService")
local AISnake = require(ReplicatedStorage:WaitForChild("AISnake"))

-- Function to clean up any orphaned snake parts
local function cleanupOrphanedParts()
	local aiModels = Workspace:GetChildren()
	for _, model in pairs(aiModels) do
		if model.Name == "AISnake" and model:IsA("Model") then
			-- Check if this model has no associated active snake
			local isOrphaned = true
			for _, snake in pairs(aiSnakes) do
				if snake and snake.Model == model then
					isOrphaned = false
					break
				end
			end
			if isOrphaned then
				print("Cleaning up orphaned AI snake model")
				model:Destroy()
			end
		end
	end
end

-- === CONFIGURATION ===
local NUM_SNAKES   = 8          -- reduced from 10+ for better performance
local SPAWN_RADIUS = 250        -- ↑ bump this up to spread them out
local SPAWN_HEIGHT = 5
local SPAWN_CENTER = Vector3.new(0, SPAWN_HEIGHT, 0)

-- === AI SNAKE MANAGEMENT ===
local aiSnakes = {}

-- Function to get random spawn position
local function getRandomSpawnPosition()
	local angle = math.random() * 2 * math.pi
	local radius = math.random(100, SPAWN_RADIUS)
	local x = SPAWN_CENTER.X + radius * math.cos(angle)
	local z = SPAWN_CENTER.Z + radius * math.sin(angle)

	-- Add some random offset
	x = x + math.random(-20, 20)
	z = z + math.random(-20, 20)

	-- ENSURE spawn is within safe bounds (map is 800x800, bounds are at ±370)
	local safeLimit = 300  -- Well within the 370 boundary limit
	x = math.clamp(x, -safeLimit, safeLimit)
	z = math.clamp(z, -safeLimit, safeLimit)

	return Vector3.new(x, SPAWN_HEIGHT, z)
end

-- Function to properly initialize snake position without flickering
local function initializeSnakePosition(snake, pos)
	if not snake then return end
	
	-- Wait a frame to ensure all parts are created
	task.wait()
	
	-- Force all snake parts to the spawn position
	if snake.RootPart then
		snake.RootPart.CFrame = CFrame.new(pos)
		snake.RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		snake.RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end
	
	-- Force all segments to spawn position
	if snake.Segments then
		for _, segment in ipairs(snake.Segments) do
			if segment and segment.Parent then
				segment.CFrame = CFrame.new(pos)
				segment.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				-- Make segments invisible for first frame to prevent visual glitch
				segment.Transparency = 1
				task.defer(function()
					task.wait(0.1)
					segment.Transparency = 0
				end)
			end
		end
	end
	
	-- Force head parts to position
	if snake.HeadParts then
		if snake.HeadParts.head then
			snake.HeadParts.head.CFrame = CFrame.new(pos)
			snake.HeadParts.head.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end
		-- Position eyes and other head parts
		for name, part in pairs(snake.HeadParts) do
			if part and part:IsA("BasePart") and part.Parent then
				part.CFrame = CFrame.new(pos)
				part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			end
		end
	end
	
	-- Reset snake direction to prevent weird initial movement
	if snake.Direction then
		snake.Direction = Vector3.new(0, 0, 1)
		snake.TargetYaw = 0
		snake.CurrentYaw = 0
	end
end

-- Clean up any orphaned parts before starting
cleanupOrphanedParts()

-- Initial spawn with proper initialization
for i = 1, NUM_SNAKES do
	local pos = getRandomSpawnPosition()
	local snake = AISnake.new(pos)
	aiSnakes[i] = snake
	
	-- Properly initialize position to prevent dragging
	initializeSnakePosition(snake, pos)
	
	task.wait(0.2) -- Slightly longer delay between spawns for stability
end

-- Periodic cleanup of orphaned parts
task.spawn(function()
	while true do
		task.wait(10) -- Every 10 seconds
		cleanupOrphanedParts()
	end
end)

-- Auto-respawn any snake that dies/disappears
local respawnCheckCounter = 0
RunService.Stepped:Connect(function()
	respawnCheckCounter = respawnCheckCounter + 1

	-- Only check every 30 frames to reduce lag
	if respawnCheckCounter % 30 ~= 0 then return end

	for i = 1, NUM_SNAKES do
		local snake = aiSnakes[i]
		if not snake or not snake.RootPart or not snake.RootPart.Parent then
			-- Ensure old snake is completely destroyed
			if snake and snake.Destroy then
				pcall(function()
					snake:Destroy()
				end)
			end
			
			-- Clear the reference
			aiSnakes[i] = nil
			
			-- Wait a frame to ensure cleanup is complete
			task.wait()
			
			-- Respawn at random position
			local pos = getRandomSpawnPosition()
			print("Respawning AI snake", i, "at position:", pos)
			
			-- Create new snake
			local newSnake = AISnake.new(pos)
			if newSnake then
				aiSnakes[i] = newSnake
				
				-- Properly initialize position to prevent dragging
				initializeSnakePosition(newSnake, pos)
			end
			
			task.wait(0.2) -- Slightly longer delay to prevent spawn spam
		end
	end
end)
