-- This goes into Workspace and is a script
-- Spawns and manages multiple AI snakes in the Workspace
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")
local RunService        = game:GetService("RunService")
local AISnake = require(ReplicatedStorage:WaitForChild("AISnake"))

-- Function to clean up any orphaned snake parts
local function cleanupOrphanedParts()
	local aiModels = Workspace:GetChildren()
	for _, model in pairs(aiModels) do
		if model.Name == "AISnake" and model:IsA("Model") then
			-- Check if this model has no associated active snake
			local isOrphaned = true
			for _, snake in pairs(aiSnakes) do
				if snake and snake.Model == model then
					isOrphaned = false
					break
				end
			end
			if isOrphaned then
				print("Cleaning up orphaned AI snake model")
				model:Destroy()
			end
		end
	end
end

-- === CONFIGURATION ===
local NUM_SNAKES   = 8          -- reduced from 10+ for better performance
local SPAWN_HEIGHT = 5

-- === AI SNAKE MANAGEMENT ===
local aiSnakes = {}

-- Function to get random spawn position compatible with the map
local function getRandomSpawnPosition()
	-- Find the actual ground to get proper bounds
	local ground = Workspace:FindFirstChild("SlitherIOGround")
	local safeLimit = 300  -- Default safe bounds
	
	if ground and ground:IsA("BasePart") then
		-- Use actual map size with buffer
		local halfSizeX = ground.Size.X / 2
		local halfSizeZ = ground.Size.Z / 2
		safeLimit = math.min(halfSizeX - 50, halfSizeZ - 50)  -- 50 stud buffer from edges
	end
	
	-- Generate random position within safe bounds
	local angle = math.random() * 2 * math.pi
	local radius = math.random(50, safeLimit * 0.8)  -- Spawn within 80% of safe area
	local x = radius * math.cos(angle)
	local z = radius * math.sin(angle)
	
	-- Ensure we're within bounds
	x = math.clamp(x, -safeLimit, safeLimit)
	z = math.clamp(z, -safeLimit, safeLimit)

	return Vector3.new(x, SPAWN_HEIGHT, z)
end

-- No longer need complex initialization - handled in AISnake constructor

-- Clean up any orphaned parts before starting
cleanupOrphanedParts()

-- Initial spawn
for i = 1, NUM_SNAKES do
	local pos = getRandomSpawnPosition()
	local snake = AISnake.new(pos)
	aiSnakes[i] = snake
	
	task.wait(0.1) -- Small delay between spawns
end

-- Periodic cleanup of orphaned parts
task.spawn(function()
	while true do
		task.wait(10) -- Every 10 seconds
		cleanupOrphanedParts()
	end
end)

-- Auto-respawn any snake that dies/disappears
local respawnCheckCounter = 0
RunService.Stepped:Connect(function()
	respawnCheckCounter = respawnCheckCounter + 1

	-- Only check every 30 frames to reduce lag
	if respawnCheckCounter % 30 ~= 0 then return end

	for i = 1, NUM_SNAKES do
		local snake = aiSnakes[i]
		if not snake or not snake.RootPart or not snake.RootPart.Parent then
			-- Ensure old snake is completely destroyed
			if snake and snake.Destroy then
				pcall(function()
					snake:Destroy()
				end)
			end
			
			-- Clear the reference
			aiSnakes[i] = nil
			
			-- Wait a frame to ensure cleanup is complete
			task.wait()
			
			-- Respawn at random position
			local pos = getRandomSpawnPosition()
			print("Respawning AI snake", i, "at position:", pos)
			
			-- Create new snake
			local newSnake = AISnake.new(pos)
			if newSnake then
				aiSnakes[i] = newSnake
			end
			
			task.wait(0.1) -- Small delay to prevent spawn spam
		end
	end
end)
