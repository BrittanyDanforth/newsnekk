-- AI Snake Spawner - Fixed version with smooth spawning
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")
local RunService        = game:GetService("RunService")
local AISnake = require(ReplicatedStorage:WaitForChild("AISnake"))

-- === CONFIGURATION ===
local NUM_SNAKES   = 8          -- Number of AI snakes to maintain
local SPAWN_HEIGHT = 5          -- Height to spawn at
local SPAWN_DELAY = 0.5         -- Delay between initial spawns
local RESPAWN_DELAY = 2         -- Delay before respawning dead snakes

-- === AI SNAKE MANAGEMENT ===
local aiSnakes = {}
local respawnQueue = {}

-- Function to clean up orphaned snake parts
local function cleanupOrphanedParts()
	for _, model in pairs(Workspace:GetChildren()) do
		if model.Name:match("^AISnakeModel_") and model:IsA("Model") then
			-- Check if this model belongs to any active snake
			local isActive = false
			for _, snake in pairs(aiSnakes) do
				if snake and snake.Model == model then
					isActive = true
					break
				end
			end
			if not isActive then
				model:Destroy()
			end
		end
	end
end

-- Function to get random spawn position with map compatibility
local function getRandomSpawnPosition()
	-- Check for actual map bounds
	local ground = Workspace:FindFirstChild("SlitherIOGround")
	local spawnRadius = 250  -- Default radius
	
	if ground and ground:IsA("BasePart") then
		-- Use 60% of the smaller map dimension for safer spawning
		local halfX = ground.Size.X / 2
		local halfZ = ground.Size.Z / 2
		spawnRadius = math.min(halfX, halfZ) * 0.6
	end
	
	-- Random position within radius using golden angle for better distribution
	local goldenAngle = (1 + math.sqrt(5)) / 2
	local index = #aiSnakes + 1
	local angle = (index * goldenAngle * 2 * math.pi) + (math.random() - 0.5) * math.pi / 4
	local distance = math.random(100, spawnRadius)
	local x = math.cos(angle) * distance
	local z = math.sin(angle) * distance
	
	return Vector3.new(x, SPAWN_HEIGHT, z)
end

-- Function to spawn a snake safely
local function spawnSnake(index)
	-- Clean up any existing snake at this index
	if aiSnakes[index] then
		pcall(function()
			if aiSnakes[index].Destroy then
				aiSnakes[index]:Destroy()
			end
		end)
		aiSnakes[index] = nil
	end
	
	-- Get spawn position
	local pos = getRandomSpawnPosition()
	
	-- Create new snake with error handling
	local success, newSnake = pcall(function()
		return AISnake.new(pos)
	end)
	
	if success and newSnake then
		aiSnakes[index] = newSnake
		print("Spawned AI Snake", index, "at", pos)
	else
		warn("Failed to spawn AI Snake", index, "- will retry")
		-- Add to respawn queue for retry
		table.insert(respawnQueue, {index = index, time = tick() + RESPAWN_DELAY})
	end
end

-- Initial spawn with stagger to prevent all spawning at once
task.spawn(function()
	print("Starting AI Snake spawn sequence...")
	
	-- Wait a bit for the map to fully load
	task.wait(1)
	
	for i = 1, NUM_SNAKES do
		spawnSnake(i)
		task.wait(SPAWN_DELAY) -- Stagger spawns
	end
	
	print("Initial AI Snake spawn complete")
end)

-- Periodic cleanup (every 30 seconds)
task.spawn(function()
	while true do
		task.wait(30)
		cleanupOrphanedParts()
	end
end)

-- Respawn system
local frameCount = 0
local lastRespawnCheck = 0

RunService.Heartbeat:Connect(function()
	frameCount = frameCount + 1
	local now = tick()
	
	-- Process respawn queue
	for i = #respawnQueue, 1, -1 do
		local entry = respawnQueue[i]
		if now >= entry.time then
			spawnSnake(entry.index)
			table.remove(respawnQueue, i)
		end
	end
	
	-- Only check for dead snakes every 60 frames (~1 second)
	if frameCount < 60 then return end
	frameCount = 0
	
	for i = 1, NUM_SNAKES do
		local snake = aiSnakes[i]
		local needsRespawn = false
		
		if not snake then
			needsRespawn = true
		elseif not snake._active then
			needsRespawn = true
		elseif not snake.RootPart or not snake.RootPart.Parent then
			needsRespawn = true
		elseif snake.HeadParts and snake.HeadParts.head and not snake.HeadParts.head.Parent then
			needsRespawn = true
		end
		
		if needsRespawn then
			-- Clean up old snake
			if snake then
				pcall(function()
					if snake.Destroy then
						snake:Destroy()
					end
				end)
				aiSnakes[i] = nil
			end
			
			-- Check if already in respawn queue
			local inQueue = false
			for _, entry in ipairs(respawnQueue) do
				if entry.index == i then
					inQueue = true
					break
				end
			end
			
			-- Add to respawn queue if not already there
			if not inQueue then
				table.insert(respawnQueue, {index = i, time = now + RESPAWN_DELAY})
				print("AI Snake", i, "died, respawning in", RESPAWN_DELAY, "seconds")
			end
		end
	end
end)

print("AI Snake Spawner initialized -", NUM_SNAKES, "snakes")
