-- CharacterSetup LocalScript for Continuous Beam Snake System
-- Handles visual setup integration with the beam-based snake

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

-- Wait for the beam snake system to be loaded
local function waitForBeamSnake()
	-- Wait for the global PlayerSnake to be set by SnakeMovement
	while not _G.PlayerSnake do
		wait(0.1)
	end
	return _G.PlayerSnake
end

-- Main setup
local function setupCharacterWithBeamSnake()
	print("🎨 Setting up character with Continuous Beam Snake...")
	
	-- Get the beam snake instance
	local beamSnake = waitForBeamSnake()
	if not beamSnake then
		warn("Failed to get beam snake instance")
		return
	end
	
	-- The beam snake system handles all visuals now
	-- We just need to ensure the character is properly hidden
	local humanoid = character:WaitForChild("Humanoid")
	local rootPart = character:WaitForChild("HumanoidRootPart")
	
	-- Hide all character parts
	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part ~= rootPart then
			part.Transparency = 1
			part.CanCollide = false
		elseif part:IsA("Decal") or part:IsA("Texture") then
			part.Transparency = 1
		elseif part:IsA("Accessory") then
			part:Destroy()
		end
	end
	
	-- Monitor for skin changes
	local lastEquippedSkin = player:GetAttribute("EquippedSkin") or "Default"
	
	player:GetAttributeChangedSignal("EquippedSkin"):Connect(function()
		local newSkin = player:GetAttribute("EquippedSkin") or "Default"
		if newSkin ~= lastEquippedSkin and beamSnake then
			beamSnake:applySkin(newSkin)
			lastEquippedSkin = newSkin
			print("🎨 Applied skin:", newSkin)
		end
	end)
	
	-- Monitor for length changes
	player:GetAttributeChangedSignal("SnakeLength"):Connect(function()
		local newLength = player:GetAttribute("SnakeLength") or 10
		if beamSnake then
			beamSnake:setLength(newLength)
		end
	end)
	
	-- Handle respawn
	humanoid.Died:Connect(function()
		print("💀 Character died, beam snake will be cleaned up by SnakeMovement")
	end)
	
	print("✅ Character setup complete with Continuous Beam Snake!")
end

-- Initialize
if character then
	setupCharacterWithBeamSnake()
end

-- Handle respawns
player.CharacterAdded:Connect(function(newCharacter)
	character = newCharacter
	wait(1) -- Wait for SnakeMovement to initialize first
	setupCharacterWithBeamSnake()
end)
