--[[
ULTRA-OPTIMIZED SLITHER.IO SNAKE SYSTEM V6.0
- Handles 5000+ length smoothly
- Supports 8+ players in multiplayer
- Segment streaming (only renders visible segments)
- Network optimized with compression
- Smooth interpolation without gaps
- Dynamic LOD system
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

-- Constants
local SEGMENT_POOL_SIZE = 5000 -- Pre-allocate segments
local MAX_VISIBLE_SEGMENTS = 300 -- Only render nearby segments
local NETWORK_UPDATE_RATE = 10 -- Network updates per second
local INTERPOLATION_BUFFER_SIZE = 3 -- Smooth network interpolation

-- Fast aliases
local Vector3new = Vector3.new
local CFramenew = CFrame.new
local mathMin = math.min
local mathMax = math.max
local mathFloor = math.floor
local mathAbs = math.abs
local tableInsert = table.insert
local tableRemove = table.remove

-- Segment Pool for efficient memory management
local SegmentPool = {}
local SegmentPoolIndex = 0

-- Initialize segment pool
local function initializeSegmentPool()
	for i = 1, SEGMENT_POOL_SIZE do
		local segment = Instance.new("Part")
		segment.Name = "PooledSegment"
		segment.Size = Vector3.new(3.5, 3.5, 3.5)  -- Default size
		segment.Shape = Enum.PartType.Ball
		segment.Material = Enum.Material.Neon
		segment.TopSurface = Enum.SurfaceType.Smooth
		segment.BottomSurface = Enum.SurfaceType.Smooth
		segment.CanCollide = false
		segment.CanQuery = false
		segment.CanTouch = false
		segment.Anchored = true
		segment.Parent = nil -- Keep in memory but not in workspace
		
		-- Add glow effect
		local glow = Instance.new("PointLight")
		glow.Name = "glow"
		glow.Brightness = 0.7  -- Subtle glow as requested
		glow.Range = 4
		glow.Parent = segment
		
		SegmentPool[i] = segment
	end
	print("✅ Segment pool initialized with", SEGMENT_POOL_SIZE, "segments")
end

-- Get segment from pool
local function getSegmentFromPool()
	SegmentPoolIndex = SegmentPoolIndex + 1
	if SegmentPoolIndex > SEGMENT_POOL_SIZE then
		SegmentPoolIndex = 1
	end
	return SegmentPool[SegmentPoolIndex]
end

-- Return segment to pool
local function returnSegmentToPool(segment)
	if segment then
		segment.Parent = nil
		segment.CFrame = CFramenew(0, -1000, 0) -- Move far away
	end
end

-- Optimized Snake Path using Catmull-Rom splines
local SnakePath = {}
SnakePath.__index = SnakePath

function SnakePath.new(maxPoints)
	local self = setmetatable({}, SnakePath)
	self.points = {}
	self.maxPoints = maxPoints or 10000
	self.totalLength = 0
	self.segmentLengths = {}
	return self
end

function SnakePath:addPoint(position, lookVector)
	-- Add new point
	tableInsert(self.points, 1, {
		pos = position,
		look = lookVector,
		time = tick()
	})
	
	-- Calculate segment length
	if #self.points > 1 then
		local dist = (self.points[1].pos - self.points[2].pos).Magnitude
		tableInsert(self.segmentLengths, 1, dist)
		self.totalLength = self.totalLength + dist
	end
	
	-- Remove old points
	while #self.points > self.maxPoints do
		local removed = tableRemove(self.points)
		if #self.segmentLengths > 0 then
			local removedLength = tableRemove(self.segmentLengths)
			self.totalLength = self.totalLength - removedLength
		end
	end
end

function SnakePath:getPositionAtDistance(distance)
	if #self.points < 2 then
		return self.points[1] or {pos = Vector3new(0,0,0), look = Vector3new(0,0,1)}
	end
	
	local currentDist = 0
	for i = 1, #self.segmentLengths do
		local segLength = self.segmentLengths[i]
		if currentDist + segLength >= distance then
			-- Found the segment
			local t = (distance - currentDist) / segLength
			local p1 = self.points[i+1]
			local p2 = self.points[i]
			
			-- Catmull-Rom interpolation for smooth curves
			local p0 = self.points[i+2] or p1
			local p3 = self.points[mathMax(i-1, 1)]
			
			local t2 = t * t
			local t3 = t2 * t
			
			-- Catmull-Rom formula
			local pos = 0.5 * (
				(2 * p1.pos) +
				(-p0.pos + p2.pos) * t +
				(2 * p0.pos - 5 * p1.pos + 4 * p2.pos - p3.pos) * t2 +
				(-p0.pos + 3 * p1.pos - 3 * p2.pos + p3.pos) * t3
			)
			
			local look = p1.look:Lerp(p2.look, t)
			
			return {pos = pos, look = look}
		end
		currentDist = currentDist + segLength
	end
	
	-- Return last point if distance exceeds path
	return self.points[#self.points]
end

-- Create RemoteEvents for networking
local remoteEvents = {}

local function createNetworkEvents()
	local remoteFolder = Instance.new("Folder")
	remoteFolder.Name = "SnakeNetworking"
	remoteFolder.Parent = ReplicatedStorage
	
	-- Position updates (compressed)
	local positionUpdate = Instance.new("RemoteEvent")
	positionUpdate.Name = "PositionUpdate"
	positionUpdate.Parent = remoteFolder
	remoteEvents.positionUpdate = positionUpdate
	
	-- Length updates
	local lengthUpdate = Instance.new("RemoteEvent")
	lengthUpdate.Name = "LengthUpdate"
	lengthUpdate.Parent = remoteFolder
	remoteEvents.lengthUpdate = lengthUpdate
	
	-- Skin updates
	local skinUpdate = Instance.new("RemoteEvent")
	skinUpdate.Name = "SkinUpdate"
	skinUpdate.Parent = remoteFolder
	remoteEvents.skinUpdate = skinUpdate
	
	print("✅ Network events created")
end

-- Optimized Snake Class
local Snake = {}
Snake.__index = Snake

function Snake.new(character, config)
	local self = setmetatable({}, Snake)
	
	self.character = character
	self.rootPart = character:WaitForChild("HumanoidRootPart")
	self.humanoid = character:WaitForChild("Humanoid")
	self.player = Players:GetPlayerFromCharacter(character)
	self.config = config
	
	-- Ensure we have a valid player
	if not self.player then
		warn("Failed to get player from character")
		return nil
	end
	
	-- Make character invisible (like original system)
	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part ~= self.rootPart then
			part.Transparency = 1
			part.CanCollide = false
		elseif part:IsA("Decal") or part:IsA("Texture") then
			part.Transparency = 1
		end
	end
	
	-- Also make root part invisible
	self.rootPart.Transparency = 1
	self.rootPart.CanCollide = true -- Keep collision for movement
	
	-- Snake data
	self.length = config.InitialLength
	self.path = SnakePath.new()
	self.segments = {}
	self.visibleSegments = {}
	self.lastNetworkUpdate = 0
	
	-- Create snake model
	self.model = Instance.new("Model")
	self.model.Name = (self.player.Name or "Unknown") .. "_Snake"
	self.model.Parent = workspace
	
	-- Initialize
	self:createHead()
	self:setupNetworking()
	
	return self
end

function Snake:createHead()
	-- Create visual head
	local head = Instance.new("Part")
	head.Name = "SnakeHead"
	head.Size = self.config.HeadSize or Vector3.new(4.5, 4.5, 4.5)
	head.Shape = Enum.PartType.Ball
	head.Material = self.config.HeadMaterial or Enum.Material.Neon
	head.Color = self.config.HeadColor or Color3.fromRGB(76, 217, 100)
	head.CanCollide = false
	head.CanQuery = false
	head.CanTouch = false
	head.Anchored = true
	head.Parent = self.model
	
	-- Add glow
	local glow = Instance.new("PointLight")
	glow.Brightness = self.config.GlowIntensity or 2
	glow.Range = self.config.GlowRange or 6
	glow.Color = self.config.HeadColor or Color3.fromRGB(76, 217, 100)
	glow.Parent = head
	
	-- Create eyes for visibility
	local function createEye(xOffset)
		local eye = Instance.new("Part")
		eye.Name = "Eye"
		eye.Size = Vector3.new(0.8, 0.8, 0.8)
		eye.Shape = Enum.PartType.Ball
		eye.Material = Enum.Material.Neon
		eye.Color = Color3.fromRGB(255, 255, 255)
		eye.CanCollide = false
		eye.CanQuery = false
		eye.CanTouch = false
		eye.Anchored = true
		eye.Parent = self.model
		
		local pupil = Instance.new("Part")
		pupil.Name = "Pupil"
		pupil.Size = Vector3.new(0.4, 0.4, 0.4)
		pupil.Shape = Enum.PartType.Ball
		pupil.Material = Enum.Material.Neon
		pupil.Color = Color3.fromRGB(0, 0, 0)
		pupil.CanCollide = false
		pupil.CanQuery = false
		pupil.CanTouch = false
		pupil.Anchored = true
		pupil.Parent = self.model
		
		return eye, pupil
	end
	
	self.leftEye, self.leftPupil = createEye(-0.7)
	self.rightEye, self.rightPupil = createEye(0.7)
	
	self.head = head
end

function Snake:setupNetworking()
	if not self.player then return end
	
	-- Setup update loop for all snakes
	self.updateConnection = RunService.Heartbeat:Connect(function(dt)
		self:update(dt)
	end)
	
	-- Only setup networking for local player
	if self.player == Players.LocalPlayer then
		self.networkConnection = RunService.Heartbeat:Connect(function()
			local now = tick()
			if now - self.lastNetworkUpdate > 1/NETWORK_UPDATE_RATE then
				self:sendNetworkUpdate()
				self.lastNetworkUpdate = now
			end
		end)
	else
		-- Setup interpolation for remote players
		self.interpolationBuffer = {}
		self.lastServerUpdate = tick()
	end
end

function Snake:sendNetworkUpdate()
	if not remoteEvents.positionUpdate then return end
	
	-- Compress path data
	local compressedPath = {}
	local step = mathMax(1, mathFloor(#self.path.points / 50)) -- Send max 50 points
	
	for i = 1, #self.path.points, step do
		local point = self.path.points[i]
		tableInsert(compressedPath, {
			p = {mathFloor(point.pos.X*10)/10, mathFloor(point.pos.Y*10)/10, mathFloor(point.pos.Z*10)/10},
			l = {mathFloor(point.look.X*100)/100, mathFloor(point.look.Y*100)/100, mathFloor(point.look.Z*100)/100}
		})
	end
	
	remoteEvents.positionUpdate:FireServer({
		path = compressedPath,
		length = self.length,
		speed = self.humanoid.WalkSpeed
	})
end

function Snake:update(dt)
	-- Update path
	local pos = self.rootPart.Position
	local look = self.rootPart.CFrame.LookVector
	
	-- Only add point if moved enough
	local lastPoint = self.path.points[1]
	if not lastPoint or (pos - lastPoint.pos).Magnitude > 0.5 then
		self.path:addPoint(pos, look)
		
		-- Debug: Print path info periodically
		if math.random() < 0.1 then  -- 10% chance to print
			print("Snake path points:", #self.path.points, "Length:", self.length)
		end
	end
	
	-- Update head and eyes
	if self.head then
		local headCF = CFramenew(pos + look * 2, pos + look * 3)
		self.head.CFrame = headCF
		
		-- Update eyes
		if self.leftEye and self.rightEye then
			local eyeHeight = 0.7
			local eyeForward = -1.5
			local eyeSeparation = 0.7
			
			self.leftEye.CFrame = headCF * CFramenew(-eyeSeparation, eyeHeight, eyeForward)
			self.rightEye.CFrame = headCF * CFramenew(eyeSeparation, eyeHeight, eyeForward)
			
			if self.leftPupil and self.rightPupil then
				self.leftPupil.CFrame = self.leftEye.CFrame * CFramenew(0, 0, -0.3)
				self.rightPupil.CFrame = self.rightEye.CFrame * CFramenew(0, 0, -0.3)
			end
		end
	end
	
	-- Stream segments (only render visible ones)
	self:streamSegments()
end

function Snake:streamSegments()
	local camera = workspace.CurrentCamera
	if not camera then return end
	
	local cameraPos = camera.CFrame.Position
	local renderDistance = 150 -- Only render segments within this distance
	
	-- Hide distant segments
	for i, segment in pairs(self.visibleSegments) do
		if segment and segment.Parent then
			local dist = (segment.Position - cameraPos).Magnitude
			if dist > renderDistance then
				returnSegmentToPool(segment)
				self.visibleSegments[i] = nil
			end
		end
	end
	
	-- Show nearby segments
	local segmentSpacing = self.config.SegmentSpacing
	for i = 1, self.length do
		local distance = i * segmentSpacing
		local pointData = self.path:getPositionAtDistance(distance)
		
		if pointData then
			local dist = (pointData.pos - cameraPos).Magnitude
			if dist <= renderDistance then
				-- Need to show this segment
				if not self.visibleSegments[i] then
					local segment = getSegmentFromPool()
					if segment then
						-- Configure segment
						local colorIndex = ((i - 1) % #self.config.BodyColors) + 1
						local bodyColor = self.config.BodyColors[colorIndex]
						segment.Color = bodyColor
						segment.Size = self.config.SegmentSize or Vector3.new(3.5, 3.5, 3.5)
						
						-- Update glow color
						local glow = segment:FindFirstChild("glow")
						if glow then
							glow.Color = bodyColor
						end
						
						segment.Parent = self.model
						
						self.visibleSegments[i] = segment
					end
				end
				
				-- Update position
				local segment = self.visibleSegments[i]
				if segment then
					segment.CFrame = CFramenew(pointData.pos, pointData.pos + pointData.look)
				end
			end
		end
	end
end

function Snake:updateLength(newLength)
	self.length = mathMin(newLength, self.config.MaxSegments)
	
	-- Network update
	if self.player == Players.LocalPlayer and remoteEvents.lengthUpdate then
		remoteEvents.lengthUpdate:FireServer(self.length)
	end
end

function Snake:destroy()
	-- Return all segments to pool
	for _, segment in pairs(self.visibleSegments) do
		returnSegmentToPool(segment)
	end
	
	-- Cleanup
	if self.networkConnection then
		self.networkConnection:Disconnect()
	end
	
	if self.updateConnection then
		self.updateConnection:Disconnect()
	end
	
	if self.model then
		self.model:Destroy()
	end
end

-- Module
local OptimizedSnakeSystem = {}

function OptimizedSnakeSystem.init()
	-- Initialize pools and networking
	initializeSegmentPool()
	createNetworkEvents()
	
	print("✅ Optimized Snake System V6.0 initialized")
end

function OptimizedSnakeSystem.createSnake(character, config)
	return Snake.new(character, config)
end

return OptimizedSnakeSystem