		self.segments[i] = segment
		self.segmentVisibility[i] = true

		-- Collision tagging
		if i <= 50 then
			CollectionService:AddTag(segment, "SnakeSegment")
			segment:SetAttribute("SegmentIndex", i)
			segment:SetAttribute("OwnerName", self.player.Name)
		end

		-- Create attachment
		local attachment = Instance.new("Attachment")
		attachment.Name = "Attachment" .. i
		attachment.Parent = attachmentPart
		self.attachments[i] = attachment
	end

	-- Create the seamless tube: one beam between each pair of consecutive balls.
	-- Beams are clean, fully-opaque neon (no flow texture) so the body reads as a
	-- single solid glowing snake with no banding or visible seams.
	for i = 0, segmentCount - 1 do
		self:createBodyBeam(i, attachmentPart)
	end

	self.attachmentPart = attachmentPart
	self.visibleSegmentCount = segmentCount
end

-- Build a single clean body beam connecting segment i to i+1.
function Snake:createBodyBeam(i, parent)
	parent = parent or self.attachmentPart
	if not (self.attachments[i] and self.attachments[i + 1]) then return end

	local beam = Instance.new("Beam")
	beam.Name = "Beam" .. i
	beam.Attachment0 = self.attachments[i]
	beam.Attachment1 = self.attachments[i + 1]

	local beamWidth = self:getBeamWidth(i, BASE_SIZE * self.growthFactor)
	beam.Width0 = beamWidth
	beam.Width1 = beamWidth
	beam.CurveSize0 = 0
	beam.CurveSize1 = 0
	beam.FaceCamera = true
	beam.Segments = BEAM_SEGMENTS
	beam.Texture = "" -- Clean solid tube, no flowing noise
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Brightness = 2
	beam.Transparency = NumberSequence.new(0) -- Fully opaque => never looks gapped

	if i == 0 and self.segments[1] then
		-- Smooth colour blend from head into first body segment.
		local headColor = self.segments[0].Color
		local seg1Color = self.segments[1].Color
		beam.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, headColor),
			ColorSequenceKeypoint.new(0.5, headColor:Lerp(seg1Color, 0.5)),
			ColorSequenceKeypoint.new(1, seg1Color),
		})
	else
		beam.Color = ColorSequence.new(self:getSegmentColor(i))
	end

	beam.Parent = parent
	self.beams[i] = beam
	return beam
end

-- 🐍 Compute how many physical balls to render and the constant arc-length
-- spacing between them. Spacing is tied to the segment diameter so balls always
-- overlap (seamless). For snakes longer than the segment cap, spacing is gently
-- stretched so the body stays proportionally long instead of looking stubby.
function Snake:getBodyMetrics()
	local fullCount = math.ceil(self.actualLength * SEGMENTS_PER_LENGTH)
	local count = math.max(1, math.min(fullCount, MAX_SEGMENTS))

	local diameter = BASE_SIZE * (self.growthFactor or 1)

	local boost = 1
	if fullCount > MAX_SEGMENTS then
		boost = math.min(math.sqrt(fullCount / MAX_SEGMENTS), MAX_SPACING_BOOST)
	end

	local spacing = diameter * SEGMENT_SPACING_RATIO * boost
	return count, spacing
end

-- Pre-seed the path with a straight tail behind the head so the body is fully
-- formed the instant the snake spawns.
function Snake:initPath()
	self.pathPoints = {}
	self.growthFactor = self:calculateGrowthFactor()

	local count, spacing = self:getBodyMetrics()
	local seedLen = count * spacing + PATH_BUFFER
	self.requiredPathLength = count * spacing

	local pos = self.rootPart.Position
	local look = self.rootPart.CFrame.LookVector

	local steps = math.max(1, math.ceil(seedLen / MIN_RECORD_DISTANCE))
	local idx = 1
	-- Oldest point (farthest behind, dist = 0) first, head (dist = seedLen) last.
	for k = steps, 0, -1 do
		local d = math.min(k * MIN_RECORD_DISTANCE, seedLen)
		self.pathPoints[idx] = {
			pos = pos - look * d,
			dist = seedLen - d,
		}
		idx = idx + 1
	end

	self.pathTail = 1
	self.pathHead = idx - 1
	self.pathTotal = seedLen
end

-- Record the head's movement as a distance-parameterised path. A point is only
-- added once the head has actually travelled MIN_RECORD_DISTANCE, which makes the
-- spacing independent of server FPS and replication jitter.
function Snake:recordPath()
	local pos = self.rootPart.Position
	local newest = self.pathPoints[self.pathHead]
	if not newest then
		self:initPath()
		return
	end

	local moved = (pos - newest.pos).Magnitude
	if moved < MIN_RECORD_DISTANCE then
		return
	end

	self.pathTotal = self.pathTotal + moved
	self.pathHead = self.pathHead + 1
	self.pathPoints[self.pathHead] = { pos = pos, dist = self.pathTotal }

	-- Trim the tail to just beyond what the body needs.
	local minDist = self.pathTotal - (self.requiredPathLength + PATH_BUFFER)
	while self.pathTail < self.pathHead - 1 and self.pathPoints[self.pathTail].dist < minDist do
		self.pathPoints[self.pathTail] = nil
		self.pathTail = self.pathTail + 1
	end

	-- Compact the deque occasionally so indices don't grow without bound over a
	-- very long session (keeps the table small and the array part dense).
	if self.pathTail > 4096 then
		local compact = {}
		local n = 0
		for idx = self.pathTail, self.pathHead do
			n = n + 1
			compact[n] = self.pathPoints[idx]
		end
		self.pathPoints = compact
		self.pathTail = 1
		self.pathHead = n
	end
end

-- Position (and travel direction) at `distBack` studs behind the head, found by
-- interpolating along the recorded path. Guarantees exact, even spacing.
function Snake:getPathPosition(distBack)
	local targetDist = self.pathTotal - distBack

	local tail = self.pathPoints[self.pathTail]
	local head = self.pathPoints[self.pathHead]
	if not tail or not head then
		local p = self.rootPart.Position
		return p, self.rootPart.CFrame.LookVector
	end

	if targetDist <= tail.dist then
		local nextPt = self.pathPoints[self.pathTail + 1]
		local dir = nextPt and (nextPt.pos - tail.pos) or self.rootPart.CFrame.LookVector
		if dir.Magnitude < 1e-4 then dir = self.rootPart.CFrame.LookVector end
		return tail.pos, dir.Unit
	end
	if targetDist >= head.dist then
		local prevPt = self.pathPoints[self.pathHead - 1]
		local dir = prevPt and (head.pos - prevPt.pos) or self.rootPart.CFrame.LookVector
		if dir.Magnitude < 1e-4 then dir = self.rootPart.CFrame.LookVector end
		return head.pos, dir.Unit
	end

	-- Binary search for the bracketing pair [lo-1, lo].
	local lo, hi = self.pathTail + 1, self.pathHead
	while lo < hi do
		local mid = math.floor((lo + hi) / 2)
		if self.pathPoints[mid].dist < targetDist then
			lo = mid + 1
		else
			hi = mid
		end
	end

	local p2 = self.pathPoints[lo]
	local p1 = self.pathPoints[lo - 1]
	local span = p2.dist - p1.dist
	local t = span > 1e-5 and (targetDist - p1.dist) / span or 0
	local pos = p1.pos:Lerp(p2.pos, t)

	local dir = p2.pos - p1.pos
	if dir.Magnitude < 1e-4 then dir = self.rootPart.CFrame.LookVector end
	return pos, dir.Unit
end

-- The body is never distance-culled (see calculateLODLevel). The only per-frame
-- visibility concern is making sure every beam that connects two active segments
-- stays enabled and fully opaque so the tube reads as one continuous body.
function Snake:updateSegmentVisibility(_cameraPosition)
	for i = 0, self.visibleSegmentCount do
		local segment = self.segments[i]
		if segment and segment.Parent then
			self.segmentVisibility[i] = true
		end
	end
end

function Snake:syncBeamVisibility()
	for i, beam in pairs(self.beams) do
		if beam and beam.Parent and type(i) == "number" then
			beam.Enabled = (i < self.visibleSegmentCount)
		end
	end
end

-- 🎨 ENHANCED: Toggle rainbow mode
function Snake:toggleRainbowMode(enabled)
	self.rainbowMode = enabled
	if enabled then
		print("🌈 Rainbow mode activated!")
	end
end

function Snake:startUpdateLoop()
	local frameCount = 0
	local lastNetworkUpdate = 0

	self.updateConnection = RunService.Heartbeat:Connect(function(deltaTime)
		if not self.character.Parent or not self.rootPart.Parent then
			self:destroy()
			return
		end

		frameCount = frameCount + 1

		-- Record the head's travel as a distance-based path (seamless body).
		self:recordPath()

		-- 🌈 ENHANCED: Update rainbow mode
		if self.rainbowMode then
			self.currentHue = (self.currentHue + deltaTime * RAINBOW_SPEED * 0.1) % 1
		end

		-- 🎨 ENHANCED: Update visual animations
		self.glowPulsePhase = (self.glowPulsePhase + deltaTime * 2) % (math.pi * 2)
		self.beamAnimationOffset = (self.beamAnimationOffset + deltaTime * BEAM_TEXTURE_SPEED) % 10

		-- Smooth length interpolation with growth animation tracking
		if self.actualLength ~= self.targetLength then
			local diff = self.targetLength - self.actualLength
			local growthRate = GROWTH_SPEED

			-- Start growth animation if we're growing
			if diff > 0.1 and not self.isGrowing then
				self.isGrowing = true
				self.growthStartTime = tick()
			end

			-- Use smoother interpolation for growth
			self.actualLength = self.actualLength + diff * growthRate

			-- Stop growth animation when we reach target
			if math.abs(diff) < 0.1 then
				self.actualLength = self.targetLength
				self.isGrowing = false
			end
		else
			self.isGrowing = false
		end

		-- Update growth factor
		if frameCount % GROWTH_CHECK_INTERVAL == 0 then
			self.growthFactor = self:calculateGrowthFactor()
		end

		-- ENHANCED: Update visibility checks
		local cameraPos = self.camera and self.camera.CFrame.Position or self.rootPart.Position
		if frameCount % VISIBILITY_CHECK_INTERVAL == 0 then
			self:updateSegmentVisibility(cameraPos)
		end

		-- ENHANCED: Sync beams with segment visibility
		if frameCount % BEAM_SYNC_INTERVAL == 0 then
			self:syncBeamVisibility()
		end

		-- Update visuals
		self:updateUnifiedBody()

		-- Handle boost effects
		if self.isBoosting then
			-- 🚀 ENHANCED: Professional boost effects
			local rate = self.isMobile and MOBILE_PARTICLE_RATE or DESKTOP_PARTICLE_RATE
			self.boostParticles.Rate = rate * self.particleRateMultiplier

			-- Enhance all glows during boost with pulse
			local pulseMult = 1 + math.sin(self.glowPulsePhase) * 0.2
			for _, glow in pairs(self.glows) do
				if glow and glow.Parent then
					glow.Brightness = GLOW_INTENSITY * 1.5 * pulseMult
				end
			end
		else
			self.boostParticles.Rate = 0
			-- Normal glow with subtle pulse
			local pulseMult = 1 + math.sin(self.glowPulsePhase) * 0.05
			for _, glow in pairs(self.glows) do
				if glow and glow.Parent then
					glow.Brightness = GLOW_INTENSITY * pulseMult
				end
			end
		end

		-- Network updates
		local now = tick()
		if self.player == Players.LocalPlayer and now - lastNetworkUpdate > 1/NETWORK_UPDATE_RATE then
			lastNetworkUpdate = now
			self:sendNetworkUpdate()
		end
	end)
end

function Snake:updateUnifiedBody()
	-- How many balls we need and the constant arc-length between them.
	local requiredSegments, spacing = self:getBodyMetrics()
	self.requiredPathLength = requiredSegments * spacing

	-- Grow the physical body toward the required count. We add several at once so
	-- the body never lags behind the score, but keep it framerate-bounded.
	if requiredSegments > self.visibleSegmentCount then
		local now = tick()
		if now - self.lastSegmentAddTime > SEGMENT_GROWTH_DELAY then
			local deficit = requiredSegments - self.visibleSegmentCount
			self:addSegments(math.min(deficit, 8))
			self.lastSegmentAddTime = now
		end
	end

	local currentBaseSize = BASE_SIZE * self.growthFactor
	local boosting = self.isBoosting
	local rainbow = self.rainbowMode
	local timeNow = tick()

	-- Position every segment along the recorded path at a fixed distance behind
	-- the head. Because spacing is a constant distance (not a number of frames),
	-- the gaps between balls are always identical regardless of speed/FPS.
	for i = 0, self.visibleSegmentCount do
		local segment = self.segments[i]
		if segment and segment.Parent then
			if rainbow and i % 3 == 0 then
				segment.Color = self:getSegmentColor(i)
				if self.glows[i] then
					self.glows[i].Color = segment.Color
				end
			end

			if i == 0 then
				-- Head tracks the root part directly.
				local cf = CFrame.lookAt(
					self.rootPart.Position,
					self.rootPart.Position + self.rootPart.CFrame.LookVector
				)
				segment.CFrame = cf

				local headSize = self:getSegmentSize(0, currentBaseSize)
				segment.Size = Vector3.new(headSize, headSize, headSize)

				local eyeScale = headSize / BASE_SIZE * 0.5
				local eyeOffset = headSize * 0.3
				local eyeForward = -headSize * 0.35

				self.leftEye.Size = Vector3.new(eyeScale, eyeScale, eyeScale)
				self.rightEye.Size = Vector3.new(eyeScale, eyeScale, eyeScale)
				self.leftPupil.Size = Vector3.new(eyeScale * 0.5, eyeScale * 0.5, eyeScale * 0.5)
				self.rightPupil.Size = Vector3.new(eyeScale * 0.5, eyeScale * 0.5, eyeScale * 0.5)

				self.leftEye.CFrame = cf * CFrame.new(-eyeOffset, eyeOffset * 0.5, eyeForward)
				self.rightEye.CFrame = cf * CFrame.new(eyeOffset, eyeOffset * 0.5, eyeForward)
				self.leftPupil.CFrame = self.leftEye.CFrame * CFrame.new(0, 0, -eyeScale * 0.3)
				self.rightPupil.CFrame = self.rightEye.CFrame * CFrame.new(0, 0, -eyeScale * 0.3)
			else
				-- Body segment: exact position on the path => no gaps, no bunching.
				local targetPos = self:getPathPosition(i * spacing)
				segment.Position = targetPos

				local segmentSize = self:getSegmentSize(i, currentBaseSize)
				if boosting then
					segmentSize = segmentSize * (math.sin(timeNow * 10 + i * 0.1) * 0.03 + 1)
				end
				segment.Size = Vector3.new(segmentSize, segmentSize, segmentSize)
			end

			if self.attachments[i] then
				self.attachments[i].WorldPosition = segment.Position
			end
		end
	end

	-- Beams form the continuous tube between the balls. They are always enabled
	-- for active segments so there is never a hole in the body.
	local colorShift = boosting and (math.floor(timeNow * 3) % math.max(1, #self.config.BodyColors)) or 0
	for i, beam in pairs(self.beams) do
		if beam and beam.Parent and type(i) == "number" then
			if i < self.visibleSegmentCount then
				beam.Enabled = true
				local beamWidth = self:getBeamWidth(i, currentBaseSize)
				beam.Width0 = beamWidth
				beam.Width1 = beamWidth

				if rainbow and i % 5 == 0 then
					beam.Color = ColorSequence.new(self:getSegmentColor(i))
				elseif boosting and i > HEAD_BLEND_SEGMENTS then
					local colorIndex = ((i - 1 + colorShift) % #self.config.BodyColors) + 1
					beam.Color = ColorSequence.new(self.config.BodyColors[colorIndex])
				end
			else
				beam.Enabled = false
			end
		end
	end

	-- Glow range scales gently with body size (glows are sparse by construction).
	for i, glow in pairs(self.glows) do
		if glow and glow.Parent then
			local glowScale = 1 - (i / math.max(1, self.visibleSegmentCount)) * 0.3
			glow.Range = (GLOW_RANGE_BASE + (currentBaseSize - BASE_SIZE) * 2) * glowScale
		end
	end
end

function Snake:addSegments(count)
	for i = self.visibleSegmentCount + 1, self.visibleSegmentCount + count do
		if i > MAX_SEGMENTS then break end

		-- Create new segment with fade-in effect
		local segment = Instance.new("Part")
		segment.Name = "Segment" .. i
		segment.Shape = Enum.PartType.Ball
		segment.Material = Enum.Material.Neon

		-- Start small for growth animation
		local targetSize = self:getSegmentSize(i, BASE_SIZE * self.growthFactor)
		segment.Size = Vector3.new(targetSize * 0.1, targetSize * 0.1, targetSize * 0.1)

		segment.Transparency = 0.8 -- Start more transparent
		segment.CanCollide = false
		segment.CanTouch = i <= 50
		segment.CanQuery = false
		segment.Anchored = true

		-- ENHANCED: Apply render settings to new segments
		if i <= FORCE_RENDER_SEGMENTS then
			self:forceRenderSegment(segment, i)
		else
			segment:SetAttribute("RenderFidelity", Enum.RenderFidelity.Automatic)
		end

		segment.Color = self:getSegmentColor(i)

		-- Position at last segment initially
		if self.segments[i - 1] then
			segment.Position = self.segments[i - 1].Position
		end

		-- Add glow based on falloff rules
		local shouldHaveGlow = false
		if i <= GLOW_FALLOFF_START then
			shouldHaveGlow = true
		elseif i <= 100 then
			shouldHaveGlow = i % 2 == 0
		elseif i <= 200 then
			shouldHaveGlow = i % 3 == 0
		else
			shouldHaveGlow = i % 5 == 0
		end

		if shouldHaveGlow then
			local segmentGlow = Instance.new("PointLight")
			segmentGlow.Name = "Glow"
			segmentGlow.Brightness = GLOW_INTENSITY * 0.9
			segmentGlow.Range = GLOW_RANGE_BASE * (0.9 - (i / MAX_SEGMENTS) * 0.2)
			segmentGlow.Color = segment.Color
			segmentGlow.Shadows = false
			segmentGlow.Parent = segment
			self.glows[i] = segmentGlow
		end

		segment.Parent = self.model
		self.segments[i] = segment
		self.segmentVisibility[i] = true
		self.lodStates[i] = "near"

		-- Animate growth
		TweenService:Create(segment, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = Vector3.new(targetSize, targetSize, targetSize),
			Transparency = 0
		}):Play()

		-- Add attachment
		local attachment = Instance.new("Attachment")
		attachment.Name = "Attachment" .. i
		attachment.Parent = self.attachmentPart
		self.attachments[i] = attachment

		-- Connect to the body with a solid full-width beam right away so there is
		-- never a gap or thin spot while the new ball grows in.
		self:createBodyBeam(i - 1, self.attachmentPart)
	end

	self.visibleSegmentCount = math.min(self.visibleSegmentCount + count, MAX_SEGMENTS)
end

function Snake:grow(amount)
	-- Store pending growth for smooth animation
	self.pendingGrowth = self.pendingGrowth + (amount or 1)
	self.targetLength = math.min(self.targetLength + (amount or 1), 50000)

	-- 🎨 ENHANCED: Professional growth visual feedback
	if self.head and self.headGlow then
		-- Flash effect with color shift
		local originalBrightness = self.headGlow.Brightness
		self.headGlow.Brightness = GLOW_INTENSITY * 2.5

		-- Create growth particle burst
		local growthBurst = Instance.new("ParticleEmitter")
		growthBurst.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		growthBurst.Color = ColorSequence.new(self.head.Color)
		growthBurst.Lifetime = NumberRange.new(0.3, 0.5)
		growthBurst.Rate = 0
		growthBurst.Speed = NumberRange.new(10, 20)
		growthBurst.SpreadAngle = Vector2.new(360, 360)
		growthBurst.VelocityInheritance = 0
		growthBurst.EmissionDirection = Enum.NormalId.Front
		growthBurst.Enabled = true
		growthBurst.Parent = self.head
		growthBurst:Emit(30)

		Debris:AddItem(growthBurst, 1)

		TweenService:Create(self.headGlow, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
			Brightness = originalBrightness
		}):Play()
	end

	if self.player then
		local leaderstats = self.player:FindFirstChild("leaderstats")
		if leaderstats then
			local lengthValue = leaderstats:FindFirstChild("Length")
			if lengthValue then
				lengthValue.Value = math.floor(self.targetLength)
			end
		end
	end
end

function Snake:setBoosting(boosting)
	self.isBoosting = boosting

	if boosting then
		self.boostParticles.Enabled = true

		-- 🚀 ENHANCED: Professional speed effects
		for i = 1, 8 do -- More speed lines
			local speedLine = Instance.new("Part")
			speedLine.Name = "SpeedLine"
			speedLine.Size = Vector3.new(0.2, 0.2, math.random(8, 15))
			speedLine.Material = Enum.Material.Neon
			speedLine.Color = self.head.Color
			speedLine.CanCollide = false
			speedLine.Anchored = true
			speedLine.CFrame = self.head.CFrame * CFrame.new(
				math.random(-4, 4),
				math.random(-4, 4),
				5
			) * CFrame.Angles(0, 0, math.random() * math.pi * 2)
			speedLine.Parent = self.model

			-- Add glow to speed lines
			local speedGlow = Instance.new("PointLight")
			speedGlow.Brightness = 1
			speedGlow.Range = 5
			speedGlow.Color = speedLine.Color
			speedGlow.Parent = speedLine

			local tween = TweenService:Create(speedLine,
				TweenInfo.new(0.4, Enum.EasingStyle.Linear),
				{
					Transparency = 1,
					Size = Vector3.new(0.05, 0.05, 25),
					CFrame = speedLine.CFrame * CFrame.new(0, 0, -20)
				}
			)
			tween:Play()
			Debris:AddItem(speedLine, 0.4)
		end

		-- Camera shake effect for local player
		if self.isLocalPlayer then
			local camera = workspace.CurrentCamera
			local originalCF = camera.CFrame

			spawn(function()
				for i = 1, 10 do
					if not self.isBoosting then break end
					camera.CFrame = originalCF * CFrame.Angles(
						math.rad(math.random(-1, 1) * 0.5),
						math.rad(math.random(-1, 1) * 0.5),
						0
					)
					wait(0.03)
				end
				camera.CFrame = originalCF
			end)
		end
	else
		self.boostParticles.Enabled = false
	end
end

function Snake:sendNetworkUpdate()
	if remoteEvents.positionupdate then
		remoteEvents.positionupdate:FireServer({
			position = self.rootPart.Position,
			lookVector = self.rootPart.CFrame.LookVector,
			length = self.targetLength,
			boosting = self.isBoosting,
			rainbowMode = self.rainbowMode -- Include visual mode
		})
	end
end

function Snake:updateLength(newLength)
	self.targetLength = math.min(newLength, 50000)
end

-- Backwards-compatibility shim. Older versions of SnakeSystemIntegration drove
-- the snake with a per-frame `snake:update(dt)` call. This system now runs its
-- own RunService.Heartbeat loop internally (see startUpdateLoop), so an external
-- update call is unnecessary. We keep a safe no-op here so any legacy caller
-- cannot error with "attempt to call missing method 'update'".
function Snake:update(_dt)
	return self
end
Snake.Update = Snake.update

function Snake:GetSegments()
	local collisionSegments = {}
	for i = 1, math.min(50, self.visibleSegmentCount) do
		if self.segments[i] and self.segments[i].Parent then
			table.insert(collisionSegments, self.segments[i])
		end
	end
	return collisionSegments
end

function Snake:GetLength()
	return math.floor(self.targetLength)
end

function Snake:destroy()
	if self.updateConnection then
		self.updateConnection:Disconnect()
		self.updateConnection = nil
	end

	if self.model then
		self.model:Destroy()
		self.model = nil
	end
end

