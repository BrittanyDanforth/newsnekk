-- OPTIMIZED CONFIGURATION
local MAP_SIZE = 1600 -- Match SlitherIOMapBuilder
local ORB_COUNT = 500 -- Reduced from excessive amounts
local RESPAWN_DELAY = 0.8 -- Slightly slower respawn
local BATCH_SIZE = 10 -- Process orbs in smaller batches
local UPDATE_INTERVAL = 0.2 -- Less frequent updates

-- Spawn distribution settings
local GRID_CELLS = 20 -- Divide map into 20x20 grid for even distribution
local MIN_ORB_DISTANCE = 30 -- Minimum distance between orbs
local EDGE_BUFFER = 50 -- Keep orbs away from map edges

-- Performance settings
local RENDER_DISTANCE = 300 -- Distance to render orbs
local FADE_DISTANCE = 150 -- Distance to start fading
local LOD_UPDATE_RATE = 0.3 -- Slower LOD updates
local ORB_POOL_SIZE = 50 -- Smaller pool for better memory

-- Orb configuration
local ORB_BASE_SIZE = 1.5 -- Standard orb size
local DEATH_ORB_SIZE = 2.5 -- Death orb size
local UPGRADE_ORB_SIZE = 3.5 -- Upgrade orb size (not 5)
local UPGRADE_ORB_CHANCE = 0.03 -- 3% chance for upgrade orbs

-- State tracking
local orbs = {}
local orbGrid = {} -- Spatial grid for collision
local orbPool = {} -- Object pooling
local orbStates = {} -- LOD states
local orbDebounce = {}
local orbTweens = {}
local upgradeOrbs = {}
local pooledOrbCount = 0

-- Grid system for even distribution
local spawnGrid = {}
local gridCellSize = MAP_SIZE / GRID_CELLS

-- Create OrbCollected RemoteEvent if it doesn't exist
