-- Initialize spawn grid
local function initializeSpawnGrid()
	for x = 1, GRID_CELLS do
		spawnGrid[x] = {}
		for z = 1, GRID_CELLS do
			spawnGrid[x][z] = {
				occupied = false,
				lastSpawn = 0
			}
		end
	end
end

-- Get grid coordinates from world position
local function worldToGrid(position)
	local halfMap = MAP_SIZE / 2
	local x = math.floor((position.X + halfMap) / gridCellSize) + 1
	local z = math.floor((position.Z + halfMap) / gridCellSize) + 1
	x = math.clamp(x, 1, GRID_CELLS)
	z = math.clamp(z, 1, GRID_CELLS)
	return x, z
end

-- Get world position from grid coordinates (with randomization within cell)
local function gridToWorld(gridX, gridZ)
	local halfMap = MAP_SIZE / 2
	local baseX = (gridX - 1) * gridCellSize - halfMap
	local baseZ = (gridZ - 1) * gridCellSize - halfMap

	-- Add random offset within cell
	local x = baseX + math.random(10, gridCellSize - 10)
	local z = baseZ + math.random(10, gridCellSize - 10)

	-- Ensure within map bounds with edge buffer
	x = math.clamp(x, -halfMap + EDGE_BUFFER, halfMap - EDGE_BUFFER)
	z = math.clamp(z, -halfMap + EDGE_BUFFER, halfMap - EDGE_BUFFER)

	return Vector3.new(x, 3, z) -- Height of 3 for orbs
end

-- Find empty grid cell for spawning
local function findEmptyGridCell()
	local attempts = 0
	local maxAttempts = 50

	while attempts < maxAttempts do
		local gridX = math.random(1, GRID_CELLS)
		local gridZ = math.random(1, GRID_CELLS)

		local cell = spawnGrid[gridX][gridZ]
		if not cell.occupied and (tick() - cell.lastSpawn) > 2 then
			return gridX, gridZ
		end

		attempts = attempts + 1
	end

	-- Fallback: find any available cell
	for x = 1, GRID_CELLS do
		for z = 1, GRID_CELLS do
			if not spawnGrid[x][z].occupied then
				return x, z
			end
		end
	end

	return math.random(1, GRID_CELLS), math.random(1, GRID_CELLS)
end

-- Spatial grid helpers
local SPATIAL_GRID_SIZE = 50
local spatialGrid = {}

local function getSpatialKey(position)
	local x = math.floor(position.X / SPATIAL_GRID_SIZE)
	local z = math.floor(position.Z / SPATIAL_GRID_SIZE)
	return x .. "," .. z
end

local function addOrbToSpatialGrid(orb)
	local key = getSpatialKey(orb.Position)
	if not spatialGrid[key] then
		spatialGrid[key] = {}
	end
	spatialGrid[key][orb] = true
end

local function removeOrbFromSpatialGrid(orb)
	local key = getSpatialKey(orb.Position)
	if spatialGrid[key] then
		spatialGrid[key][orb] = nil
		if next(spatialGrid[key]) == nil then
			spatialGrid[key] = nil
		end
	end
end

local function getOrbsNearPosition(position, radius)
	local nearbyOrbs = {}
	local cellRadius = math.ceil(radius / SPATIAL_GRID_SIZE)
	local centerX = math.floor(position.X / SPATIAL_GRID_SIZE)
	local centerZ = math.floor(position.Z / SPATIAL_GRID_SIZE)

	for dx = -cellRadius, cellRadius do
		for dz = -cellRadius, cellRadius do
			local key = (centerX + dx) .. "," .. (centerZ + dz)
			if spatialGrid[key] then
				for orb, _ in pairs(spatialGrid[key]) do
					if orb and orb.Parent then
						local dist = (orb.Position - position).Magnitude
						if dist <= radius then
							table.insert(nearbyOrbs, orb)
						end
					end
				end
			end
		end
	end

	return nearbyOrbs
end

-- Create orb with minimal effects
local function createOrb(position, value, name, color, material)
	local orb

	-- Try to use pooled orb first
	if #orbPool > 0 and pooledOrbCount > 0 then
		orb = table.remove(orbPool)
		pooledOrbCount = pooledOrbCount - 1

		-- Reset pooled orb
		orb.Position = position
		orb.Color = color or Color3.new(1, 1, 0)
		orb.Material = material or Enum.Material.Neon
		orb.Name = name or "Orb"
		orb.Parent = workspace

		local val = orb:FindFirstChild("Value")
		if val then
			val.Value = value or 5
		end
	else
		-- Create new orb
		orb = Instance.new("Part")
		orb.Name = name or "Orb"
		orb.Shape = Enum.PartType.Ball
		orb.Anchored = true
		orb.CanCollide = false
		orb.CanTouch = true
		orb.Material = material or Enum.Material.Neon
		orb.Color = color or Color3.new(1, 1, 0)
		orb.Position = position
		orb.TopSurface = Enum.SurfaceType.Smooth
		orb.BottomSurface = Enum.SurfaceType.Smooth
		orb.Parent = workspace

		local val = Instance.new("NumberValue")
		val.Name = "Value"
		val.Value = value or 5
		val.Parent = orb

		-- Simple PointLight - no excessive effects
		local light = Instance.new("PointLight")
		light.Parent = orb
		light.Color = orb.Color
		light.Brightness = 1
		light.Range = 6
		light.Enabled = false -- Start disabled
		light.Shadows = false -- Important for performance
	end

	-- Set size based on type
	if name == "DeathOrb" then
		orb.Size = Vector3.new(DEATH_ORB_SIZE, DEATH_ORB_SIZE, DEATH_ORB_SIZE)
		orb.Transparency = 0.2
	elseif name == "UpgradeOrb" then
		orb.Size = Vector3.new(UPGRADE_ORB_SIZE, UPGRADE_ORB_SIZE, UPGRADE_ORB_SIZE)
		orb.Transparency = 0.4
	else
		orb.Size = Vector3.new(ORB_BASE_SIZE, ORB_BASE_SIZE, ORB_BASE_SIZE)
		orb.Transparency = 0.3
	end

	-- Start hidden for LOD
	orbStates[orb] = {state = "hidden", fade = 0}

	return orb
end

-- Spawn regular orb with grid tracking
local function spawnRegularOrb()
	local gridX, gridZ = findEmptyGridCell()
	local position = gridToWorld(gridX, gridZ)

	local isUpgrade = math.random() < UPGRADE_ORB_CHANCE
	local orb

	if isUpgrade then
		orb = createOrb(position, 0, "UpgradeOrb", 
			Color3.fromRGB(0, 150, 255), Enum.Material.ForceField)
		table.insert(upgradeOrbs, orb)
	else
		orb = createOrb(position, 5, "Orb",
			Color3.new(1, 1, 0), Enum.Material.Neon)
	end

	if orb then
		-- Update grid
		spawnGrid[gridX][gridZ].occupied = true
		spawnGrid[gridX][gridZ].lastSpawn = tick()

		-- Track orb
		table.insert(orbs, orb)
		addOrbToSpatialGrid(orb)

		-- Attach touch handler
		attachOrbTouched(orb)

		-- Store grid position for cleanup
		orb:SetAttribute("GridX", gridX)
		orb:SetAttribute("GridZ", gridZ)
	end

	return orb
end

-- Spawn death orbs (simplified)
local function spawnDeathOrbs(position, count)
	local spawned = {}
	count = math.min(count, 30) -- Cap at 30 death orbs

	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local distance = math.random(5, 15)
		local offset = Vector3.new(
			math.cos(angle) * distance,
			0,
			math.sin(angle) * distance
		)

		local orb = createOrb(
			position + offset,
			3, -- Reduced value
			"DeathOrb",
			Color3.fromRGB(255, 100, 100)
		)

		if orb then
			table.insert(orbs, orb)
			table.insert(spawned, orb)
			addOrbToSpatialGrid(orb)
			attachOrbTouched(orb)

			-- Death orbs start visible
			orbStates[orb].state = "full"
			orbStates[orb].fade = 1
			orb.Transparency = 0.2

			local light = orb:FindFirstChild("PointLight")
			if light then
				light.Enabled = true
			end
		end
	end

	return spawned
end

-- Remove orb and update grid
local function removeOrb(orb)
	if not orb then return end

	-- Update spawn grid
	local gridX = orb:GetAttribute("GridX")
	local gridZ = orb:GetAttribute("GridZ")
	if gridX and gridZ and spawnGrid[gridX] and spawnGrid[gridX][gridZ] then
		spawnGrid[gridX][gridZ].occupied = false
	end

	-- Remove from tracking
	for i = #orbs, 1, -1 do
		if orbs[i] == orb then
			table.remove(orbs, i)
			break
		end
	end

	for i = #upgradeOrbs, 1, -1 do
		if upgradeOrbs[i] == orb then
			table.remove(upgradeOrbs, i)
			break
		end
	end

	-- Clean up references
	removeOrbFromSpatialGrid(orb)
	orbDebounce[orb] = nil
	orbStates[orb] = nil

	if orbTweens[orb] then
		orbTweens[orb]:Cancel()
		orbTweens[orb] = nil
	end

	-- Return to pool or destroy
	if pooledOrbCount < ORB_POOL_SIZE and orb.Name ~= "DeathOrb" then
		orb.Parent = nil
		orb.Transparency = 1
		orb.Size = Vector3.new(0.1, 0.1, 0.1)
		table.insert(orbPool, orb)
		pooledOrbCount = pooledOrbCount + 1
	else
		orb:Destroy()
	end
end

-- LOD system (simplified)
local function calculateOrbLOD(orb, viewPositions)
	if not orb or not orb.Parent then return "hidden", 0 end

	local orbPos = orb.Position
	local closestDist = math.huge

	for _, viewPos in pairs(viewPositions) do
		local dist = (orbPos - viewPos).Magnitude
		if dist < closestDist then
			closestDist = dist
		end
	end

	if closestDist <= FADE_DISTANCE then
		return "full", 1.0
	elseif closestDist <= RENDER_DISTANCE then
		local fade = 1 - ((closestDist - FADE_DISTANCE) / (RENDER_DISTANCE - FADE_DISTANCE))
		return "fading", fade
	else
		return "hidden", 0
	end
end

local function applyOrbLOD(orb, state, fadeValue)
	if not orb or not orb.Parent then return end

	local currentState = orbStates[orb]
	if not currentState or (currentState.state == state and math.abs(currentState.fade - fadeValue) < 0.1) then
		return
	end

	orbStates[orb] = {state = state, fade = fadeValue}

	-- Apply LOD
	if state == "hidden" then
		orb.Transparency = 1
		local light = orb:FindFirstChild("PointLight")
		if light then light.Enabled = false end
	else
		orb.Transparency = 0.3 + (0.7 * (1 - fadeValue))
		local light = orb:FindFirstChild("PointLight")
		if light then
			light.Enabled = fadeValue > 0.3
			light.Brightness = fadeValue
			light.Range = 6 * fadeValue
		end
	end
end

-- Get all viewing positions
local function getAllViewingPositions()
	local positions = {}

	for _, player in pairs(Players:GetPlayers()) do
		local char = player.Character
		if char then
			local root = char:FindFirstChild("HumanoidRootPart")
			if root then
				table.insert(positions, root.Position)
			end
		end
	end

	-- AI snakes
	local aiModule = _G.AISnakeModule
	if aiModule and aiModule._activeSnakes then
		for _, snake in pairs(aiModule._activeSnakes) do
			if snake.HeadParts and snake.HeadParts.head then
				table.insert(positions, snake.HeadParts.head.Position)
			end
		end
	end

	return positions
end

-- Touch handler
function attachOrbTouched(orb)
	if not orb then return end

	orb.Touched:Connect(function(hit)
		if not orb or not orb.Parent or orbDebounce[orb] then return end

		-- Check for player
		local humanoid = hit.Parent:FindFirstChildOfClass("Humanoid")
		if humanoid then
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player then
				orbDebounce[orb] = true

				-- Get orb value
				local valObj = orb:FindFirstChild("Value")
				local value = (valObj and valObj.Value) or 5

				-- Handle collection
				if orb.Name == "UpgradeOrb" then
					-- Give upgrade
					local snakeInst = _G.PlayerSnakes and _G.PlayerSnakes[player]
					if snakeInst then
						SnakeUpgrades.GiveUpgrade(snakeInst)
					end
				else
					-- Give growth
					local snakeInst = _G.PlayerSnakes and _G.PlayerSnakes[player]
					if snakeInst and snakeInst.grow then
						snakeInst:grow(value)
					end
				end

				-- Fire client event
				if OrbCollectedEvent then
					pcall(function()
						OrbCollectedEvent:FireClient(player, orb.Position, orb.Name)
					end)
				end

				-- Remove orb
				removeOrb(orb)
				return
			end
		end

		-- Check for AI snake
		if hit.Name == "AISnakeHead" then
			orbDebounce[orb] = true

			local aiModule = _G.AISnakeModule
			if aiModule and aiModule._activeSnakes then
				for _, snake in pairs(aiModule._activeSnakes) do
					if snake.HeadParts and snake.HeadParts.head == hit then
						if orb.Name == "UpgradeOrb" then
							SnakeUpgrades.GiveUpgrade(snake)
						else
							local valObj = orb:FindFirstChild("Value")
							local value = (valObj and valObj.Value) or 5
							if snake.grow then
								snake:grow(value)
							end
						end
						break
					end
				end
			end

			removeOrb(orb)
		end
	end)
end

-- Proximity collection system
task.spawn(function()
	while true do
		task.wait(0.2)

		-- Get all player positions
		for _, player in pairs(Players:GetPlayers()) do
			local char = player.Character
			if char then
				local root = char:FindFirstChild("HumanoidRootPart")
				if root then
					-- Get magnet range
					local magnetRange = player:GetAttribute("MagnetRange") or 1
					local tempMagnetRange = player:GetAttribute("TempMagnetRange") or 1
					local totalMagnet = magnetRange * tempMagnetRange

					-- Check nearby orbs
					local searchRange = 15 * totalMagnet
					local nearbyOrbs = getOrbsNearPosition(root.Position, searchRange)

					for _, orb in ipairs(nearbyOrbs) do
						if orb and orb.Parent and not orbDebounce[orb] then
							local dist = (orb.Position - root.Position).Magnitude
							local collectRange = (orb.Size.X / 2) + 3 * totalMagnet

							if dist <= collectRange then
								-- Trigger collection
								local valObj = orb:FindFirstChild("Value")
								local value = (valObj and valObj.Value) or 5

								orbDebounce[orb] = true

								if orb.Name == "UpgradeOrb" then
									local snakeInst = _G.PlayerSnakes and _G.PlayerSnakes[player]
									if snakeInst then
										SnakeUpgrades.GiveUpgrade(snakeInst)
									end
								else
									local snakeInst = _G.PlayerSnakes and _G.PlayerSnakes[player]
									if snakeInst and snakeInst.grow then
										snakeInst:grow(value)
									end
								end

								if OrbCollectedEvent then
									pcall(function()
										OrbCollectedEvent:FireClient(player, orb.Position, orb.Name)
									end)
								end

								removeOrb(orb)
							elseif totalMagnet > 1 and dist < searchRange then
								-- Magnetic attraction
								local attraction = (totalMagnet - 1) * 0.2
								local direction = (root.Position - orb.Position).Unit
								orb.Position = orb.Position + direction * attraction
							end
						end
					end
				end
			end
		end
	end
end)

-- LOD update loop
local lastLODUpdate = 0
RunService.Heartbeat:Connect(function()
	local now = tick()
	if now - lastLODUpdate < LOD_UPDATE_RATE then return end
	lastLODUpdate = now

	local viewPositions = getAllViewingPositions()
	if #viewPositions == 0 then return end

	-- Process orbs in batches
	local processed = 0
	for i = 1, #orbs do
		local orb = orbs[i]
		if orb and orb.Parent then
			local state, fade = calculateOrbLOD(orb, viewPositions)
			applyOrbLOD(orb, state, fade)

			processed = processed + 1
			if processed >= BATCH_SIZE then
				break
			end
		end
	end
end)

-- Initialize and spawn orbs
initializeSpawnGrid()

-- Initial spawn
task.spawn(function()
	-- Spawn initial orbs gradually
	local initialTarget = math.floor(ORB_COUNT * 0.8) -- Start with 80% of target
	local batchSize = 20

	while #orbs < initialTarget do
		for i = 1, batchSize do
			if #orbs < initialTarget then
				spawnRegularOrb()
			end
		end
		task.wait(0.1)
	end

	print("Initial orb spawn complete:", #orbs, "orbs")
end)

-- Continuous spawning
task.spawn(function()
	while true do
		task.wait(RESPAWN_DELAY)

		-- Maintain orb count
		if #orbs < ORB_COUNT then
			local toSpawn = math.min(5, ORB_COUNT - #orbs)
			for i = 1, toSpawn do
				spawnRegularOrb()
			end
		end
	end
end)

-- Module exports
