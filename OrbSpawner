	spawnDeathOrbsForSnake = function(pos, segCount)
		return spawnDeathOrbs(pos, math.min(segCount, 30))
	end,
	registerExternalOrb = function(orb)
		if orb and orb.Parent then
			table.insert(orbs, orb)
			addOrbToSpatialGrid(orb)
			attachOrbTouched(orb)
		end
	end
}

-- Helper to get AI module (lazy loading to avoid circular requires)
local function getAISnakeModule()
	if _G.AISnakeModule then return _G.AISnakeModule end
	local ok, mod = pcall(function()
		return require(ReplicatedStorage:WaitForChild("AISnake", 5))
	end)
	if ok then 
		_G.AISnakeModule = mod
		return mod
	end
	return nil
end

