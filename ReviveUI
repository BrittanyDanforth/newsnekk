-- Initialize UI
local reviveUI, yesButton, noButton, timerBar, buyButton, lengthInfo, reviveInfo, reviveCount, processingText, overlay, container = createReviveUI()

-- State variables
local isPurchasing = false
local hasResponded = false
local timerConnection = nil
local startTime = 0
local savedButtonConnections = {}

-- Function to cleanup button connections
local function cleanupConnections()
	for _, connection in pairs(savedButtonConnections) do
		if connection then
			connection:Disconnect()
		end
	end
	savedButtonConnections = {}
end

-- Update timer function
local function updateTimer()
	local elapsed = tick() - startTime
	local remaining = math.max(0, UI_CONFIG.TIMER_DURATION - elapsed)
	local progress = remaining / UI_CONFIG.TIMER_DURATION
	local secondsLeft = math.ceil(remaining)
	
	-- Update timer bar
	timerBar.Size = UDim2.new(progress, 0, 0.02, 0)
	
	-- Update text based on state
	if isPurchasing then
		reviveInfo.Text = "Waiting for purchase... (" .. secondsLeft .. "s remaining)"
		processingText.Text = "Complete purchase within " .. secondsLeft .. " seconds"
		processingText.Visible = true
		-- Make UI slightly transparent
		overlay.BackgroundTransparency = 0.6
		container.BackgroundTransparency = 0.2
	else
		-- Show normal timer in revive info
		local revivesAvailable = player:GetAttribute("RevivesAvailable") or 0
		if revivesAvailable > 0 then
			reviveInfo.Text = "Use a revive? (" .. secondsLeft .. "s)"
		else
			reviveInfo.Text = "Purchase a revive? (" .. secondsLeft .. "s)"
		end
		-- Restore opacity
		overlay.BackgroundTransparency = 0.3
		container.BackgroundTransparency = 0
	end
	
	-- Change timer bar color as time runs out
	if secondsLeft <= 10 then
		timerBar.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
	elseif secondsLeft <= 20 then
		timerBar.BackgroundColor3 = Color3.fromRGB(255, 200, 100)
	else
		timerBar.BackgroundColor3 = UI_CONFIG.ACCENT_COLOR
	end
	
	-- Time's up
	if remaining <= 0 and not hasResponded then
		hasResponded = true
		if timerConnection then
			timerConnection:Disconnect()
			timerConnection = nil
		end
		promptReviveRemote:FireServer("decline")
		reviveUI.Enabled = false
		cleanupConnections()
	end
end

-- Handle response function
local function handleResponse(response)
	if hasResponded then return end
	hasResponded = true
	
	if timerConnection then
		timerConnection:Disconnect()
		timerConnection = nil
	end

	-- Send response to server
	promptReviveRemote:FireServer(response)

	-- Animate exit
	TweenService:Create(container, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
		Size = UDim2.new(0, 0, 0, 0)
	}):Play()

	task.wait(0.2)
	reviveUI.Enabled = false
	cleanupConnections()
end

-- Handle revive prompt
promptReviveRemote.OnClientEvent:Connect(function(deathLength)
	print("REVIVE PROMPT RECEIVED! Death length:", deathLength or 0)

	-- Reset state
	hasResponded = false
	isPurchasing = false
	startTime = tick()
	cleanupConnections()

	-- Calculate revive length
	local actualDeathLength = deathLength or 0

	if actualDeathLength == 0 then
		actualDeathLength = player:GetAttribute("LastLength") or 
			player:GetAttribute("DeathLength") or 
			player:GetAttribute("Length") or 0

		if actualDeathLength == 0 then
			local leaderstats = player:FindFirstChild("leaderstats")
			if leaderstats then
				local lengthValue = leaderstats:FindFirstChild("Length")
				if lengthValue then
					actualDeathLength = lengthValue.Value or 0
				end
			end
		end
	end

	local reviveLength = math.floor(actualDeathLength * UI_CONFIG.REVIVE_PERCENTAGE)

	-- Update displays
	lengthInfo.Text = "Your length: " .. tostring(actualDeathLength)
	reviveCount.Text = "Revives remaining: 0" -- Will be updated below

	-- Check revives available
	local revivesAvailable = player:GetAttribute("RevivesAvailable") or 0
	reviveCount.Text = "Revives remaining: " .. tostring(revivesAvailable)

	-- Always show REVIVE button
	yesButton.Visible = true
	buyButton.Visible = false

	-- Enable UI
	reviveUI.Enabled = true
	processingText.Visible = false
	isPurchasing = false

	-- Reset and animate in
	container.Size = UDim2.new(0, 0, 0, 0)
	TweenService:Create(container, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
		Size = UDim2.new(0.4, 0, 0.35, 0)
	}):Play()

	-- Start timer
	if timerConnection then
		timerConnection:Disconnect()
	end
	timerConnection = RunService.Heartbeat:Connect(updateTimer)

	-- Yes button handler
	savedButtonConnections.yesButton = yesButton.MouseButton1Click:Connect(function()
		if hasResponded or isPurchasing then return end
		
		local currentRevives = player:GetAttribute("RevivesAvailable") or 0

		if currentRevives > 0 then
			-- Has revives, use one
			handleResponse("revive")
		else
			-- No revives - trigger purchase
			print("No revives available - triggering purchase...")
			isPurchasing = true
			processingText.Visible = true
			processingText.Text = "Opening store..."
			yesButton.Text = "PURCHASING..."
			yesButton.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
			
			-- Tell server we're purchasing
			promptReviveRemote:FireServer("purchasing")

			-- Prompt purchase
			local success, result = pcall(function()
				return MarketplaceService:PromptProductPurchase(player, UI_CONFIG.REVIVE_PRODUCT_ID)
			end)

			if not success then
				print("Failed to prompt purchase:", result)
				isPurchasing = false
				processingText.Text = "Purchase failed! Try again or respawn."
				yesButton.Text = "TRY AGAIN"
				yesButton.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
			end
		end
	end)

	-- No button handler
	savedButtonConnections.noButton = noButton.MouseButton1Click:Connect(function()
		if hasResponded then return end
		player:SetAttribute("ReviveDeclined", true)
		handleResponse("decline")
	end)
end)

-- Listen for successful purchase
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
	if userId == player.UserId and productId == UI_CONFIG.REVIVE_PRODUCT_ID then
		if wasPurchased then
			print("Revive purchased successfully!")
			
			-- Update UI
			processingText.Text = "Purchase complete! Reviving..."
			yesButton.Text = "REVIVING..."
			yesButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
			
			-- Give server time to process
			task.wait(1)
			
			-- Send revive signal
			if not hasResponded and reviveUI.Enabled then
				handleResponse("revive")
			end
		else
			print("Purchase cancelled")
			isPurchasing = false
			processingText.Text = "Purchase cancelled"
			yesButton.Text = "REVIVE"
			yesButton.BackgroundColor3 = UI_CONFIG.SUCCESS_COLOR
			
			-- Hide processing text after a moment
			task.wait(1)
			if reviveUI.Enabled then
				processingText.Visible = false
			end
		end
	end
end)

-- Clean up on character spawn
player.CharacterAdded:Connect(function()
	if timerConnection then
		timerConnection:Disconnect()
		timerConnection = nil
	end
	reviveUI.Enabled = false
	hasResponded = false
	isPurchasing = false
	cleanupConnections()
end)

print("ReviveUI with Robux purchase loaded!")