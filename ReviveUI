-- ReviveUI - Simplified and robust revive system
-- Goes in StarterPlayerScripts

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Wait for remotes
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local promptReviveRemote = remotes:WaitForChild("PromptRevive")

-- Configuration
local REVIVE_PRODUCT_ID = 3356734577
local TIMER_DURATION = 30
local REVIVE_PERCENTAGE = 0.8

-- State
local reviveUI = nil
local startTime = 0
local isPurchasing = false
local hasResponded = false

-- Create simple UI
local function createReviveUI()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "RevivePrompt"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 10000
	screenGui.Enabled = false
	
	-- Dark background
	local bg = Instance.new("Frame")
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.new(0, 0, 0)
	bg.BackgroundTransparency = 0.5
	bg.Parent = screenGui
	
	-- Main frame
	local frame = Instance.new("Frame")
	frame.Name = "MainFrame"
	frame.Size = UDim2.new(0.4, 0, 0.3, 0)
	frame.Position = UDim2.new(0.3, 0, 0.35, 0)
	frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	frame.BorderSizePixel = 0
	frame.Parent = screenGui
	
	-- Add corner rounding
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = frame
	
	-- Title
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0.25, 0)
	title.Position = UDim2.new(0, 0, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = "YOU DIED!"
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 100, 100)
	title.Font = Enum.Font.SourceSansBold
	title.Parent = frame
	
	-- Info text
	local info = Instance.new("TextLabel")
	info.Name = "Info"
	info.Size = UDim2.new(1, -20, 0.3, 0)
	info.Position = UDim2.new(0, 10, 0.25, 0)
	info.BackgroundTransparency = 1
	info.Text = "Loading..."
	info.TextScaled = true
	info.TextColor3 = Color3.fromRGB(255, 255, 255)
	info.Font = Enum.Font.SourceSans
	info.Parent = frame
	
	-- Timer text
	local timerText = Instance.new("TextLabel")
	timerText.Name = "Timer"
	timerText.Size = UDim2.new(1, 0, 0.15, 0)
	timerText.Position = UDim2.new(0, 0, 0.55, 0)
	timerText.BackgroundTransparency = 1
	timerText.Text = "30 seconds"
	timerText.TextScaled = true
	timerText.TextColor3 = Color3.fromRGB(255, 215, 0)
	timerText.Font = Enum.Font.SourceSans
	timerText.Parent = frame
	
	-- Button container
	local buttonContainer = Instance.new("Frame")
	buttonContainer.Size = UDim2.new(1, -20, 0.2, 0)
	buttonContainer.Position = UDim2.new(0, 10, 0.75, 0)
	buttonContainer.BackgroundTransparency = 1
	buttonContainer.Parent = frame
	
	-- Revive button
	local reviveBtn = Instance.new("TextButton")
	reviveBtn.Name = "ReviveButton"
	reviveBtn.Size = UDim2.new(0.45, 0, 1, 0)
	reviveBtn.Position = UDim2.new(0, 0, 0, 0)
	reviveBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
	reviveBtn.Text = "REVIVE"
	reviveBtn.TextScaled = true
	reviveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	reviveBtn.Font = Enum.Font.SourceSansBold
	reviveBtn.Parent = buttonContainer
	
	local reviveBtnCorner = Instance.new("UICorner")
	reviveBtnCorner.CornerRadius = UDim.new(0, 8)
	reviveBtnCorner.Parent = reviveBtn
	
	-- Decline button
	local declineBtn = Instance.new("TextButton")
	declineBtn.Name = "DeclineButton"
	declineBtn.Size = UDim2.new(0.45, 0, 1, 0)
	declineBtn.Position = UDim2.new(0.55, 0, 0, 0)
	declineBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
	declineBtn.Text = "RESPAWN"
	declineBtn.TextScaled = true
	declineBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	declineBtn.Font = Enum.Font.SourceSansBold
	declineBtn.Parent = buttonContainer
	
	local declineBtnCorner = Instance.new("UICorner")
	declineBtnCorner.CornerRadius = UDim.new(0, 8)
	declineBtnCorner.Parent = declineBtn
	
	screenGui.Parent = playerGui
	return screenGui, frame, info, timerText, reviveBtn, declineBtn
end

-- Initialize UI
reviveUI = createReviveUI()
local frame = reviveUI:WaitForChild("MainFrame")
local infoText = frame:WaitForChild("Info")
local timerText = frame:WaitForChild("Timer")
local reviveButton = frame:FindFirstChild("ReviveButton", true)
local declineButton = frame:FindFirstChild("DeclineButton", true)

-- Wait for UI elements to load
if not reviveButton or not declineButton then
	warn("Waiting for UI elements to load...")
	warn("Frame children:", frame:GetChildren())
	task.wait(0.1)
	reviveButton = frame:FindFirstChild("ReviveButton", true)
	declineButton = frame:FindFirstChild("DeclineButton", true)
end

-- Debug logging
print("ReviveUI elements loaded:")
print("- Frame:", frame)
print("- InfoText:", infoText)
print("- TimerText:", timerText)
print("- ReviveButton:", reviveButton)
print("- DeclineButton:", declineButton)

-- Update timer display
local function updateTimer()
	local elapsed = tick() - startTime
	local remaining = math.max(0, TIMER_DURATION - elapsed)
	local seconds = math.ceil(remaining)
	
	timerText.Text = seconds .. " seconds"
	
	-- Change color as time runs out
	if seconds <= 10 then
		timerText.TextColor3 = Color3.fromRGB(255, 100, 100)
	elseif seconds <= 20 then
		timerText.TextColor3 = Color3.fromRGB(255, 200, 100)
	else
		timerText.TextColor3 = Color3.fromRGB(255, 215, 0)
	end
	
	-- Time's up
	if remaining <= 0 and not hasResponded then
		hasResponded = true
		promptReviveRemote:FireServer("decline")
		reviveUI.Enabled = false
	end
end

-- Handle revive button click
reviveButton.MouseButton1Click:Connect(function()
	if hasResponded then return end
	
	local revivesAvailable = player:GetAttribute("RevivesAvailable") or 0
	
	if revivesAvailable > 0 then
		-- Has revives, use one
		hasResponded = true
		promptReviveRemote:FireServer("revive")
		reviveUI.Enabled = false
	else
		-- No revives, need to purchase
		if not isPurchasing then
			isPurchasing = true
			infoText.Text = "Opening Robux store..."
			reviveButton.Text = "PURCHASING..."
			reviveButton.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
			
			-- Tell server we're purchasing
			promptReviveRemote:FireServer("purchasing")
			
			-- Open purchase prompt
			local success = pcall(function()
				MarketplaceService:PromptProductPurchase(player, REVIVE_PRODUCT_ID)
			end)
			
			if not success then
				isPurchasing = false
				infoText.Text = "Purchase failed! Try again or respawn."
				reviveButton.Text = "TRY AGAIN"
				reviveButton.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
			end
		end
	end
end)

-- Handle decline button
declineButton.MouseButton1Click:Connect(function()
	if hasResponded then return end
	hasResponded = true
	promptReviveRemote:FireServer("decline")
	reviveUI.Enabled = false
end)

-- Handle purchase completion
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
	if userId == player.UserId and productId == REVIVE_PRODUCT_ID then
		if wasPurchased then
			-- Purchase successful, wait for server to process
			infoText.Text = "Purchase complete! Reviving..."
			reviveButton.Text = "REVIVING..."
			reviveButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
			
			-- Give server time to process the purchase
			task.wait(1)
			
			-- Now send revive signal
			if not hasResponded then
				hasResponded = true
				promptReviveRemote:FireServer("revive")
				reviveUI.Enabled = false
			end
		else
			-- Purchase cancelled or failed
			isPurchasing = false
			infoText.Text = "Purchase cancelled. Revive or respawn?"
			reviveButton.Text = "TRY AGAIN"
			reviveButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
		end
	end
end)

-- Timer update loop
local timerConnection = nil
local function startTimer()
	if timerConnection then
		timerConnection:Disconnect()
	end
	
	timerConnection = RunService.Heartbeat:Connect(updateTimer)
end

-- Handle revive prompt from server
promptReviveRemote.OnClientEvent:Connect(function()
	-- Reset state
	hasResponded = false
	isPurchasing = false
	startTime = tick()
	
	-- Get player stats
	local deathLength = 0
	local revivesAvailable = player:GetAttribute("RevivesAvailable") or 0
	
	if player.Character then
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			local lengthValue = leaderstats:FindFirstChild("Length")
			if lengthValue then
				deathLength = lengthValue.Value or 0
			end
		end
	end
	
	-- Update UI
	if revivesAvailable > 0 then
		infoText.Text = "You have " .. revivesAvailable .. " revives. Use one?"
		reviveButton.Text = "REVIVE (" .. revivesAvailable .. ")"
		reviveButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
	else
		infoText.Text = "No revives available. Purchase with Robux?"
		reviveButton.Text = "BUY REVIVE"
		reviveButton.BackgroundColor3 = Color3.fromRGB(110, 255, 110)
	end
	
	-- Show UI
	reviveUI.Enabled = true
	
	-- Start timer
	startTimer()
end)

-- Clean up on death/respawn
player.CharacterAdded:Connect(function()
	if timerConnection then
		timerConnection:Disconnect()
		timerConnection = nil
	end
	reviveUI.Enabled = false
end)

print("ReviveUI loaded - Simplified version with robust purchase handling")