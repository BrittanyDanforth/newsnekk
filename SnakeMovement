-- 🚀 CONTINUOUS BEAM SNAKE MOVEMENT - LIKE REAL SLITHER.IO V3.0
-- this goes INTO StarterPlayerScripts as Localscript
-- ✅ NO GAPS EVER - USES BEAM TECHNOLOGY
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- 🔧 CONFIG SYSTEM
local Config = {}
local success, externalConfig = pcall(function()
	return require(game.ReplicatedStorage:WaitForChild("SnakeConfig"))
end)

if success and externalConfig then
	Config = externalConfig
	print("✅ External config loaded successfully")
else
	print("⚠️ External config not found using defaults")
	Config = {
		BaseSpeed = 50,
		BoostSpeed = 100,
		TurnSpeed = 5.1,
		CrawlSpeed = 8,
		SlowSpeed = 18,
		SuperSpeed = 55,
		LudicrousSpeed = 90,
		HeadSize = Vector3.new(5, 5, 5),
		HeadColor = Color3.fromRGB(0, 255, 0),
		BodyColors = {Color3.fromRGB(0, 200, 0)},
		InitialLength = 10,
		UpdateRate = 60
	}
end

-- Player setup
local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- 📱 MOBILE SUPPORT
-- Mobile detection and controls are handled through MobileHUD script
-- Check _G.IsMobile flag and _G.PlayerSnakes for mobile input data

-- 🎯 CONTINUOUS BEAM SNAKE SYSTEM
local BeamSnakeSystem = nil
local currentSnake = nil
local connections = {}

-- Load the beam snake system
local function loadBeamSnakeSystem()
	local success, module = pcall(function()
		return require(game.ReplicatedStorage:WaitForChild("OptimizedSnakeSystemV8_ContinuousBeam", 5))
	end)
	
	if success and module then
		BeamSnakeSystem = module
		print("✅ Continuous Beam Snake System loaded!")
		return true
	else
		-- Fallback: Create inline if module not found
		warn("⚠️ Beam Snake module not found in ReplicatedStorage, using inline version")
		-- The actual beam system would be loaded from ReplicatedStorage
		-- For now we'll wait for it to be available
		return false
	end
end

-- Wait for character with proper checks
local function waitForCharacterProperly()
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid", 10)
	local rootPart = character:WaitForChild("HumanoidRootPart", 10)
	
	if not humanoid or not rootPart then
		warn("Failed to get humanoid or rootPart")
		return nil, nil, nil
	end
	
	-- Wait for character to be fully loaded
	if humanoid.Health <= 0 then
		humanoid.Died:Wait()
		return nil, nil, nil
	end
	
	return character, humanoid, rootPart
end

-- Initialize snake for a character
local function initializeSnake(character, humanoid, rootPart)
	print("🐍 Initializing Continuous Beam Snake...")
	
	-- Clean up any existing snake
	if currentSnake then
		currentSnake:destroy()
		currentSnake = nil
	end
	
	-- Clear connections
	for _, conn in ipairs(connections) do
		if conn then conn:Disconnect() end
	end
	connections = {}
	
	-- Load beam system if not loaded
	if not BeamSnakeSystem then
		if not loadBeamSnakeSystem() then
			-- Try loading every second until available
			local retryConnection
			retryConnection = RunService.Heartbeat:Connect(function()
				if loadBeamSnakeSystem() then
					retryConnection:Disconnect()
					initializeSnake(character, humanoid, rootPart)
				end
			end)
			table.insert(connections, retryConnection)
			return
		end
	end
	
	-- 🎮 MOVEMENT STATE
	local State = {
		currentSpeed = Config.BaseSpeed,
		targetSpeed = Config.BaseSpeed,
		speedMode = "normal",
		boosting = false,
		currentDirection = Vector3.new(0, 0, -1),
		targetDirection = Vector3.new(0, 0, -1),
		speedMultiplier = player:GetAttribute("SpeedMultiplier") or 1,
		tempSpeedMultiplier = 1,
		lastPosition = rootPart.Position
	}
	
	-- Create config for the beam snake
	local snakeConfig = {
		BaseSpeed = Config.BaseSpeed,
		TurnSpeed = Config.TurnSpeed,
		InitialLength = Config.InitialLength or 10,
		HeadSize = Config.HeadSize,
		HeadColor = Config.HeadColor,
		BodyColors = Config.BodyColors,
		SkinName = player:GetAttribute("EquippedSkin") or "Default"
	}
	
	-- Create the beam snake
	currentSnake = BeamSnakeSystem.new(character, snakeConfig)
	if not currentSnake then
		warn("Failed to create beam snake")
		return
	end
	
	-- 🌟 EXPORT FUNCTIONS FOR OTHER SYSTEMS
	_G.PlayerSnake = currentSnake
	_G.SnakeSpeed = State.currentSpeed
	_G.SnakeState = State
	_G.GetSnakeLength = function()
		return currentSnake and currentSnake.length or 0
	end
	
	-- 🎨 SETUP CHARACTER
	local function setupCharacter()
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
		humanoid.AutoRotate = false
		
		-- RootPart is our collision detector for orbs
		rootPart.Transparency = 1
		rootPart.CanCollide = false
		rootPart.CanTouch = true
		rootPart.Size = Config.HeadSize or Vector3.new(5, 5, 5)
		rootPart.Shape = Enum.PartType.Ball
	end
	setupCharacter()
	
	-- 🚀 SPEED MODES
	local speedModes = {
		crawl = Config.CrawlSpeed or 15,
		slow = Config.SlowSpeed or 30,
		normal = Config.BaseSpeed,
		super = Config.SuperSpeed or 75,
		ludicrous = Config.LudicrousSpeed or 120
	}
	
	local function setSpeedMode(mode)
		State.speedMode = mode
		State.targetSpeed = speedModes[mode] or Config.BaseSpeed
		print("🚀 Speed mode:", mode, "Speed:", State.targetSpeed)
	end
	
	-- 🎮 INPUT HANDLING
	local keysPressed = {}
	
	local function handleKeyPress(input)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			State.boosting = true
			State.tempSpeedMultiplier = 2
			if currentSnake then currentSnake.isBoosting = true end
		elseif input.KeyCode == Enum.KeyCode.One then
			setSpeedMode("crawl")
		elseif input.KeyCode == Enum.KeyCode.Two then
			setSpeedMode("slow")
		elseif input.KeyCode == Enum.KeyCode.Three then
			setSpeedMode("normal")
		elseif input.KeyCode == Enum.KeyCode.Four then
			setSpeedMode("super")
		elseif input.KeyCode == Enum.KeyCode.Five then
			setSpeedMode("ludicrous")
		end
		keysPressed[input.KeyCode] = true
	end
	
	local function handleKeyRelease(input)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			State.boosting = false
			State.tempSpeedMultiplier = 1
			if currentSnake then currentSnake.isBoosting = false end
		end
		keysPressed[input.KeyCode] = nil
	end
	
	-- Connect input
	table.insert(connections, UserInputService.InputBegan:Connect(handleKeyPress))
	table.insert(connections, UserInputService.InputEnded:Connect(handleKeyRelease))
	
	-- 🖱️ MOUSE DIRECTION
	local function updateDirection()
		local camera = workspace.CurrentCamera
		if not camera then return end
		
		local mouseRay = camera:ScreenPointToRay(mouse.X, mouse.Y)
		local raycast = workspace:Raycast(mouseRay.Origin, mouseRay.Direction * 1000)
		
		local targetPos
		if raycast then
			targetPos = raycast.Position
		else
			targetPos = mouseRay.Origin + mouseRay.Direction * 100
		end
		
		local headPos = rootPart.Position
		local dirToMouse = (targetPos - headPos)
		dirToMouse = Vector3.new(dirToMouse.X, 0, dirToMouse.Z).Unit
		
		if dirToMouse.Magnitude > 0 then
			State.targetDirection = dirToMouse
		end
	end
	
	-- 🔄 MAIN UPDATE LOOP
	local lastUpdate = tick()
	
	local updateLoop = RunService.Heartbeat:Connect(function(dt)
		if not rootPart.Parent or humanoid.Health <= 0 then return end
		
		-- Mobile controls
		if _G.IsMobile and _G.PlayerSnakes and _G.PlayerSnakes[player] then
			local mobileData = _G.PlayerSnakes[player]
			if mobileData.joystickActive and mobileData.direction then
				State.targetDirection = mobileData.direction
			end
			State.boosting = mobileData.boosting or false
			State.tempSpeedMultiplier = State.boosting and 2 or 1
		else
			-- Desktop controls
			updateDirection()
		end
		
		-- Smooth speed transitions
		local speedDiff = State.targetSpeed - State.currentSpeed
		State.currentSpeed = State.currentSpeed + speedDiff * dt * 5
		
		-- Apply all speed multipliers
		local finalSpeed = State.currentSpeed * State.speedMultiplier * State.tempSpeedMultiplier
		_G.SnakeSpeed = finalSpeed
		
		-- Smooth direction turning
		local turnSpeed = Config.TurnSpeed * dt
		State.currentDirection = State.currentDirection:Lerp(State.targetDirection, turnSpeed)
		State.currentDirection = State.currentDirection.Unit
		
		-- Move the character
		local newCFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + State.currentDirection)
		rootPart.CFrame = newCFrame
		rootPart.AssemblyLinearVelocity = State.currentDirection * finalSpeed
		
		-- Update beam snake speed
		if currentSnake then
			currentSnake.currentSpeed = finalSpeed
		end
		
		-- Handle stuck detection
		local distMoved = (rootPart.Position - State.lastPosition).Magnitude
		if distMoved < 0.1 and finalSpeed > 10 then
			-- Might be stuck, apply small random push
			local randomPush = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit * 5
			rootPart.Position = rootPart.Position + randomPush
		end
		State.lastPosition = rootPart.Position
		
		-- Network optimization
		local now = tick()
		if now - lastUpdate > 0.033 then -- 30 FPS for network
			lastUpdate = now
			-- Network updates would go here
		end
	end)
	
	table.insert(connections, updateLoop)
	
	-- 📏 LENGTH MANAGEMENT
	spawn(function()
		while rootPart.Parent and humanoid.Health > 0 do
			wait(0.1)
			
			-- Get current length from attributes or calculate
			local currentLength = player:GetAttribute("SnakeLength") or 10
			
			-- Update beam snake length
			if currentSnake and currentSnake.length ~= currentLength then
				currentSnake:setLength(currentLength)
			end
			
			-- Check for skin changes
			local equippedSkin = player:GetAttribute("EquippedSkin") or "Default"
			if currentSnake and currentSnake.skinName ~= equippedSkin then
				currentSnake:applySkin(equippedSkin)
			end
		end
	end)
	
	-- Death handler
	local deathConnection = humanoid.Died:Connect(function()
		print("💀 Snake died, cleaning up...")
		
		if currentSnake then
			currentSnake:destroy()
			currentSnake = nil
		end
		
		for _, conn in ipairs(connections) do
			if conn then conn:Disconnect() end
		end
		connections = {}
		
		_G.PlayerSnake = nil
		_G.SnakeSpeed = 0
		_G.SnakeState = nil
	end)
	
	table.insert(connections, deathConnection)
	
	print("✅ Continuous Beam Snake initialized successfully!")
end

-- 🔄 CHARACTER RESPAWN HANDLER
local function onCharacterAdded()
	-- Add delay to ensure character is fully loaded
	wait(0.5)
	
	local character, humanoid, rootPart = waitForCharacterProperly()
	if character and humanoid and rootPart then
		-- Additional delay to ensure all character components are ready
		wait(0.5)
		initializeSnake(character, humanoid, rootPart)
	end
end

-- Initial setup
if player.Character then
	onCharacterAdded()
end

-- Connect respawn handler
player.CharacterAdded:Connect(onCharacterAdded)

-- Cleanup on player leaving
Players.PlayerRemoving:Connect(function(leavingPlayer)
	if leavingPlayer == player then
		if currentSnake then
			currentSnake:destroy()
		end
		for _, conn in ipairs(connections) do
			if conn then conn:Disconnect() end
		end
	end
end)

print("✅ Continuous Beam Snake Movement System Loaded!")
