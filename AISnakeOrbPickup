-- This module augments the existing AISnake logic to allow AI snakes to pick up orbs.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local OrbUtils = require(ReplicatedStorage:WaitForChild("OrbUtils"))

local ORB_PICKUP_RADIUS = 6  -- Adjust as needed for pickup range

local AISnakeOrbPickup = {}

-- Active AI snake tracking
local trackedSnakes = {}

-- Track an AI snake for orb collection
function AISnakeOrbPickup.TrackSnake(aiSnake)
	if not aiSnake or not aiSnake.HeadParts or not aiSnake.HeadParts.head then return end
	trackedSnakes[aiSnake] = true
	print("🎯 AISnakeOrbPickup: Now tracking AI snake")
end

-- Stop tracking an AI snake
function AISnakeOrbPickup.UntrackSnake(aiSnake)
	trackedSnakes[aiSnake] = nil
end

-- Main pickup function that runs for each AI snake
function AISnakeOrbPickup.PickupNearbyOrbs(orbFolder, snakeHead, aiSnakeId)
	if not orbFolder or not snakeHead then return end

	for _, orb in pairs(orbFolder:GetChildren()) do
		if orb:IsA("BasePart") and orb.Parent then
			local dist = (orb.Position - snakeHead.Position).Magnitude
			if dist <= ORB_PICKUP_RADIUS then
				-- Get orb value before collection
				local valueObj = orb:FindFirstChild("Value")
				local orbValue = valueObj and valueObj.Value or 1

				-- Collect orb using OrbUtils (assuming it has a CollectOrb function)
				if OrbUtils.CollectOrb then
					OrbUtils.CollectOrb(orb, "AI", aiSnakeId)
				else
					-- Fallback: just destroy the orb
					orb:Destroy()
				end

				return orbValue -- Return the value collected
			end
		end
	end

	return 0
end

-- Debug counter
local frameCount = 0
local updateInterval = 6 -- Update every 6 frames (10 times per second instead of 60)

-- Heartbeat loop to check all tracked AI snakes
RunService.Heartbeat:Connect(function()
	frameCount = frameCount + 1
	
	-- Only update every N frames for performance
	if frameCount % updateInterval ~= 0 then
		return
	end

	-- ALWAYS check workspace directly for ALL orbs (including death orbs)
	-- Death orbs spawn directly in workspace, not in containers!
	-- Create a virtual container with all orbs
	local allOrbs = {}
	
	-- Also check the Orbs folder if it exists
	local orbsFolder = workspace:FindFirstChild("Orbs")
	if orbsFolder then
		for _, obj in pairs(orbsFolder:GetChildren()) do
			if obj:IsA("BasePart") then
				table.insert(allOrbs, obj)
			end
		end
	end
	
	-- Check workspace root for loose orbs
	for _, obj in pairs(workspace:GetChildren()) do
		if obj:IsA("BasePart") and (obj.Name == "Orb" or obj.Name == "DeathOrb" or obj.Name == "UpgradeOrb") then
			table.insert(allOrbs, obj)
		end
	end

	-- Debug print disabled for performance
	--[[
	if frameCount % 60 == 0 then
		local snakeCount = 0
		for _ in pairs(trackedSnakes) do snakeCount = snakeCount + 1 end
		print("🔍 AI Orb Pickup: Found", #allOrbs, "orbs in workspace, tracking", snakeCount, "AI snakes")
	end
	--]]

	-- Process each tracked snake
	for snake, _ in pairs(trackedSnakes) do
		if snake and snake.HeadParts and snake.HeadParts.head and snake.HeadParts.head.Parent then
			local head = snake.HeadParts.head
			local headPos = head.Position
			
			-- Early exit if snake is too far from any players (performance optimization)
			local nearPlayer = false
			for _, player in pairs(game.Players:GetPlayers()) do
				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					if (player.Character.HumanoidRootPart.Position - headPos).Magnitude < 300 then
						nearPlayer = true
						break
					end
				end
			end
			
			-- Skip orb checking if snake is too far from players
			if not nearPlayer then
				continue
			end

			-- Check each orb (with early distance culling)
			local orbsChecked = 0
			for _, orb in pairs(allOrbs) do
				if orb and orb.Parent then
					-- Quick distance check first
					local quickDist = math.abs(orb.Position.X - headPos.X) + math.abs(orb.Position.Z - headPos.Z)
					if quickDist > ORB_PICKUP_RADIUS * 2 then
						continue -- Skip this orb, too far
					end
					
					local dist = (orb.Position - head.Position).Magnitude
					local horizontalDist = ((orb.Position - head.Position) * Vector3.new(1, 0, 1)).Magnitude
					local heightDiff = math.abs(orb.Position.Y - head.Position.Y)
					
					orbsChecked = orbsChecked + 1
					if orbsChecked > 20 then -- Limit orbs checked per snake
						break
					end

					-- No debug prints for performance

					if dist <= ORB_PICKUP_RADIUS then
						-- Get orb value
						local valueObj = orb:FindFirstChild("Value")
						local orbValue = valueObj and valueObj.Value or 1

						-- Grow the snake
						if snake.grow then
							snake:grow(orbValue)
						end

						-- Destroy the orb
						orb:Destroy()
						break -- Only eat one orb per frame
					end
				end
			end
		else
			-- Remove invalid snake
			trackedSnakes[snake] = nil
		end
	end
end)

return AISnakeOrbPickup
