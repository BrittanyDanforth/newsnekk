-- This module is deprecated - AI snakes now handle orb pickup directly in their movement update.
-- The duplicate orb pickup logic here was causing conflicts.
-- Keeping only for logging/debugging purposes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local OrbUtils = require(ReplicatedStorage:WaitForChild("OrbUtils"))

local ORB_PICKUP_RADIUS = 6  -- Adjust as needed for pickup range

local AISnakeOrbPickup = {}

-- Active AI snake tracking
local trackedSnakes = {}

-- Track an AI snake for orb collection
function AISnakeOrbPickup.TrackSnake(aiSnake)
	if not aiSnake or not aiSnake.HeadParts or not aiSnake.HeadParts.head then return end
	trackedSnakes[aiSnake] = true
	print("🎯 AISnakeOrbPickup: Now tracking AI snake")
end

-- Stop tracking an AI snake
function AISnakeOrbPickup.UntrackSnake(aiSnake)
	trackedSnakes[aiSnake] = nil
end

-- Main pickup function that runs for each AI snake
function AISnakeOrbPickup.PickupNearbyOrbs(orbFolder, snakeHead, aiSnakeId)
	if not orbFolder or not snakeHead then return end

	for _, orb in pairs(orbFolder:GetChildren()) do
		if orb:IsA("BasePart") and orb.Parent then
			local dist = (orb.Position - snakeHead.Position).Magnitude
			if dist <= ORB_PICKUP_RADIUS then
				-- Get orb value before collection
				local valueObj = orb:FindFirstChild("Value")
				local orbValue = valueObj and valueObj.Value or 1

				-- Collect orb using OrbUtils (assuming it has a CollectOrb function)
				if OrbUtils.CollectOrb then
					OrbUtils.CollectOrb(orb, "AI", aiSnakeId)
				else
					-- Fallback: just destroy the orb
					orb:Destroy()
				end

				return orbValue -- Return the value collected
			end
		end
	end

	return 0
end

-- Debug counter
local frameCount = 0

-- Heartbeat loop to check all tracked AI snakes
RunService.Heartbeat:Connect(function()
	frameCount = frameCount + 1

	-- Get orbs from OrbFolder
	local orbFolder = Workspace:FindFirstChild("OrbFolder")
	if not orbFolder then return end

	local allOrbs = {}
	for _, orb in pairs(orbFolder:GetChildren()) do
		if orb:IsA("BasePart") then
			table.insert(allOrbs, orb)
		end
	end

	-- Debug print every 60 frames (approximately once per second)
	if frameCount % 60 == 0 then
		local snakeCount = 0
		for _ in pairs(trackedSnakes) do
			snakeCount = snakeCount + 1
		end

		print("🔍 AI Orb Pickup: Found", #allOrbs, "orbs in OrbFolder, tracking", snakeCount, "AI snakes")

		-- Check if any orbs have Value child
		local orbsWithValue = 0
		local upgradeOrbs = 0
		for _, orb in pairs(allOrbs) do
			if orb:FindFirstChild("Value") then
				orbsWithValue = orbsWithValue + 1
			end
			if orb.Name == "UpgradeOrb" then
				upgradeOrbs = upgradeOrbs + 1
			end
		end
		print("   Orbs with Value child:", orbsWithValue, "Upgrade orbs:", upgradeOrbs)
	end

	-- DISABLED: Orb collection is now handled directly in AISnake:updateMovement()
	-- This was causing duplicate orb pickups and conflicts

	-- Only clean up invalid tracked snakes
	for snake, _ in pairs(trackedSnakes) do
		if not (snake and snake.HeadParts and snake.HeadParts.head and snake.HeadParts.head.Parent) then
			-- Remove invalid snake
			trackedSnakes[snake] = nil
		end
	end
end)

return AISnakeOrbPickup
